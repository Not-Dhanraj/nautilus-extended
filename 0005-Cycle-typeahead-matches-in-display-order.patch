diff --git a/test/display/test-files-view.c b/test/display/test-files-view.c
index 93f9b9c50..a3f6413e3 100644
--- a/test/display/test-files-view.c
+++ b/test/display/test-files-view.c
@@ -1790,6 +1790,189 @@ test_name_grouping_folders (gconstpointer data)
     test_clear_tmp_dir ();
 }
 
+static void
+assert_selection_single_name (NautilusFilesView *view,
+                              const char        *expected_name)
+{
+    g_autolist (NautilusFile) selection = nautilus_files_view_get_selection (view);
+
+    g_assert_cmpuint (g_list_length (selection), ==, 1);
+    g_assert_cmpstr (nautilus_file_get_display_name (selection->data), ==, expected_name);
+}
+
+static void
+assert_selection_is_empty (NautilusFilesView *view)
+{
+    g_autolist (NautilusFile) selection = nautilus_files_view_get_selection (view);
+
+    g_assert_null (selection);
+}
+
+static void
+test_typeahead_cycling (gconstpointer data)
+{
+    guint view_id = GPOINTER_TO_UINT (data);
+    g_autoptr (NautilusWindowSlot) slot = NULL;
+    g_autoptr (NautilusFilesView) view = create_view_with_slot (NAUTILUS_MODE_BROWSE,
+                                                             view_id, &slot);
+    GActionGroup *actions = nautilus_files_view_get_private_action_group (view);
+    g_autoptr (GFile) dir = g_file_new_build_filename (test_get_tmp_dir (), "typeahead", NULL);
+    g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+    g_autoptr (GDateTime) yesterday = g_date_time_add_days (now, -1);
+    g_autoptr (GDateTime) old = g_date_time_add_days (now, -60);
+    g_autoptr (GError) error = NULL;
+    struct
+    {
+        const char *name;
+        GDateTime  *mtime;
+    } files[] = {
+        { "chrono-z-today.txt", now },
+        { "chrono-m-yesterday.txt", yesterday },
+        { "chrono-a-old.txt", old },
+        { "solo-unique.txt", now },
+        { "Éclair.txt", now },
+        { "école.txt", now },
+        { "épée.txt", now },
+    };
+
+    g_file_make_directory (dir, NULL, &error);
+    g_assert_no_error (error);
+
+    for (guint i = 0; i < G_N_ELEMENTS (files); i++)
+    {
+        g_autoptr (GFile) child = g_file_get_child (dir, files[i].name);
+
+        g_file_replace_contents (child, "content", 7, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+        g_file_set_attribute_uint64 (child, G_FILE_ATTRIBUTE_TIME_MODIFIED,
+                                     g_date_time_to_unix (files[i].mtime),
+                                     G_FILE_QUERY_INFO_NONE, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    nautilus_files_view_set_location (view, dir);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("time"));
+
+    /* Actual date-group display order vs alphabetical order, cycling and wrap.
+     * With time grouping, Today precedes Yesterday precedes Old, so the display
+     * order is chrono-z-today, chrono-m-yesterday, chrono-a-old. Alphabetically,
+     * chrono-a-old would precede chrono-z-today. */
+    assert_selection_is_empty (view);
+
+    /* No selection with cycle=TRUE starts at first match in display order */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-z-today.txt");
+
+    /* Subsequent cycles advance to next matches in display order */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-a-old.txt");
+
+    /* Wrap around to first match in display order */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-z-today.txt");
+
+
+    /* A mixed prefix returns the first matching item, rather than cycling. */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono-a", FALSE));
+    assert_selection_single_name (view, "chrono-a-old.txt");
+
+
+    /* Multiple selection cycles after the first selected model position. */
+    {
+        g_autoptr (NautilusFileList) multi_selection = NULL;
+        g_autoptr (GFile) file_z = g_file_get_child (dir, "chrono-z-today.txt");
+        g_autoptr (GFile) file_a = g_file_get_child (dir, "chrono-a-old.txt");
+        g_autoptr (NautilusFile) nfile_z = nautilus_file_get (file_z);
+        g_autoptr (NautilusFile) nfile_a = nautilus_file_get (file_a);
+
+        multi_selection = g_list_append (multi_selection, nautilus_file_ref (nfile_z));
+        multi_selection = g_list_append (multi_selection, nautilus_file_ref (nfile_a));
+        nautilus_files_view_set_selection (view, multi_selection, TRUE);
+
+        g_autolist (NautilusFile) current_sel = nautilus_files_view_get_selection (view);
+        g_assert_cmpuint (g_list_length (current_sel), ==, 2);
+
+        g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+        assert_selection_single_name (view, "chrono-m-yesterday.txt");
+    }
+
+    /* No-match, empty, and NULL queries preserve the existing selection. */
+    g_assert_false (nautilus_files_view_select_matching_name (view, "nonexistent", FALSE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_false (nautilus_files_view_select_matching_name (view, "nonexistent", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_false (nautilus_files_view_select_matching_name (view, "", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_false (nautilus_files_view_select_matching_name (view, NULL, FALSE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+
+    /* A sole match wraps to itself. */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "solo", TRUE));
+    assert_selection_single_name (view, "solo-unique.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "solo", TRUE));
+    assert_selection_single_name (view, "solo-unique.txt");
+
+
+    /* Unicode case-folded cycling and multi-character prefix matching. */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "Éclair", FALSE));
+    assert_selection_single_name (view, "Éclair.txt");
+
+    /* Cycle with lowercase 'é' */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "é", TRUE));
+    assert_selection_single_name (view, "école.txt");
+
+    /* Cycle with uppercase 'É' */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "É", TRUE));
+    assert_selection_single_name (view, "épée.txt");
+
+    /* Wrap around with lowercase 'é' */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "é", TRUE));
+    assert_selection_single_name (view, "Éclair.txt");
+
+    /* Multi-character case-folded prefix selections */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "ÉPÉ", FALSE));
+    assert_selection_single_name (view, "épée.txt");
+
+
+    /* Unaccented query does not match accented prefix; selection preserved */
+    g_assert_false (nautilus_files_view_select_matching_name (view, "eclair", FALSE));
+    assert_selection_single_name (view, "épée.txt");
+
+    /* Without grouping, cycling follows the ordinary alphabetical order. */
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("none"));
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+
+    nautilus_files_view_set_selection (view, NULL, TRUE);
+    assert_selection_is_empty (view);
+
+    /* In alphabetical order: chrono-a-old, chrono-m-yesterday, chrono-z-today */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-a-old.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-z-today.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-a-old.txt");
+
+    test_clear_tmp_dir ();
+}
+
 int
 main (int   argc,
       char *argv[])
@@ -1847,6 +2030,8 @@ main (int   argc,
