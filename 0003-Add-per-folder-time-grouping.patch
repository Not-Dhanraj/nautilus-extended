+gboolean
+nautilus_files_view_select_matching_name (NautilusFilesView *self,
+                                         const char        *text,
+                                         gboolean           cycle)
+{
+    g_autofree char *prefix = NULL;
+    guint n_items;
+    guint position = 0;
+
+    g_return_val_if_fail (NAUTILUS_IS_FILES_VIEW (self), FALSE);
+
+    if (text == NULL || *text == '\0')
+    {
+        return FALSE;
+    }
+
+    n_items = g_list_model_get_n_items (G_LIST_MODEL (self->model));
+    if (n_items == 0)
+    {
+        return FALSE;
+    }
+
+    if (cycle)
+    {
+        g_autoptr (GtkBitset) selection = gtk_selection_model_get_selection (GTK_SELECTION_MODEL (self->model));
+        guint selected = gtk_bitset_get_minimum (selection);
+
+        if (selected < n_items)
+        {
+            position = selected + 1;
+            if (position == n_items)
+            {
+                position = 0;
+            }
+        }
+    }
+
+    prefix = g_utf8_casefold (text, -1);
+    for (guint visited = 0; visited < n_items; visited++)
+    {
+        g_autoptr (GtkTreeListRow) row = g_list_model_get_item (G_LIST_MODEL (self->model), position);
+        g_autoptr (NautilusViewItem) item = gtk_tree_list_row_get_item (row);
+        NautilusFile *file = nautilus_view_item_get_file (item);
+        g_autofree char *name = g_utf8_casefold (nautilus_file_get_display_name (file), -1);
+
+        if (g_str_has_prefix (name, prefix))
+        {
+            GList selection = { .data = file };
+
+            /* Headings are not model items. Follow the current display order,
+             * including time sections, and reveal an off-screen match. */
+            nautilus_files_view_set_selection (self, &selection, TRUE);
+            return TRUE;
+        }
+
+        position++;
+        if (position == n_items)
+        {
+            position = 0;
+        }
+    }
+
+    return FALSE;
+}
