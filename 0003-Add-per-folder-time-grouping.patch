+const char *
+nautilus_list_base_get_group_title (NautilusListBase *self,
+                                    GtkTreeListRow   *row)
+{
+    NautilusListBasePrivate *priv;
+
+    g_return_val_if_fail (NAUTILUS_IS_LIST_BASE (self), NULL);
+
+    if (row == NULL)
+    {
+        return NULL;
+    }
+
+    priv = nautilus_list_base_get_instance_private (self);
+
+    if (priv->grouping_mode == NAUTILUS_GROUPING_TIME)
+    {
+        NautilusTimeGroup group = get_row_time_group (self, row);
+        return get_title_for_time_group (group);
+    }
+    else if (priv->grouping_mode == NAUTILUS_GROUPING_NAME)
+    {
+        guint32 key = get_row_name_group_key (row);
+        return get_title_for_name_group (self, key);
+    }
+
+    return NULL;
+}
