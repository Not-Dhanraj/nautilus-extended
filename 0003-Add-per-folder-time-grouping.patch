+static void
+update_time_sort_state (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    g_autoptr (GVariant) state = nautilus_list_base_get_sort_state (self);
+    const char *attribute;
+    gboolean reversed;
+
+    /* Column setup temporarily has no primary sorter. Keep the last valid
+     * grouping order until the configured sort column has been installed. */
+    if (state == NULL)
+    {
+        return;
+    }
+
+    g_variant_get (state, "(&sb)", &attribute, &reversed);
+    priv->group_time_sort = NAUTILUS_FILE_SORT_BY_MTIME;
+    if (g_str_equal (attribute, "date_created") || g_str_equal (attribute, "date_created_full"))
+    {
+        priv->group_time_sort = NAUTILUS_FILE_SORT_BY_BTIME;
+    }
+    else if (g_str_equal (attribute, "date_accessed") || g_str_equal (attribute, "date_accessed_full"))
+    {
+        priv->group_time_sort = NAUTILUS_FILE_SORT_BY_ATIME;
+    }
+    priv->group_newest_first = !nautilus_file_is_date_sort_attribute_q (g_quark_from_string (attribute)) || reversed;
+}
+
+static void
+on_sort_state_changed (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+
+    if (priv->grouping_mode != NAUTILUS_GROUPING_TIME)
+    {
+        return;
+    }
+
+    update_time_sort_state (self);
+    if (priv->section_sorter != NULL)
+    {
+        gtk_sorter_changed (GTK_SORTER (priv->section_sorter), GTK_SORTER_CHANGE_DIFFERENT);
+    }
+    g_signal_emit (self, signals[GROUP_TITLES_CHANGED], 0);
+}
