+typedef struct
+{
+    GSignalGroup *file_updates;
+    GSignalGroup *view_updates;
+    GtkTreeListRow *row;
+} GroupHeaderBinding;
+
+static void
+group_header_binding_free (gpointer data)
+{
+    GroupHeaderBinding *binding = data;
+
+    g_clear_object (&binding->file_updates);
+    g_clear_object (&binding->view_updates);
+    g_clear_object (&binding->row);
+    g_free (binding);
+}
+
+static void
+refresh_group_header (GtkWidget *header)
+{
+    GroupHeaderBinding *binding = g_object_get_data (G_OBJECT (header), "group-binding");
+    g_autoptr (NautilusListBase) self = g_signal_group_dup_target (binding->view_updates);
+
+    if (self != NULL && binding->row != NULL)
+    {
+        if (gtk_tree_list_row_get_position (binding->row) == GTK_INVALID_LIST_POSITION)
+        {
+            nautilus_list_base_unbind_group_header_widget (header);
+            return;
+        }
+        const char *title = nautilus_list_base_get_group_title (self, binding->row);
+
+        gtk_label_set_text (GTK_LABEL (header), title != NULL ? title : "");
+    }
+}
+
+GtkWidget *
+nautilus_list_base_create_group_header_widget (void)
+{
+    GtkWidget *label = gtk_label_new (NULL);
+    GroupHeaderBinding *binding = g_new0 (GroupHeaderBinding, 1);
+
+    gtk_widget_add_css_class (label, "grouped-section-header");
+    gtk_widget_add_css_class (label, "heading");
+    gtk_widget_set_hexpand (label, TRUE);
+    gtk_widget_set_halign (label, GTK_ALIGN_FILL);
+    gtk_label_set_xalign (GTK_LABEL (label), 0.0);
+
+    /* Signal-group targets are weak: the heading must not keep its owning view
+     * alive, and pooled/unparented headings must still receive data updates. */
+    binding->file_updates = g_signal_group_new (NAUTILUS_TYPE_VIEW_ITEM);
+    binding->view_updates = g_signal_group_new (NAUTILUS_TYPE_LIST_BASE);
+    g_signal_group_connect_object (binding->file_updates, "file-changed",
+                                    G_CALLBACK (refresh_group_header), label, G_CONNECT_SWAPPED);
+    g_signal_group_connect_object (binding->view_updates, "group-titles-changed",
+                                    G_CALLBACK (refresh_group_header), label, G_CONNECT_SWAPPED);
+    g_object_set_data_full (G_OBJECT (label), "group-binding", binding, group_header_binding_free);
+
+    return label;
+}
