+NautilusGroupingMode
+nautilus_list_base_get_grouping_mode (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv;
+
+    g_return_val_if_fail (NAUTILUS_IS_LIST_BASE (self), NAUTILUS_GROUPING_NONE);
+
+    priv = nautilus_list_base_get_instance_private (self);
+    return priv->grouping_mode;
+}
+
+void
+nautilus_list_base_set_grouping_mode (NautilusListBase     *self,
+                                     NautilusGroupingMode  grouping_mode)
+{
+    NautilusListBasePrivate *priv;
+
+    g_return_if_fail (NAUTILUS_IS_LIST_BASE (self));
+
+    priv = nautilus_list_base_get_instance_private (self);
+
+    if (priv->grouping_mode == grouping_mode)
+    {
+        return;
+    }
+
+    priv->grouping_mode = grouping_mode;
+
+    if (priv->grouping_mode != NAUTILUS_GROUPING_NONE)
+    {
+
+        if (priv->grouping_mode == NAUTILUS_GROUPING_TIME)
+        {
+            update_time_sort_state (self);
+            update_time_boundaries (self);
+        }
+        else
+        {
+            g_clear_handle_id (&priv->midnight_timeout_id, g_source_remove);
+        }
+
+        if (priv->section_sorter == NULL)
+        {
+            priv->section_sorter = gtk_custom_sorter_new (compare_sections, self, NULL);
+        }
+        else
+        {
+            gtk_sorter_changed (GTK_SORTER (priv->section_sorter), GTK_SORTER_CHANGE_DIFFERENT);
+        }
+
+        if (priv->model != NULL)
+        {
+            nautilus_view_model_set_section_sorter (priv->model, GTK_SORTER (priv->section_sorter));
+        }
+        g_signal_emit (self, signals[GROUP_TITLES_CHANGED], 0);
+    }
+    else
+    {
+        g_clear_handle_id (&priv->midnight_timeout_id, g_source_remove);
+        if (priv->model != NULL)
+        {
+            nautilus_view_model_set_section_sorter (priv->model, NULL);
+        }
+        g_clear_object (&priv->section_sorter);
+    }
+
+    g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_GROUPING_MODE]);
