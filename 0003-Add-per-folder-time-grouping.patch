+static void
+test_name_grouping_folders (gconstpointer data)
+{
+    gboolean saved_directories_first = g_settings_get_boolean (gtk_filechooser_preferences,
+                                                              NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST);
+    guint view_id = GPOINTER_TO_UINT (data);
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusFilesView) view = nautilus_files_view_new (view_id, slot);
+    NautilusListBase *base = nautilus_files_view_get_private_list_base (view);
+    NautilusViewModel *model = nautilus_files_view_get_private_model (view);
+    GActionGroup *actions = nautilus_files_view_get_private_action_group (view);
+    g_autoptr (GFile) location = g_file_new_for_path (test_get_tmp_dir ());
+    g_autoptr (GError) error = NULL;
+    guint start, end;
+    const char *folders[] = {
+        "a-folder-1",
+        "a-folder-2",
+        "b-folder-1",
+        "b-folder-2"
+    };
+    const char *files[] = {
+        "a-file-1.txt",
+        "a-file-2.txt",
+        "b-file-1.txt",
+        "b-file-2.txt"
+    };
+
+    for (guint i = 0; i < G_N_ELEMENTS (folders); i++)
+    {
+        g_autoptr (GFile) child = g_file_get_child (location, folders[i]);
+
+        g_file_make_directory (child, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    for (guint i = 0; i < G_N_ELEMENTS (files); i++)
+    {
+        g_autoptr (GFile) child = g_file_get_child (location, files[i]);
+
+        g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    nautilus_files_view_set_location (view, location);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+
+    /* Modify preferences only after directory is loaded */
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, TRUE);
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("name"));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NAME);
+
+    /* Folders first within each name section */
+    const char *expected_dirs_first[] = {
+        "a-folder-1", "a-folder-2", "a-file-1.txt", "a-file-2.txt",
+        "b-folder-1", "b-folder-2", "b-file-1.txt", "b-file-2.txt"
+    };
+    assert_grouped_file_order (model, expected_dirs_first, G_N_ELEMENTS (expected_dirs_first));
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 4);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 4, &start, &end);
+    g_assert_cmpuint (start, ==, 4);
+    g_assert_cmpuint (end, ==, 8);
+
+    {
+        g_autoptr (GtkTreeListRow) row_a = g_list_model_get_item (G_LIST_MODEL (model), 0);
+        g_autoptr (GtkTreeListRow) row_b = g_list_model_get_item (G_LIST_MODEL (model), 4);
+        g_assert_cmpstr (nautilus_list_base_get_group_title (base, row_a), ==, "A");
+        g_assert_cmpstr (nautilus_list_base_get_group_title (base, row_b), ==, "B");
+    }
+
+    /* Reverse sort preserves section order (A before B), and preserves folders before files,
+     * but reverses items within each category */
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", TRUE));
+    const char *expected_dirs_first_reversed[] = {
+        "a-folder-2", "a-folder-1", "a-file-2.txt", "a-file-1.txt",
+        "b-folder-2", "b-folder-1", "b-file-2.txt", "b-file-1.txt"
+    };
+    assert_grouped_file_order (model, expected_dirs_first_reversed, G_N_ELEMENTS (expected_dirs_first_reversed));
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 4);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 4, &start, &end);
+    g_assert_cmpuint (start, ==, 4);
+    g_assert_cmpuint (end, ==, 8);
+
+    /* Disabling sort-directories-first mixes folders and files strictly by name */
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, FALSE);
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+    const char *expected_mixed[] = {
+        "a-file-1.txt", "a-file-2.txt", "a-folder-1", "a-folder-2",
+        "b-file-1.txt", "b-file-2.txt", "b-folder-1", "b-folder-2"
+    };
+    assert_grouped_file_order (model, expected_mixed, G_N_ELEMENTS (expected_mixed));
+
+    /* Restore settings while directory is still loaded */
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, saved_directories_first);
+    test_clear_tmp_dir ();
+}
