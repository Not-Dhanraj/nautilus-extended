+
+    g_signal_connect (factory, "setup", G_CALLBACK (on_group_header_setup), self);
+    g_signal_connect_object (factory, "bind", G_CALLBACK (on_group_header_bind), self, 0);
+    g_signal_connect (factory, "unbind", G_CALLBACK (on_group_header_unbind), NULL);
