+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+
+    if (self->connected_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (self->connected_model, self);
+        self->connected_model = NULL;
