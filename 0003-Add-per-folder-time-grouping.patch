+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("none"));
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+
+    nautilus_files_view_set_selection (view, NULL, TRUE);
+    assert_selection_is_empty (view);
