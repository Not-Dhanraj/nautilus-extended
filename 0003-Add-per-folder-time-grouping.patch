+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-a-old.txt");
+
+    /* Wrap around to first match in display order */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+    assert_selection_single_name (view, "chrono-z-today.txt");
