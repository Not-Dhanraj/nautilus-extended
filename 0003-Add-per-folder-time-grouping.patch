+    GtkWidget *scrolled_window = nautilus_list_base_get_scrolled_window (NAUTILUS_LIST_BASE (self));
+    NautilusViewModel *model = nautilus_list_base_get_model (NAUTILUS_LIST_BASE (self));
+
+    gtk_widget_set_focusable (GTK_WIDGET (self), grouped);
+
+    self->anchor_position = GTK_INVALID_LIST_POSITION;
+    self->cursor_position = GTK_INVALID_LIST_POSITION;
+    gtk_grid_view_set_model (self->view_ui, grouped ? NULL : GTK_SELECTION_MODEL (model));
