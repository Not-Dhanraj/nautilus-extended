+        g_autoptr (GFile) file_z = g_file_get_child (dir, "chrono-z-today.txt");
+        g_autoptr (GFile) file_a = g_file_get_child (dir, "chrono-a-old.txt");
+        g_autoptr (NautilusFile) nfile_z = nautilus_file_get (file_z);
+        g_autoptr (NautilusFile) nfile_a = nautilus_file_get (file_a);
+
+        multi_selection = g_list_append (multi_selection, nautilus_file_ref (nfile_z));
+        multi_selection = g_list_append (multi_selection, nautilus_file_ref (nfile_a));
+        nautilus_files_view_set_selection (view, multi_selection, TRUE);
+
+        g_autolist (NautilusFile) current_sel = nautilus_files_view_get_selection (view);
+        g_assert_cmpuint (g_list_length (current_sel), ==, 2);
+
+        g_assert_true (nautilus_files_view_select_matching_name (view, "chrono", TRUE));
+        assert_selection_single_name (view, "chrono-m-yesterday.txt");
+    }
+
+    /* No-match, empty, and NULL queries preserve the existing selection. */
+    g_assert_false (nautilus_files_view_select_matching_name (view, "nonexistent", FALSE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_false (nautilus_files_view_select_matching_name (view, "nonexistent", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_false (nautilus_files_view_select_matching_name (view, "", TRUE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+    g_assert_false (nautilus_files_view_select_matching_name (view, NULL, FALSE));
+    assert_selection_single_name (view, "chrono-m-yesterday.txt");
+
+
+    /* A sole match wraps to itself. */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "solo", TRUE));
+    assert_selection_single_name (view, "solo-unique.txt");
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "solo", TRUE));
+    assert_selection_single_name (view, "solo-unique.txt");
+
+
+    /* Unicode case-folded cycling and multi-character prefix matching. */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "Éclair", FALSE));
+    assert_selection_single_name (view, "Éclair.txt");
+
+    /* Cycle with lowercase 'é' */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "é", TRUE));
+    assert_selection_single_name (view, "école.txt");
+
+    /* Cycle with uppercase 'É' */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "É", TRUE));
+    assert_selection_single_name (view, "épée.txt");
+
+    /* Wrap around with lowercase 'é' */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "é", TRUE));
+    assert_selection_single_name (view, "Éclair.txt");
+
+    /* Multi-character case-folded prefix selections */
+    g_assert_true (nautilus_files_view_select_matching_name (view, "ÉPÉ", FALSE));
+    assert_selection_single_name (view, "épée.txt");
