+static void
+test_time_grouping (gconstpointer data)
+{
+    guint view_id = GPOINTER_TO_UINT (data);
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusFilesView) view = nautilus_files_view_new (view_id, slot);
+    NautilusListBase *base = nautilus_files_view_get_private_list_base (view);
+    NautilusViewModel *model = nautilus_files_view_get_private_model (view);
+    GActionGroup *actions = nautilus_files_view_get_private_action_group (view);
+    g_autoptr (GFile) grouped = g_file_new_build_filename (test_get_tmp_dir (), "grouped", NULL);
+    g_autoptr (GFile) other = g_file_new_build_filename (test_get_tmp_dir (), "other", NULL);
+    g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+    g_autoptr (GDateTime) old = g_date_time_add_days (now, -60);
+    g_autoptr (GDateTime) yesterday = g_date_time_add_days (now, -1);
+    g_autoptr (GError) error = NULL;
+    const char *names[] = { "match-a-old.txt", "match-z-new.txt", "middle-yesterday.txt" };
+
+    g_file_make_directory (grouped, NULL, &error);
+    g_assert_no_error (error);
+    g_file_make_directory (other, NULL, &error);
+    g_assert_no_error (error);
+
+    for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+        g_autoptr (GFile) child = g_file_get_child (grouped, names[i]);
+
+        g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+        g_file_set_attribute_uint64 (child, G_FILE_ATTRIBUTE_TIME_MODIFIED,
+                                     g_date_time_to_unix (i == 0 ? old : i == 1 ? now : yesterday),
+                                     G_FILE_QUERY_INFO_NONE, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    nautilus_files_view_set_location (view, grouped);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    /* Test-mode metadata lives on the cached file, rather than in GVfs. Keep
+     * it alive while navigating away so the read path can also be exercised. */
+    g_autoptr (NautilusFile) grouped_file = nautilus_file_get (grouped);
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("time"));
+
+    /* Time sections precede the selected within-section name ordering. */
+    guint start, end;
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 1);
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 1, &start, &end);
+    g_assert_cmpuint (start, ==, 1);
+    g_assert_cmpuint (end, ==, 2);
+
+    g_assert_true (nautilus_files_view_select_matching_name (view, "MATCH", FALSE));
+    g_autolist (NautilusFile) selection = nautilus_files_view_get_selection (view);
+    g_assert_cmpuint (g_list_length (selection), ==, 1);
+    g_assert_cmpstr (nautilus_file_get_display_name (selection->data), ==, names[1]);
+    g_clear_list (&selection, g_object_unref);
+
+    /* Date direction changes both section order and type-ahead's first match. */
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "date_modified", FALSE));
+    if (view_id == NAUTILUS_VIEW_GRID_ID)
+    {
+        /* The selected file moves from the beginning to the end after sorting.
+         * Arrow/preview navigation must start at that file's new position. */
+        nautilus_files_view_preview_selection_event (view, GTK_DIR_LEFT);
+        selection = nautilus_files_view_get_selection (view);
+        g_assert_cmpuint (g_list_length (selection), ==, 1);
+        g_assert_cmpstr (nautilus_file_get_display_name (selection->data), ==, names[2]);
+        g_clear_list (&selection, g_object_unref);
+    }
+    g_assert_true (nautilus_files_view_select_matching_name (view, "match", FALSE));
+    selection = nautilus_files_view_get_selection (view);
+    g_assert_cmpuint (g_list_length (selection), ==, 1);
+    g_assert_cmpstr (nautilus_file_get_display_name (selection->data), ==, names[0]);
+    g_clear_list (&selection, g_object_unref);
+
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("none"));
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+    g_assert_true (nautilus_files_view_select_matching_name (view, "match", FALSE));
+    selection = nautilus_files_view_get_selection (view);
+    g_assert_cmpuint (g_list_length (selection), ==, 1);
+    g_assert_cmpstr (nautilus_file_get_display_name (selection->data), ==, names[0]);
+    g_clear_list (&selection, g_object_unref);
+
+    /* Grouping must neither leak into another folder nor be lost on return. */
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("time"));
+    nautilus_files_view_set_location (view, other);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+    nautilus_files_view_set_location (view, grouped);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_TIME);
+
+    test_clear_tmp_dir ();
+}
