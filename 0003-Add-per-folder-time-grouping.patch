+    {
+        self->connected_model = model;
+        g_signal_connect_object (model, "selection-changed",
+                                 G_CALLBACK (on_model_selection_changed), self, 0);
+        g_signal_connect_object (model, "items-changed",
+                                 G_CALLBACK (on_model_items_changed), self, 0);
+
+        real_set_enable_rubberband (NAUTILUS_LIST_BASE (self),
+                                    !nautilus_view_model_get_single_selection (model));
+    }
+
+    gtk_grid_view_set_model (self->view_ui,
+                             (nautilus_list_base_get_grouping_mode (NAUTILUS_LIST_BASE (self)) != NAUTILUS_GROUPING_NONE)
