+static void
+nautilus_grid_row_model_rebuild (NautilusGridRowModel *self)
+{
+    guint old_n_rows = self->rows != NULL ? self->rows->len : 0;
+
+    if (self->rows == NULL)
+    {
+        self->rows = g_array_new (FALSE, FALSE, sizeof (GridRowEntry));
+        g_array_set_clear_func (self->rows, grid_row_entry_clear);
+    }
+    else
+    {
+        g_array_set_size (self->rows, 0);
+    }
+
+    if (self->base_model == NULL || self->n_columns == 0)
+    {
+        if (old_n_rows > 0)
+        {
+            g_list_model_items_changed (G_LIST_MODEL (self), 0, old_n_rows, 0);
+        }
+        return;
+    }
+
+    guint total_items = g_list_model_get_n_items (G_LIST_MODEL (self->base_model));
+    guint pos = 0;
+
+    while (pos < total_items)
+    {
+        guint sec_start = pos;
+        guint sec_end = total_items;
+
+        gtk_section_model_get_section (GTK_SECTION_MODEL (self->base_model), pos, &sec_start, &sec_end);
+        sec_end = MIN (sec_end, total_items);
+
+        if (sec_end <= pos || sec_start > pos)
+        {
+            sec_start = pos;
+            sec_end = total_items;
+        }
+
+        guint sec_n_items = sec_end - sec_start;
+        guint sec_n_rows = (sec_n_items + self->n_columns - 1) / self->n_columns;
+        guint current_row_start = self->rows->len;
+        guint current_row_end = current_row_start + sec_n_rows;
+
+        for (guint r = 0; r < sec_n_rows; r++)
+        {
+            GridRowEntry entry = { 0 };
+            entry.start_index = sec_start + r * self->n_columns;
+            entry.n_items = MIN (self->n_columns, sec_end - entry.start_index);
+            entry.section_start_row = current_row_start;
+            entry.section_end_row = current_row_end;
+            g_array_append_val (self->rows, entry);
+        }
+
+        pos = sec_end;
+    }
+
+    guint new_n_rows = self->rows->len;
+    g_list_model_items_changed (G_LIST_MODEL (self), 0, old_n_rows, new_n_rows);
+    if (new_n_rows > 0)
+    {
+        gtk_section_model_sections_changed (GTK_SECTION_MODEL (self), 0, new_n_rows);
+    }
