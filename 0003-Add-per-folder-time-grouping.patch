+        }
+        else
+        {
+            self->anchor_position = pos;
+        }
+
+        real_scroll_to (NAUTILUS_LIST_BASE (self), pos, GTK_LIST_SCROLL_FOCUS, NULL);
+        if (shift)
+        {
+            self->anchor_position = saved_anchor < total_items ? saved_anchor : current_pos;
+        }
+        return GDK_EVENT_STOP;
+    }
+
+    return GDK_EVENT_PROPAGATE;
+}
