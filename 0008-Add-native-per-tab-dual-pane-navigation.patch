diff --git a/src/resources/ui/nautilus-window-tab.blp b/src/resources/ui/nautilus-window-tab.blp
new file mode 100644
index 0000000..bfb44f3
--- /dev/null
+++ b/src/resources/ui/nautilus-window-tab.blp
@@ -0,0 +1,26 @@
+using Gtk 4.0;
+using Adw 1;
+
+template $NautilusWindowTab: Adw.Bin {
+  child: Paned paned {
+    orientation: horizontal;
+    wide-handle: false;
+    // GtkPaned defaults to hidden, which clips the islands' outside shadows.
+    overflow: visible;
+    resize-start-child: true;
+    resize-end-child: true;
+    shrink-start-child: true;
+    shrink-end-child: true;
+
+    [start]
+    Box start_box {
+      orientation: vertical;
+      hexpand: true;
+      vexpand: true;
+      width-request: 0;
+      height-request: 0;
+      overflow: hidden;
+      styles [ "split-pane" ]
+    }
+  };
+}
