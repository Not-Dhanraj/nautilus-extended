+#include <glib/gi18n.h>
+
+#include "nautilus-window-tab.h"
+#include "nautilus-scheme.h"
+#include "nautilus-grid-view.h"
+
+struct _NautilusWindowTab
+{
+    AdwBin parent_instance;
+
+    /* Template widgets */
+    GtkPaned *paned;
+
+    /* Start pane (index 0) */
+    GtkWidget *start_box;
+    NautilusWindowSlot *primary_slot;
+
+    /* End pane (index 1) */
+    GtkWidget *end_box;
+    NautilusWindowSlot *secondary_slot;
+    gboolean split_visible;
+
+    guint remembered_pane; /* 0 or 1 */
+    double split_fraction;
+    int paned_span;
+    int paned_width;
+    gboolean setting_position;
+    gboolean user_adjusting;
+    int pending_position;
+
+    char *title;
+    char *tooltip;
+    gboolean loading;
+};
+
+G_DEFINE_TYPE (NautilusWindowTab, nautilus_window_tab, ADW_TYPE_BIN)
+
+static GtkSizeRequestMode
+tab_request_mode (GtkWidget *widget)
+{
+    GtkWidget *child = adw_bin_get_child (ADW_BIN (widget));
+
+    return child != NULL ? gtk_widget_get_request_mode (child) : GTK_SIZE_REQUEST_CONSTANT_SIZE;
+}
+
+static void
+tab_measure (GtkWidget      *widget,
+             GtkOrientation  orientation,
+             int             for_size,
+             int            *minimum,
+             int            *natural,
+             int            *minimum_baseline,
+             int            *natural_baseline)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (widget);
+    GtkWidget *child = adw_bin_get_child (ADW_BIN (widget));
+
+    *minimum = *natural = 0;
+    if (minimum_baseline != NULL)
+    {
+        *minimum_baseline = -1;
+    }
+    if (natural_baseline != NULL)
+    {
+        *natural_baseline = -1;
+    }
+    if (child == NULL)
+    {
+        return;
+    }
+
+    gtk_widget_measure (child, orientation, for_size, minimum, natural,
+                        minimum_baseline, natural_baseline);
+    if (self->split_visible && orientation == GTK_ORIENTATION_HORIZONTAL)
+    {
+        int start_minimum, end_minimum;
+
+        gtk_widget_measure (self->start_box, orientation, -1, &start_minimum, NULL, NULL, NULL);
+        gtk_widget_measure (self->end_box, orientation, -1, &end_minimum, NULL, NULL, NULL);
+        /* GtkPaned's shrinkable minimum omits the viewports, but the window cannot. */
+        *minimum += MAX (200, start_minimum) + MAX (200, end_minimum);
+        *natural = MAX (*natural, *minimum);
+    }
+}
+
+static void
+tab_allocate (GtkWidget *widget,
+              int        width,
+              int        height,
+              int        baseline)
+{
+    GtkWidget *child = adw_bin_get_child (ADW_BIN (widget));
+
+    if (child != NULL)
+    {
+        gtk_widget_allocate (child, width, height, baseline, NULL);
+    }
+}
+
+enum
+{
+    PROP_0,
+    PROP_TITLE,
+    PROP_TOOLTIP,
+    PROP_LOADING,
+    N_PROPERTIES
+};
+
+static GParamSpec *properties[N_PROPERTIES] = { NULL, };
+
+enum
+{
+    ACTIVATE_SLOT,
+    UNROOTING,
+    N_SIGNALS
+};
+
+static guint signals[N_SIGNALS] = { 0, };
+
+static void update_metadata (NautilusWindowTab *self);
+static void update_styling (NautilusWindowTab *self);
+static void setup_end_pane (NautilusWindowTab *self);
+
+static char *
+get_slot_tooltip_text (NautilusWindowSlot *slot)
+{
+    if (slot == NULL)
+    {
+        return NULL;
+    }
+
+    GFile *location = nautilus_window_slot_get_location (slot);
+    if (location == NULL)
+    {
+        const char *title = nautilus_window_slot_get_title (slot);
+        return g_markup_escape_text (title ? title : _("Loading…"), -1);
+    }
+
+    if (g_file_has_uri_scheme (location, SCHEME_SEARCH))
+    {
+        const char *title = nautilus_window_slot_get_title (slot);
+        return g_markup_escape_text (title ? title : _("Search"), -1);
+    }
+
+    g_autofree char *parse_name = g_file_get_parse_name (location);
+    return g_markup_escape_text (parse_name ? parse_name : "", -1);
+}
+
+static void
+on_slot_title_notify (GObject    *object,
+                      GParamSpec *pspec,
+                      gpointer    user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+    update_metadata (self);
+}
+
+static void
+on_slot_location_notify (GObject    *object,
+                         GParamSpec *pspec,
+                         gpointer    user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+    update_metadata (self);
+}
+
+static void
+on_slot_loading_notify (GObject    *object,
+                        GParamSpec *pspec,
+                        gpointer    user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+    update_metadata (self);
+}
+
+static void
+on_slot_active_notify (GObject    *object,
+                       GParamSpec *pspec,
+                       gpointer    user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+    update_styling (self);
+}
+
+static void
+connect_slot_signals (NautilusWindowTab  *self,
+                      NautilusWindowSlot *slot)
+{
+    g_signal_connect_object (slot, "notify::title", G_CALLBACK (on_slot_title_notify), self, 0);
+    g_signal_connect_object (slot, "notify::location", G_CALLBACK (on_slot_location_notify), self, 0);
+    g_signal_connect_object (slot, "notify::allow-stop", G_CALLBACK (on_slot_loading_notify), self, 0);
+    g_signal_connect_object (slot, "notify::loading", G_CALLBACK (on_slot_loading_notify), self, 0);
+    g_signal_connect_object (slot, "notify::active", G_CALLBACK (on_slot_active_notify), self, 0);
+}
+
+static void
+disconnect_slot_signals (NautilusWindowTab  *self,
+                         NautilusWindowSlot *slot)
+{
+    if (slot != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (slot, self);
+    }
+}
+
+static void
+update_metadata (NautilusWindowTab *self)
+{
+    gboolean changed_title = FALSE;
+    gboolean changed_tooltip = FALSE;
+    gboolean changed_loading = FALSE;
+
+    /* Title */
+    NautilusWindowSlot *active = nautilus_window_tab_get_remembered_slot (self);
+    const char *slot_title = active ? nautilus_window_slot_get_title (active) : NULL;
+    char *new_title = NULL;
+
+    if (self->split_visible)
+    {
+        new_title = g_strdup_printf (_("%s (Split)"), slot_title ? slot_title : _("Loading…"));
+    }
+    else
+    {
+        new_title = g_strdup (slot_title ? slot_title : _("Loading…"));
+    }
+
+    if (g_strcmp0 (self->title, new_title) != 0)
+    {
+        g_free (self->title);
+        self->title = new_title;
+        changed_title = TRUE;
+    }
+    else
+    {
+        g_free (new_title);
+    }
+
+    /* Tooltip */
+    char *new_tooltip = NULL;
+    if (self->split_visible)
+    {
+        g_autofree char *t1 = get_slot_tooltip_text (self->primary_slot);
+        g_autofree char *t2 = get_slot_tooltip_text (self->secondary_slot);
+        new_tooltip = g_strdup_printf ("%s\n%s", t1 ? t1 : "", t2 ? t2 : "");
+    }
+    else
+    {
+        new_tooltip = get_slot_tooltip_text (active);
+    }
+
+    if (g_strcmp0 (self->tooltip, new_tooltip) != 0)
+    {
+        g_free (self->tooltip);
+        self->tooltip = new_tooltip;
+        changed_tooltip = TRUE;
+    }
+    else
+    {
+        g_free (new_tooltip);
+    }
+
+    /* Loading */
+    gboolean l1 = self->primary_slot ? nautilus_window_slot_get_allow_stop (self->primary_slot) : FALSE;
+    gboolean l2 = self->secondary_slot ? nautilus_window_slot_get_allow_stop (self->secondary_slot) : FALSE;
+    gboolean new_loading = l1 || l2;
+
+    if (self->loading != new_loading)
+    {
+        self->loading = new_loading;
+        changed_loading = TRUE;
+    }
+
+    if (changed_title)
+    {
+        g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_TITLE]);
+    }
+    if (changed_tooltip)
+    {
+        g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_TOOLTIP]);
+    }
+    if (changed_loading)
+    {
+        g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_LOADING]);
+    }
+}
+
+static void
+update_styling (NautilusWindowTab *self)
+{
+    gboolean split = self->split_visible;
+
+    if (split)
+    {
+        gtk_widget_add_css_class (GTK_WIDGET (self), "split-view");
+        gtk_widget_add_css_class (self->start_box, "card");
+        gtk_widget_add_css_class (self->end_box, "card");
+    }
+    else
+    {
+        gtk_widget_remove_css_class (GTK_WIDGET (self), "split-view");
+        gtk_widget_remove_css_class (self->start_box, "card");
+        gtk_widget_remove_css_class (self->start_box, "active-pane");
+        gtk_widget_remove_css_class (self->start_box, "inactive-pane");
+        if (self->end_box != NULL)
+        {
+            gtk_widget_remove_css_class (self->end_box, "card");
+            gtk_widget_remove_css_class (self->end_box, "active-pane");
+            gtk_widget_remove_css_class (self->end_box, "inactive-pane");
+        }
+    }
+
+    if (!split)
+    {
+        if (self->primary_slot != NULL)
+        {
+            gtk_widget_set_opacity (GTK_WIDGET (self->primary_slot), 1.0);
+        }
+        if (self->secondary_slot != NULL)
+        {
+            gtk_widget_set_opacity (GTK_WIDGET (self->secondary_slot), 1.0);
+        }
+        return;
+    }
+
+    gboolean start_active = FALSE;
+    if (self->primary_slot && nautilus_window_slot_get_active (self->primary_slot))
+    {
+        start_active = TRUE;
+    }
+    else if (self->secondary_slot && nautilus_window_slot_get_active (self->secondary_slot))
+    {
+        start_active = FALSE;
+    }
+    else
+    {
+        start_active = (self->remembered_pane == 0);
+    }
+    if (start_active)
+    {
+        gtk_widget_add_css_class (self->start_box, "active-pane");
+        gtk_widget_remove_css_class (self->start_box, "inactive-pane");
+        gtk_widget_remove_css_class (self->end_box, "active-pane");
+        gtk_widget_add_css_class (self->end_box, "inactive-pane");
+    }
+    else
+    {
+        gtk_widget_remove_css_class (self->start_box, "active-pane");
+        gtk_widget_add_css_class (self->start_box, "inactive-pane");
+        gtk_widget_add_css_class (self->end_box, "active-pane");
+        gtk_widget_remove_css_class (self->end_box, "inactive-pane");
+    }
+
+    gtk_widget_set_opacity (GTK_WIDGET (self->primary_slot), start_active ? 1.0 : 0.75);
+    gtk_widget_set_opacity (GTK_WIDGET (self->secondary_slot), start_active ? 0.75 : 1.0);
+}
+
+static void
+constrain_paned_position (GObject           *object,
+                          GParamSpec        *pspec,
+                          NautilusWindowTab *self)
+{
+    int minimum, maximum, start_minimum, end_minimum;
+
+    if (!self->split_visible || self->setting_position)
+    {
+        return;
+    }
+
+    g_object_get (self->paned, "min-position", &minimum, "max-position", &maximum, NULL);
+    if (maximum <= minimum)
+    {
+        return;
+    }
+
+    int width = gtk_widget_get_width (GTK_WIDGET (self->paned));
+    /* GTK can notify position before updating the bounds during allocation. */
+    if (g_str_equal (pspec->name, "position") && self->paned_span > 0 &&
+        width != self->paned_width && maximum - minimum == self->paned_span)
+    {
+        return;
+    }
+
+    gtk_widget_measure (self->start_box, GTK_ORIENTATION_HORIZONTAL, -1,
+                        &start_minimum, NULL, NULL, NULL);
+    gtk_widget_measure (self->end_box, GTK_ORIENTATION_HORIZONTAL, -1,
+                        &end_minimum, NULL, NULL, NULL);
+    start_minimum = MAX (200, start_minimum);
+    end_minimum = MAX (200, end_minimum);
+
+    if (start_minimum + end_minimum > maximum - minimum)
+    {
+        start_minimum = (maximum - minimum) / 2;
+        end_minimum = maximum - minimum - start_minimum;
+    }
+
+    int span = maximum - minimum;
+    int position = gtk_paned_get_position (self->paned);
+    if (self->pending_position >= 0)
+    {
+        self->split_fraction = CLAMP ((double) (self->pending_position - minimum) / span, 0.0, 1.0);
+        self->pending_position = -1;
+    }
+
+    int preferred = minimum + (int) (self->split_fraction * span + 0.5);
+    int bounded = CLAMP (preferred, minimum + start_minimum, maximum - end_minimum);
+    if (self->user_adjusting && span == self->paned_span &&
+        g_str_equal (pspec->name, "position") && position != bounded)
+    {
+        bounded = CLAMP (position, minimum + start_minimum, maximum - end_minimum);
+        self->split_fraction = (double) (bounded - minimum) / span;
+    }
+    self->paned_span = span;
+    self->paned_width = width;
+
+    if (position != bounded)
+    {
+        self->setting_position = TRUE;
+        gtk_paned_set_position (self->paned, bounded);
+        self->setting_position = FALSE;
+    }
+}
+
+static void
+on_divider_pressed (GtkGestureClick   *gesture,
+                    int                n_press,
+                    double             x,
+                    double             y,
+                    NautilusWindowTab *self)
+{
+    GtkWidget *picked = gtk_widget_pick (GTK_WIDGET (self->paned), x, y, GTK_PICK_DEFAULT);
+
+    self->user_adjusting = picked != NULL &&
+                           g_str_equal (gtk_widget_get_css_name (picked), "separator");
+}
+
+static gboolean
+on_divider_event (GtkEventControllerLegacy *controller,
+                  GdkEvent                 *event,
+                  NautilusWindowTab        *self)
+{
+    GdkEventType type = gdk_event_get_event_type (event);
+
+    if (type == GDK_BUTTON_RELEASE || type == GDK_TOUCH_END ||
+        type == GDK_TOUCH_CANCEL)
+    {
+        self->user_adjusting = FALSE;
+    }
+    else if (type == GDK_KEY_RELEASE)
+    {
+        self->user_adjusting = FALSE;
+    }
+    else if (type == GDK_KEY_PRESS)
+    {
+        GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (self));
+        GtkWidget *focus = root != NULL ? gtk_root_get_focus (root) : NULL;
+
+        self->user_adjusting = focus == GTK_WIDGET (self->paned) ||
+                               (focus != NULL &&
+                                gtk_widget_is_ancestor (focus, GTK_WIDGET (self->paned)) &&
+                                g_str_equal (gtk_widget_get_css_name (focus), "separator"));
+    }
+
+    return GDK_EVENT_PROPAGATE;
+}
+
+static void
+activate_clicked_slot (NautilusWindowTab  *self,
+                       NautilusWindowSlot *slot)
+{
+    if (slot != NULL && !nautilus_window_slot_get_active (slot))
+    {
+        g_signal_emit (self, signals[ACTIVATE_SLOT], 0, slot);
+        gtk_widget_grab_focus (GTK_WIDGET (slot));
+    }
+}
+
+static void
+on_start_pane_clicked (GtkGestureClick *gesture,
+                       int              n_press,
+                       double           x,
+                       double           y,
+                       gpointer         user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+
+    activate_clicked_slot (self, self->primary_slot);
+}
+
+static void
+on_end_pane_clicked (GtkGestureClick *gesture,
+                     int              n_press,
+                     double           x,
+                     double           y,
+                     gpointer         user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+
+    activate_clicked_slot (self, self->secondary_slot);
+}
+
+static gboolean
+is_editable_widget (GtkWidget *widget)
+{
+    for (GtkWidget *curr = widget; curr != NULL; curr = gtk_widget_get_parent (curr))
+    {
+        if (GTK_IS_EDITABLE (curr) || GTK_IS_TEXT_VIEW (curr))
+        {
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static void
+on_start_focus_enter (GtkEventControllerFocus *controller,
+                      gpointer                 user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+
+    if (self->primary_slot != NULL)
+    {
+        g_signal_emit (self, signals[ACTIVATE_SLOT], 0, self->primary_slot);
+    }
+}
+
+static void
+on_end_focus_enter (GtkEventControllerFocus *controller,
+                    gpointer                 user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+
+    if (self->secondary_slot != NULL)
+    {
+        g_signal_emit (self, signals[ACTIVATE_SLOT], 0, self->secondary_slot);
+    }
+}
+
+static gboolean
+on_key_pressed (GtkEventControllerKey *controller,
+                guint                  keyval,
+                guint                  keycode,
+                GdkModifierType        state,
+                gpointer               user_data)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (user_data);
+
+    if (!self->split_visible)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    if (keyval != GDK_KEY_Tab && keyval != GDK_KEY_ISO_Left_Tab && keyval != GDK_KEY_KP_Tab)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    if (state & (GDK_CONTROL_MASK | GDK_ALT_MASK | GDK_SUPER_MASK))
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    GtkRoot *root = gtk_widget_get_root (GTK_WIDGET (self));
+    if (root == NULL)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    GtkWidget *focus = gtk_root_get_focus (root);
+    if (focus == NULL || !gtk_widget_is_ancestor (focus, GTK_WIDGET (self)))
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    if (is_editable_widget (focus))
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    if (gtk_widget_get_ancestor (focus, GTK_TYPE_POPOVER) != NULL ||
+        gtk_widget_get_ancestor (focus, GTK_TYPE_DIALOG) != NULL ||
+        gtk_widget_get_ancestor (focus, ADW_TYPE_DIALOG) != NULL)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    /* Check file canvas ancestry (list view, grid view, column view, including grouped grid) */
+    gboolean is_canvas = (GTK_IS_LIST_VIEW (focus) ||
+                          GTK_IS_GRID_VIEW (focus) ||
+                          GTK_IS_COLUMN_VIEW (focus) ||
+                          NAUTILUS_IS_GRID_VIEW (focus) ||
+                          gtk_widget_get_ancestor (focus, GTK_TYPE_LIST_VIEW) != NULL ||
+                          gtk_widget_get_ancestor (focus, GTK_TYPE_GRID_VIEW) != NULL ||
+                          gtk_widget_get_ancestor (focus, GTK_TYPE_COLUMN_VIEW) != NULL);
+
+    if (!is_canvas)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    NautilusWindowSlot *target = NULL;
+    if (self->primary_slot != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (self->primary_slot)))
+    {
+        target = self->secondary_slot;
+    }
+    else if (self->secondary_slot != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (self->secondary_slot)))
+    {
+        target = self->primary_slot;
+    }
+
+    if (target != NULL)
+    {
+        g_signal_emit (self, signals[ACTIVATE_SLOT], 0, target);
+        gtk_widget_grab_focus (GTK_WIDGET (target));
+        return GDK_EVENT_STOP;
+    }
+
+    return GDK_EVENT_PROPAGATE;
+}
+
+static void
+setup_end_pane (NautilusWindowTab *self)
+{
+    if (self->end_box != NULL)
+    {
+        return;
+    }
+
+    self->end_box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    gtk_widget_set_hexpand (self->end_box, TRUE);
+    gtk_widget_set_vexpand (self->end_box, TRUE);
+    gtk_widget_set_size_request (self->end_box, 0, 0);
+    gtk_widget_set_overflow (self->end_box, GTK_OVERFLOW_HIDDEN);
+    gtk_widget_add_css_class (self->end_box, "split-pane");
+
+    GtkGesture *click = gtk_gesture_click_new ();
+    gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (click), 0);
+    gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (click), GTK_PHASE_CAPTURE);
+    g_signal_connect_object (click, "pressed", G_CALLBACK (on_end_pane_clicked), self, 0);
+    gtk_widget_add_controller (self->end_box, GTK_EVENT_CONTROLLER (click));
+
+    GtkEventController *focus = gtk_event_controller_focus_new ();
+    g_signal_connect_object (focus, "enter", G_CALLBACK (on_end_focus_enter), self, 0);
+    gtk_widget_add_controller (self->end_box, focus);
+}
+
+static void
+nautilus_window_tab_unroot (GtkWidget *widget)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (widget);
+
+    self->user_adjusting = FALSE;
+    g_signal_emit (self, signals[UNROOTING], 0);
+
+    GTK_WIDGET_CLASS (nautilus_window_tab_parent_class)->unroot (widget);
+}
+
+static void
+nautilus_window_tab_get_property (GObject    *object,
+                                  guint       prop_id,
+                                  GValue     *value,
+                                  GParamSpec *pspec)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (object);
+
+    switch (prop_id)
+    {
+        case PROP_TITLE:
+        {
+            g_value_set_string (value, self->title);
+        }
+        break;
+
+        case PROP_TOOLTIP:
+        {
+            g_value_set_string (value, self->tooltip);
+        }
+        break;
+
+        case PROP_LOADING:
+        {
+            g_value_set_boolean (value, self->loading);
+        }
+        break;
+
+        default:
+        {
+            G_OBJECT_WARN_INVALID_PROPERTY_ID (object, prop_id, pspec);
+        }
+        break;
+    }
+}
+
+static void
+nautilus_window_tab_dispose (GObject *object)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (object);
+
+    if (self->primary_slot != NULL)
+    {
+        disconnect_slot_signals (self, self->primary_slot);
+        self->primary_slot = NULL;
+    }
+
+    if (self->secondary_slot != NULL)
+    {
+        disconnect_slot_signals (self, self->secondary_slot);
+        self->secondary_slot = NULL;
+    }
+
+    if (self->paned != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (self->paned, self);
+    }
+
+    self->end_box = NULL;
+
+    adw_bin_set_child (ADW_BIN (self), NULL);
+    gtk_widget_dispose_template (GTK_WIDGET (self), NAUTILUS_TYPE_WINDOW_TAB);
+
+    G_OBJECT_CLASS (nautilus_window_tab_parent_class)->dispose (object);
+}
+
+static void
+nautilus_window_tab_finalize (GObject *object)
+{
+    NautilusWindowTab *self = NAUTILUS_WINDOW_TAB (object);
+
+    g_clear_pointer (&self->title, g_free);
+    g_clear_pointer (&self->tooltip, g_free);
+
+    G_OBJECT_CLASS (nautilus_window_tab_parent_class)->finalize (object);
+}
+
+static void
+nautilus_window_tab_class_init (NautilusWindowTabClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+    GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+    object_class->dispose = nautilus_window_tab_dispose;
+    object_class->finalize = nautilus_window_tab_finalize;
+    object_class->get_property = nautilus_window_tab_get_property;
+
+    widget_class->unroot = nautilus_window_tab_unroot;
+
+    properties[PROP_TITLE] =
+        g_param_spec_string ("title",
+                             "Title",
+                             "The title of the tab",
+                             NULL,
+                             G_PARAM_READABLE | G_PARAM_STATIC_STRINGS);
+
+    properties[PROP_TOOLTIP] =
+        g_param_spec_string ("tooltip",
+                             "Tooltip",
+                             "The tooltip of the tab",
+                             NULL,
+                             G_PARAM_READABLE | G_PARAM_STATIC_STRINGS);
+
+    properties[PROP_LOADING] =
+        g_param_spec_boolean ("loading",
+                              "Loading",
+                              "Whether either slot in the tab is loading",
+                              FALSE,
+                              G_PARAM_READABLE | G_PARAM_STATIC_STRINGS);
+
+    g_object_class_install_properties (object_class, N_PROPERTIES, properties);
+
+    signals[ACTIVATE_SLOT] =
+        g_signal_new ("activate-slot",
+                      G_TYPE_FROM_CLASS (klass),
+                      G_SIGNAL_RUN_LAST,
+                      0,
+                      NULL, NULL,
+                      g_cclosure_marshal_VOID__OBJECT,
+                      G_TYPE_NONE, 1,
+                      NAUTILUS_TYPE_WINDOW_SLOT);
+
+    signals[UNROOTING] =
+        g_signal_new ("unrooting",
+                      G_TYPE_FROM_CLASS (klass),
+                      G_SIGNAL_RUN_LAST,
+                      0,
+                      NULL, NULL,
+                      g_cclosure_marshal_VOID__VOID,
+                      G_TYPE_NONE, 0);
+
+    gtk_widget_class_set_template_from_resource (widget_class,
+                                                 "/org/gnome/nautilus/ui/nautilus-window-tab.ui");
+
+    gtk_widget_class_bind_template_child (widget_class, NautilusWindowTab, paned);
+    gtk_widget_class_bind_template_child (widget_class, NautilusWindowTab, start_box);
+}
+
+static void
+nautilus_window_tab_init (NautilusWindowTab *self)
+{
+    gtk_widget_init_template (GTK_WIDGET (self));
+    gtk_widget_add_css_class (GTK_WIDGET (self), "nautilus-window-tab");
+    gtk_widget_set_layout_manager (GTK_WIDGET (self),
+                                   gtk_custom_layout_new (tab_request_mode, tab_measure, tab_allocate));
+
+    self->remembered_pane = 0;
+
+    /* Click activation on start pane */
+    GtkGesture *click = gtk_gesture_click_new ();
+    gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (click), 0);
+    gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (click), GTK_PHASE_CAPTURE);
+    g_signal_connect_object (click, "pressed", G_CALLBACK (on_start_pane_clicked), self, 0);
+    gtk_widget_add_controller (self->start_box, GTK_EVENT_CONTROLLER (click));
+
+    /* Focus activation on start pane */
+    GtkEventController *focus = gtk_event_controller_focus_new ();
+    g_signal_connect_object (focus, "enter", G_CALLBACK (on_start_focus_enter), self, 0);
+    gtk_widget_add_controller (self->start_box, focus);
+
+    /* Contextual Tab key handler */
+    GtkEventController *key = gtk_event_controller_key_new ();
+    gtk_event_controller_set_propagation_phase (key, GTK_PHASE_CAPTURE);
+    g_signal_connect_object (key, "key-pressed", G_CALLBACK (on_key_pressed), self, 0);
+    gtk_widget_add_controller (GTK_WIDGET (self), key);
+
+    g_signal_connect_object (self->paned, "notify::position",
+                             G_CALLBACK (constrain_paned_position), self, 0);
+    g_signal_connect_object (self->paned, "notify::min-position",
+                             G_CALLBACK (constrain_paned_position), self, 0);
+    g_signal_connect_object (self->paned, "notify::max-position",
+                             G_CALLBACK (constrain_paned_position), self, 0);
+
+    GtkGesture *divider_click = gtk_gesture_click_new ();
+    gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (divider_click), GDK_BUTTON_PRIMARY);
+    gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (divider_click), GTK_PHASE_CAPTURE);
+    g_signal_connect_object (divider_click, "pressed", G_CALLBACK (on_divider_pressed), self, 0);
+    gtk_widget_add_controller (GTK_WIDGET (self->paned), GTK_EVENT_CONTROLLER (divider_click));
+
+    GtkEventController *divider_events = gtk_event_controller_legacy_new ();
+    gtk_event_controller_set_propagation_phase (divider_events, GTK_PHASE_CAPTURE);
+    g_signal_connect_object (divider_events, "event", G_CALLBACK (on_divider_event), self, 0);
+    gtk_widget_add_controller (GTK_WIDGET (self->paned), divider_events);
+
+}
+
+NautilusWindowTab *
+nautilus_window_tab_new (NautilusWindowSlot *primary_slot)
+{
+    g_return_val_if_fail (NAUTILUS_IS_WINDOW_SLOT (primary_slot), NULL);
+
+    NautilusWindowTab *self = g_object_new (NAUTILUS_TYPE_WINDOW_TAB, NULL);
+
+    self->primary_slot = primary_slot;
+    gtk_box_append (GTK_BOX (self->start_box), GTK_WIDGET (primary_slot));
+    connect_slot_signals (self, primary_slot);
+
+    update_styling (self);
+    update_metadata (self);
+
+    return self;
+}
+
+NautilusWindowSlot *
+nautilus_window_tab_get_slot (NautilusWindowTab *self,
+                              guint              index)
+{
+    g_return_val_if_fail (NAUTILUS_IS_WINDOW_TAB (self), NULL);
+
+    if (index == 0)
+    {
+        return self->primary_slot;
+    }
+    if (index == 1)
+    {
+        return self->secondary_slot;
+    }
+
+    return NULL;
+}
+
+NautilusWindowSlot *
+nautilus_window_tab_get_remembered_slot (NautilusWindowTab *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_WINDOW_TAB (self), NULL);
+
+    if (self->remembered_pane == 1 && self->secondary_slot != NULL)
+    {
+        return self->secondary_slot;
+    }
+
+    return self->primary_slot;
+}
+
+void
+nautilus_window_tab_remember_slot (NautilusWindowTab  *self,
+                                   NautilusWindowSlot *slot)
+{
+    g_return_if_fail (NAUTILUS_IS_WINDOW_TAB (self));
+    g_return_if_fail (NAUTILUS_IS_WINDOW_SLOT (slot));
+
+    if (slot == self->primary_slot)
+    {
+        self->remembered_pane = 0;
+    }
+    else if (slot == self->secondary_slot)
+    {
+        self->remembered_pane = 1;
+    }
+    else
+    {
+        g_warning ("Slot does not belong to NautilusWindowTab");
+        return;
+    }
+
+    update_styling (self);
+    update_metadata (self);
+}
+
+void
+nautilus_window_tab_add_secondary (NautilusWindowTab  *self,
+                                   NautilusWindowSlot *slot)
+{
+    g_return_if_fail (NAUTILUS_IS_WINDOW_TAB (self));
+    g_return_if_fail (NAUTILUS_IS_WINDOW_SLOT (slot));
+    g_return_if_fail (self->secondary_slot == NULL);
+
+    self->secondary_slot = slot;
+    self->split_visible = TRUE;
+    self->split_fraction = 0.5;
+    self->paned_span = 0;
+    self->paned_width = 0;
+    self->pending_position = -1;
+    self->user_adjusting = FALSE;
+    setup_end_pane (self);
+
+    gtk_box_append (GTK_BOX (self->end_box), GTK_WIDGET (slot));
+    gtk_paned_set_end_child (self->paned, self->end_box);
+
+    connect_slot_signals (self, slot);
+
+    /* Initialize once; allocation changes scale the user's divider proportion. */
+    int width = gtk_widget_get_width (GTK_WIDGET (self->paned));
+    gtk_paned_set_position (self->paned, width > 0 ? width / 2 : -1);
+
+    update_styling (self);
+    update_metadata (self);
+}
+
+void
+nautilus_window_tab_remove_slot (NautilusWindowTab  *self,
+                                 NautilusWindowSlot *slot)
+{
+    g_return_if_fail (NAUTILUS_IS_WINDOW_TAB (self));
+    g_return_if_fail (self->secondary_slot != NULL);
+    g_return_if_fail (slot == self->primary_slot || slot == self->secondary_slot);
+
+    disconnect_slot_signals (self, slot);
+
+    if (slot == self->primary_slot)
+    {
+        NautilusWindowSlot *survivor = self->secondary_slot;
+        g_object_ref (survivor);
+
+        gtk_box_remove (GTK_BOX (self->end_box), GTK_WIDGET (survivor));
+        gtk_box_remove (GTK_BOX (self->start_box), GTK_WIDGET (slot));
+        gtk_box_append (GTK_BOX (self->start_box), GTK_WIDGET (survivor));
+
+        self->primary_slot = survivor;
+        self->secondary_slot = NULL;
+
+        gtk_paned_set_end_child (self->paned, NULL);
+        g_object_unref (survivor);
+    }
+    else
+    {
+        gtk_box_remove (GTK_BOX (self->end_box), GTK_WIDGET (slot));
+        self->secondary_slot = NULL;
+        gtk_paned_set_end_child (self->paned, NULL);
+    }
+
+    self->end_box = NULL;
+    self->split_visible = FALSE;
+    gtk_widget_set_visible (self->start_box, TRUE);
+    self->remembered_pane = 0;
+
+    update_styling (self);
+    update_metadata (self);
+}
+
+gboolean
+nautilus_window_tab_is_split (NautilusWindowTab *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_WINDOW_TAB (self), FALSE);
+
+    return self->split_visible;
+}
+
+void
+nautilus_window_tab_set_split_visible (NautilusWindowTab *self,
+                                       gboolean           visible)
+{
+    g_return_if_fail (NAUTILUS_IS_WINDOW_TAB (self));
+    g_return_if_fail (self->secondary_slot != NULL);
+
+    self->split_visible = visible;
+    gtk_widget_set_visible (self->start_box, visible || self->remembered_pane == 0);
+    gtk_widget_set_visible (self->end_box, visible || self->remembered_pane == 1);
+    gtk_widget_queue_resize (GTK_WIDGET (self));
+    update_styling (self);
+    update_metadata (self);
+}
+
+int
+nautilus_window_tab_get_position (NautilusWindowTab *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_WINDOW_TAB (self), 0);
+
+    return gtk_paned_get_position (self->paned);
+}
+
+void
+nautilus_window_tab_set_position (NautilusWindowTab *self,
+                                  int                position)
+{
+    g_return_if_fail (NAUTILUS_IS_WINDOW_TAB (self));
+
+    self->pending_position = position;
+
+    gtk_paned_set_position (self->paned, position);
+    if (self->pending_position >= 0)
+    {
+        constrain_paned_position (G_OBJECT (self->paned),
+                                  g_object_class_find_property (G_OBJECT_GET_CLASS (self->paned), "position"),
+                                  self);
+    }
+}
