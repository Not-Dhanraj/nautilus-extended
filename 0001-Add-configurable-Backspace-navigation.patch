+static void
+action_backspace (GSimpleAction *action,
+                  GVariant      *parameter,
+                  gpointer       user_data)
+{
+    NautilusWindowSlot *self = NAUTILUS_WINDOW_SLOT (user_data);
+    gboolean history_back = g_settings_get_enum (nautilus_preferences,
+                                                 NAUTILUS_PREFERENCES_BACKSPACE_ACTION) ==
+                            NAUTILUS_BACKSPACE_ACTION_HISTORY_BACK;
+
+    g_action_group_activate_action (G_ACTION_GROUP (self->slot_action_group),
+                                    history_back ? "back" : "up", NULL);
+}
