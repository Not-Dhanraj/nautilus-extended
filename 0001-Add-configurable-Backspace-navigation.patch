diff --git a/test/display/test-files-view.c b/test/display/test-files-view.c
index 003d2d588..6e7643b36 100644
--- a/test/display/test-files-view.c
+++ b/test/display/test-files-view.c
@@ -1265,6 +1265,65 @@ test_load_dir (void)
     test_clear_tmp_dir ();
 }
 
+static void
+assert_slot_location (NautilusWindowSlot *slot,
+                      GFile              *expected)
+{
+    ITER_CONTEXT_WHILE (nautilus_window_slot_get_allow_stop (slot));
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (slot), expected));
+}
+
+static void
+test_backspace_navigation (void)
+{
+    int saved_action = g_settings_get_enum (nautilus_preferences, NAUTILUS_PREFERENCES_BACKSPACE_ACTION);
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (GFile) parent = g_file_new_for_path (test_get_tmp_dir ());
+    g_autoptr (GFile) first = g_file_get_child (parent, "first");
+    g_autoptr (GFile) second = g_file_get_child (parent, "second");
+    g_autoptr (GFile) root = g_file_new_for_path ("/");
+    g_autoptr (GError) error = NULL;
+
+    g_file_make_directory (first, NULL, &error);
+    g_assert_no_error (error);
+    g_file_make_directory (second, NULL, &error);
+    g_assert_no_error (error);
+    nautilus_window_slot_open_location_full (slot, first, NULL);
+    assert_slot_location (slot, first);
+
+    /* No history must not fall back to the parent. */
+    g_settings_set_enum (nautilus_preferences, NAUTILUS_PREFERENCES_BACKSPACE_ACTION,
+                         NAUTILUS_BACKSPACE_ACTION_HISTORY_BACK);
+    gtk_widget_activate_action (GTK_WIDGET (slot), "slot.backspace", NULL);
+    assert_slot_location (slot, first);
+
+    nautilus_window_slot_open_location_full (slot, second, NULL);
+    assert_slot_location (slot, second);
+    g_settings_set_enum (nautilus_preferences, NAUTILUS_PREFERENCES_BACKSPACE_ACTION,
+                         NAUTILUS_BACKSPACE_ACTION_PARENT_FOLDER);
+    gtk_widget_activate_action (GTK_WIDGET (slot), "slot.backspace", NULL);
+    assert_slot_location (slot, parent);
+
+    /* Existing slots pick up the preference immediately. */
+    g_settings_set_enum (nautilus_preferences, NAUTILUS_PREFERENCES_BACKSPACE_ACTION,
+                         NAUTILUS_BACKSPACE_ACTION_HISTORY_BACK);
+    gtk_widget_activate_action (GTK_WIDGET (slot), "slot.backspace", NULL);
+    assert_slot_location (slot, second);
+    gtk_widget_activate_action (GTK_WIDGET (slot), "slot.backspace", NULL);
+    assert_slot_location (slot, first);
+
+    nautilus_window_slot_open_location_full (slot, root, NULL);
+    assert_slot_location (slot, root);
+    g_settings_set_enum (nautilus_preferences, NAUTILUS_PREFERENCES_BACKSPACE_ACTION,
+                         NAUTILUS_BACKSPACE_ACTION_PARENT_FOLDER);
+    gtk_widget_activate_action (GTK_WIDGET (slot), "slot.backspace", NULL);
+    assert_slot_location (slot, root);
+
+    g_settings_set_enum (nautilus_preferences, NAUTILUS_PREFERENCES_BACKSPACE_ACTION, saved_action);
+    g_clear_object (&slot);
+    test_clear_tmp_dir ();
+}
+
 int
 main (int   argc,
       char *argv[])
