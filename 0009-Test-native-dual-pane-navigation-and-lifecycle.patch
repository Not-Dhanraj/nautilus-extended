+static void
+test_window_reuse_focus (void)
+{
+    NautilusApplication *app = NAUTILUS_APPLICATION (g_application_get_default ());
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    g_autoptr (GError) error = NULL;
+    g_autofree char *tmp = g_dir_make_tmp ("nautilus-reuse-focus-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_autoptr (GFile) root = g_file_new_for_path (tmp);
+    g_autoptr (GFile) dir_a = g_file_get_child (root, "A");
+    g_autoptr (GFile) dir_b = g_file_get_child (root, "B");
+    g_autoptr (GFile) dir_c = g_file_get_child (root, "C");
+    g_assert_true (g_file_make_directory (dir_a, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_make_directory (dir_b, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_make_directory (dir_c, NULL, &error));
+    g_assert_no_error (error);
+
+    NautilusWindow *window = nautilus_application_open_location_full (app, dir_a,
+                                                                     NAUTILUS_OPEN_FLAG_NEW_WINDOW,
+                                                                     NULL, NULL);
+    g_autoptr (NautilusWindowSlot) slot_a = get_active_slot (window);
+    wait_for_location (slot_a, dir_a);
+
+    activate (window, "win.toggle-split");
+    g_autoptr (NautilusWindowSlot) slot_b = get_active_slot (window);
+    wait_for_location (slot_b, home);
+    nautilus_window_slot_open_location_full (slot_b, dir_b, NULL);
+    wait_for_location (slot_b, dir_b);
+
+    /* Focus slot A and confirm it is active */
+    activate (window, "win.switch-pane");
+    assert_active_slot (window, slot_a);
+    gtk_widget_grab_focus (GTK_WIDGET (slot_a));
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    GtkWidget *focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (focus != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (slot_a)));
+
+    /* Finding 8: REUSE_EXISTING activates AND moves focus to target slot B */
+    nautilus_application_open_location_full (app, dir_b, NAUTILUS_OPEN_FLAG_REUSE_EXISTING, NULL, NULL);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    assert_active_slot (window, slot_b);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (focus != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (slot_b)));
+
+    /* Open new foreground tab C with slot C focused */
+    nautilus_window_open_location_full (window, dir_c, NAUTILUS_OPEN_FLAG_NEW_TAB, NULL);
+    g_autoptr (NautilusWindowSlot) slot_c = get_active_slot (window);
+    wait_for_location (slot_c, dir_c);
+    gtk_widget_grab_focus (GTK_WIDGET (slot_c));
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    assert_active_slot (window, slot_c);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (focus != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (slot_c)));
+
+    /* Background tab reuse with DONT_MAKE_ACTIVE preserves foreground tab focus */
+    nautilus_application_open_location_full (app, dir_b,
+                                             NAUTILUS_OPEN_FLAG_REUSE_EXISTING | NAUTILUS_OPEN_FLAG_DONT_MAKE_ACTIVE,
+                                             NULL, NULL);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    assert_active_slot (window, slot_c);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (focus != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (slot_c)));
+
+    /* Background tab reuse without DONT_MAKE_ACTIVE switches to slot B and moves focus */
+    nautilus_application_open_location_full (app, dir_b, NAUTILUS_OPEN_FLAG_REUSE_EXISTING, NULL, NULL);
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    assert_active_slot (window, slot_b);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (focus != NULL && gtk_widget_is_ancestor (focus, GTK_WIDGET (slot_b)));
+
+    while (nautilus_application_get_windows (app) != NULL)
+    {
+        nautilus_window_close (NAUTILUS_WINDOW (nautilus_application_get_windows (app)->data));
+    }
+    empty_directory_by_prefix (root, "");
+    g_rmdir (tmp);
+}
