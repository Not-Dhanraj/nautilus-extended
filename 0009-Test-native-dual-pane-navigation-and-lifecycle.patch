+static void
+test_split_lifecycle (void)
+{
+    NautilusApplication *app = NAUTILUS_APPLICATION (g_application_get_default ());
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    g_autoptr (GError) error = NULL;
+    g_autofree char *tmp = g_dir_make_tmp ("nautilus-dual-pane-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_autoptr (GFile) root = g_file_new_for_path (tmp);
+    g_autoptr (GFile) dir_a = g_file_get_child (root, "A");
+    g_autoptr (GFile) dir_b = g_file_get_child (root, "B");
+    g_autoptr (GFile) dir_c = g_file_get_child (root, "C");
+    g_assert_true (g_file_make_directory (dir_a, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_make_directory (dir_b, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_make_directory (dir_c, NULL, &error));
+    g_assert_no_error (error);
+
+    NautilusWindow *window = nautilus_application_open_location_full (app, dir_a,
+                                                                     NAUTILUS_OPEN_FLAG_NEW_WINDOW,
+                                                                     NULL, NULL);
+    g_autoptr (NautilusWindowSlot) first = get_active_slot (window);
+    wait_for_location (first, dir_a);
+
+    activate (window, "win.toggle-split");
+    g_autoptr (NautilusWindowSlot) second = get_active_slot (window);
+    wait_for_location (second, home);
+    nautilus_window_slot_open_location_full (second, dir_b, NULL);
+    wait_for_location (second, dir_b);
+
+    NautilusWindowTab *tab = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (second),
+                                                                         NAUTILUS_TYPE_WINDOW_TAB));
+    assert_split_resize (tab);
+
+    /* Root navigation follows focus, without changing the other pane. */
+    activate (window, "win.switch-pane");
+    g_autofree char *uri_c = g_file_get_uri (dir_c);
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), "slot.open-location", "s", uri_c));
+    wait_for_location (first, dir_c);
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (second), dir_b));
+    g_assert_true (nautilus_window_slot_get_active (first));
+    g_assert_false (nautilus_window_slot_get_active (second));
+
+    /* Ctrl+W closes the focused pane, not the only tab/window. */
+    activate (window, "win.close-current-view");
+    g_assert_true (g_file_equal (nautilus_window_get_active_location (window), dir_b));
+    g_assert_false (nautilus_window_has_open_location (window, dir_c));
+    g_assert_cmpuint (g_list_length (nautilus_application_get_windows (app)), ==, 1);
+
+    /* F3-off keeps the active right pane and its history. */
+    activate (window, "win.toggle-split");
+    g_autoptr (NautilusWindowSlot) right = get_active_slot (window);
+    wait_for_location (right, home);
+    nautilus_window_slot_open_location_full (right, dir_a, NULL);
+    wait_for_location (right, dir_a);
+    activate (window, "win.toggle-split");
+    g_assert_true (g_file_equal (nautilus_window_get_active_location (window), dir_a));
+    g_assert_false (nautilus_window_has_open_location (window, dir_b));
+    g_assert_false (nautilus_window_tab_is_split (tab));
+    activate (window, "slot.back");
+    wait_for_location (right, home);
+
+    /* New tabs do not inherit split state; whole-tab restore retains both panes. */
+    activate (window, "win.toggle-split");
+    assert_active_slot (window, right);
+    g_assert_true (nautilus_window_tab_is_split (tab));
+    g_assert_true (nautilus_window_tab_get_slot (tab, 0) == second);
+    g_assert_true (nautilus_window_tab_get_slot (tab, 1) == right);
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (second), dir_b));
+    activate (window, "win.switch-pane");
+    activate (window, "slot.back");
+    wait_for_location (second, home);
+    activate (window, "slot.forward");
+    wait_for_location (second, dir_b);
+    activate (window, "win.switch-pane");
+    activate (window, "slot.forward");
+    wait_for_location (right, dir_a);
+    g_autoptr (NautilusWindowSlot) restore_right = g_object_ref (right);
+    /* Both sides can be hidden and restored without changing the active slot. */
+    activate (window, "win.switch-pane");
+    activate (window, "win.toggle-split");
+    assert_active_slot (window, second);
+    g_assert_false (gtk_widget_get_visible (gtk_widget_get_parent (GTK_WIDGET (right))));
+    activate (window, "win.toggle-split");
+    activate (window, "win.switch-pane");
+    activate (window, "win.new-tab");
+    g_autoptr (NautilusWindowSlot) other_tab = get_active_slot (window);
+    wait_for_location (other_tab, dir_a);
+    NautilusWindowTab *other = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (other_tab),
+                                                                          NAUTILUS_TYPE_WINDOW_TAB));
+    g_assert_null (nautilus_window_tab_get_slot (other, 1));
+    g_object_set (window, "active-slot", restore_right, NULL);
+    activate (window, "win.toggle-split");
+    activate (window, "win.close-tab");
+    activate (window, "win.restore-tab");
+    g_autoptr (NautilusWindowSlot) restored = get_active_slot (window);
+    wait_for_location (restored, dir_a);
+    NautilusWindowTab *restored_tab = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (restored),
+                                                                                 NAUTILUS_TYPE_WINDOW_TAB));
+    g_assert_false (nautilus_window_tab_is_split (restored_tab));
+    activate (window, "win.toggle-split");
+    NautilusWindowSlot *restored_left = nautilus_window_tab_get_slot (restored_tab, 0);
+    NautilusWindowSlot *restored_second = nautilus_window_tab_get_slot (restored_tab, 1);
+    g_assert_nonnull (restored_second);
+    wait_for_location (restored_left, dir_b);
+    activate (window, "win.switch-pane");
+    activate (window, "slot.back");
+    wait_for_location (restored_left, home);
+    activate (window, "slot.forward");
+    wait_for_location (restored_left, dir_b);
+    activate (window, "win.switch-pane");
+    activate (window, "slot.back");
+    wait_for_location (restored, home);
+    activate (window, "slot.forward");
+    wait_for_location (restored, dir_a);
+
+    /* Transfer then close the source: callbacks and root actions belong to destination. */
+    activate (window, "win.toggle-split");
+    activate (window, "win.tab-move-new-window");
+    NautilusWindow *destination = NAUTILUS_WINDOW (gtk_widget_get_root (GTK_WIDGET (restored)));
+    g_assert_true (destination != window);
+    nautilus_window_close (window);
+    g_object_set (destination, "active-slot", restored, NULL);
+    g_assert_false (nautilus_window_tab_is_split (restored_tab));
+    activate (destination, "win.toggle-split");
+    activate (destination, "win.switch-pane");
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (destination), "slot.open-location", "s", uri_c));
+    wait_for_location (restored_left, dir_c);
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (restored), dir_a));
+
+    while (nautilus_application_get_windows (app) != NULL)
+    {
+        nautilus_window_close (NAUTILUS_WINDOW (nautilus_application_get_windows (app)->data));
+    }
+    empty_directory_by_prefix (root, "");
+    g_rmdir (tmp);
+}
