+
+    GtkWidget *toolbar = gtk_widget_get_ancestor (GTK_WIDGET (nautilus_window_slot_get_query_editor (right_slot4)),
+                                                 NAUTILUS_TYPE_TOOLBAR);
+    g_assert_nonnull (toolbar);
+    g_assert_true (gtk_widget_activate_action (toolbar, "toolbar.edit-location", NULL));
+    while (g_main_context_iteration (NULL, FALSE))
+    {
+    }
+    GtkWidget *entry_focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_nonnull (entry_focus);
+    g_assert_false (gtk_widget_is_ancestor (entry_focus, GTK_WIDGET (tab4)));
+
+    /* F3 keep-active when focus is outside the tab: do not refocus survivor */
+    activate (window, "win.toggle-split");
+    wait_for_focus_frames (window);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_nonnull (focus);
+    g_assert_false (gtk_widget_is_ancestor (focus, GTK_WIDGET (tab4)));
+    g_assert_true (focus == entry_focus ||
+                   gtk_widget_is_ancestor (focus, entry_focus) ||
+                   gtk_widget_is_ancestor (entry_focus, focus));
+
+    while (nautilus_application_get_windows (app) != NULL)
+    {
+        nautilus_window_close (NAUTILUS_WINDOW (nautilus_application_get_windows (app)->data));
+    }
+    empty_directory_by_prefix (root, "");
+    g_rmdir (tmp);
+}
+
+static void
+test_window_restore_snapshot_normalization (void)
+{
+    NautilusApplication *app = NAUTILUS_APPLICATION (g_application_get_default ());
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    g_autoptr (GError) error = NULL;
+    g_autofree char *tmp = g_dir_make_tmp ("nautilus-restore-norm-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_autoptr (GFile) root = g_file_new_for_path (tmp);
+    g_autoptr (GFile) dir_a = g_file_get_child (root, "A");
+    g_autoptr (GFile) dir_b = g_file_get_child (root, "B");
+    g_assert_true (g_file_make_directory (dir_a, NULL, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_make_directory (dir_b, NULL, &error));
+    g_assert_no_error (error);
+
+    NautilusWindow *window = nautilus_application_open_location_full (app, dir_a,
+                                                                     NAUTILUS_OPEN_FLAG_NEW_WINDOW,
+                                                                     NULL, NULL);
+    g_autoptr (NautilusWindowSlot) base_slot = get_active_slot (window);
+    wait_for_location (base_slot, dir_a);
+
+    NautilusWindowTab *base_tab = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (base_slot),
+                                                                               NAUTILUS_TYPE_WINDOW_TAB));
+    AdwTabView *tab_view = ADW_TAB_VIEW (gtk_widget_get_ancestor (GTK_WIDGET (base_tab),
+                                                                 ADW_TYPE_TAB_VIEW));
+    g_assert_nonnull (tab_view);
+
+    GAction *restore_action = g_action_map_lookup_action (G_ACTION_MAP (window), "restore-tab");
+    g_assert_nonnull (restore_action);
+
+    /* Combo 1: primary valid, secondary valid */
+    nautilus_window_open_location_full (window, dir_a, NAUTILUS_OPEN_FLAG_NEW_TAB, NULL);
+    g_autoptr (NautilusWindowSlot) combo1_slot0 = get_active_slot (window);
+    wait_for_location (combo1_slot0, dir_a);
+    activate (window, "win.toggle-split");
+    g_autoptr (NautilusWindowSlot) combo1_slot1 = get_active_slot (window);
+    wait_for_location (combo1_slot1, home);
+    nautilus_window_slot_open_location_full (combo1_slot1, dir_b, NULL);
+    wait_for_location (combo1_slot1, dir_b);
+
+    NautilusNavigationState *nav1_0 = nautilus_window_slot_get_navigation_state (combo1_slot0);
+    NautilusNavigationState *nav1_1 = nautilus_window_slot_get_navigation_state (combo1_slot1);
+    g_assert_nonnull (nav1_0);
+    g_assert_nonnull (nav1_1);
+    free_navigation_state (nav1_0);
+    free_navigation_state (nav1_1);
+
+    activate (window, "win.close-tab");
+    g_assert_true (g_action_get_enabled (restore_action));
+
+    activate (window, "win.restore-tab");
+    g_autoptr (NautilusWindowSlot) restored1 = get_active_slot (window);
+    NautilusWindowTab *tab1 = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (restored1),
+                                                                           NAUTILUS_TYPE_WINDOW_TAB));
+    NautilusWindowSlot *res1_slot0 = nautilus_window_tab_get_slot (tab1, 0);
+    NautilusWindowSlot *res1_slot1 = nautilus_window_tab_get_slot (tab1, 1);
+    g_assert_nonnull (res1_slot0);
+    g_assert_nonnull (res1_slot1);
+    wait_for_location (res1_slot0, dir_a);
+    wait_for_location (res1_slot1, dir_b);
+    g_assert_false (g_action_get_enabled (restore_action));
+
+    /* Combo 2: primary valid, secondary uncommitted (NULL snapshot) */
+    g_autoptr (NautilusWindowSlot) combo2_slot0 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    nautilus_window_slot_open_location_full (combo2_slot0, dir_a, NULL);
+    wait_for_location (combo2_slot0, dir_a);
+    g_autoptr (NautilusWindowSlot) combo2_slot1 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    NautilusWindowTab *tab2 = nautilus_window_tab_new (combo2_slot0);
+    nautilus_window_tab_add_secondary (tab2, combo2_slot1);
+    AdwTabPage *page2 = adw_tab_view_append (tab_view, GTK_WIDGET (tab2));
+    adw_tab_view_set_selected_page (tab_view, page2);
+
+    NautilusNavigationState *nav2_0 = nautilus_window_slot_get_navigation_state (combo2_slot0);
+    NautilusNavigationState *nav2_1 = nautilus_window_slot_get_navigation_state (combo2_slot1);
+    g_assert_nonnull (nav2_0);
+    g_assert_null (nav2_1);
+    free_navigation_state (nav2_0);
+
+    activate (window, "win.close-tab");
+    g_assert_true (g_action_get_enabled (restore_action));
+
+    activate (window, "win.restore-tab");
+    g_autoptr (NautilusWindowSlot) restored2 = get_active_slot (window);
+    NautilusWindowTab *tab2_res = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (restored2),
+                                                                               NAUTILUS_TYPE_WINDOW_TAB));
+    NautilusWindowSlot *res2_slot0 = nautilus_window_tab_get_slot (tab2_res, 0);
+    NautilusWindowSlot *res2_slot1 = nautilus_window_tab_get_slot (tab2_res, 1);
+    g_assert_nonnull (res2_slot0);
+    g_assert_null (res2_slot1);
+    wait_for_location (res2_slot0, dir_a);
+    g_assert_false (g_action_get_enabled (restore_action));
+
+    /* Combo 3: primary uncommitted (NULL snapshot), secondary valid (committed location)
+     * Normalized: secondary is stolen into primary, remembered_pane set to 0, no empty restored slot */
+    g_autoptr (NautilusWindowSlot) combo3_slot0 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusWindowSlot) combo3_slot1 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    NautilusWindowTab *tab3 = nautilus_window_tab_new (combo3_slot0);
+    nautilus_window_tab_add_secondary (tab3, combo3_slot1);
+    AdwTabPage *page3 = adw_tab_view_append (tab_view, GTK_WIDGET (tab3));
+    adw_tab_view_set_selected_page (tab_view, page3);
+
+    nautilus_window_slot_open_location_full (combo3_slot1, dir_b, NULL);
+    wait_for_location (combo3_slot1, dir_b);
+
+    NautilusNavigationState *nav3_0 = nautilus_window_slot_get_navigation_state (combo3_slot0);
+    NautilusNavigationState *nav3_1 = nautilus_window_slot_get_navigation_state (combo3_slot1);
+    g_assert_null (nav3_0);
+    g_assert_nonnull (nav3_1);
+    free_navigation_state (nav3_1);
+
+    activate (window, "win.close-tab");
+    g_assert_true (g_action_get_enabled (restore_action));
+
+    activate (window, "win.restore-tab");
+    g_autoptr (NautilusWindowSlot) restored3 = get_active_slot (window);
+    NautilusWindowTab *tab3_res = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (restored3),
+                                                                               NAUTILUS_TYPE_WINDOW_TAB));
+    NautilusWindowSlot *res3_slot0 = nautilus_window_tab_get_slot (tab3_res, 0);
+    NautilusWindowSlot *res3_slot1 = nautilus_window_tab_get_slot (tab3_res, 1);
+    g_assert_nonnull (res3_slot0);
+    g_assert_null (res3_slot1);
+    wait_for_location (res3_slot0, dir_b);
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (res3_slot0), dir_b));
+    g_assert_false (g_action_get_enabled (restore_action));
+
+    /* Combo 4 (both uncommitted) with empty queue: record dropped, queue remains empty, restore remains disabled */
+    g_autoptr (NautilusWindowSlot) combo4_slot0 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusWindowSlot) combo4_slot1 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    NautilusWindowTab *tab4 = nautilus_window_tab_new (combo4_slot0);
+    nautilus_window_tab_add_secondary (tab4, combo4_slot1);
+    AdwTabPage *page4 = adw_tab_view_append (tab_view, GTK_WIDGET (tab4));
+    adw_tab_view_set_selected_page (tab_view, page4);
+
+    NautilusNavigationState *nav4_0 = nautilus_window_slot_get_navigation_state (combo4_slot0);
+    NautilusNavigationState *nav4_1 = nautilus_window_slot_get_navigation_state (combo4_slot1);
+    g_assert_null (nav4_0);
+    g_assert_null (nav4_1);
+
+    activate (window, "win.close-tab");
+    g_assert_false (g_action_get_enabled (restore_action));
+
+    /* Single uncommitted slot: record dropped, restore remains disabled */
+    g_autoptr (NautilusWindowSlot) single_uncommitted = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    NautilusWindowTab *single_tab = nautilus_window_tab_new (single_uncommitted);
+    AdwTabPage *single_page = adw_tab_view_append (tab_view, GTK_WIDGET (single_tab));
+    adw_tab_view_set_selected_page (tab_view, single_page);
+    activate (window, "win.close-tab");
+    g_assert_false (g_action_get_enabled (restore_action));
+
+    /* Older valid queue behind empty candidate, no empty restored slot:
+     * 1) Push older valid tab (dir_a) into queue */
+    nautilus_window_open_location_full (window, dir_a, NAUTILUS_OPEN_FLAG_NEW_TAB, NULL);
+    g_autoptr (NautilusWindowSlot) older_valid = get_active_slot (window);
+    wait_for_location (older_valid, dir_a);
+    activate (window, "win.close-tab");
+    g_assert_true (g_action_get_enabled (restore_action));
+
+    /* 2) Close empty candidate (Combo 4): must be dropped, preserving older valid queue */
+    g_autoptr (NautilusWindowSlot) empty_cand0 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusWindowSlot) empty_cand1 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    NautilusWindowTab *tab_empty = nautilus_window_tab_new (empty_cand0);
+    nautilus_window_tab_add_secondary (tab_empty, empty_cand1);
+    AdwTabPage *page_empty = adw_tab_view_append (tab_view, GTK_WIDGET (tab_empty));
+    adw_tab_view_set_selected_page (tab_view, page_empty);
+
+    activate (window, "win.close-tab");
+    /* Restore action is still enabled because older valid record was preserved */
+    g_assert_true (g_action_get_enabled (restore_action));
+
+    /* 3) Restore pops older valid tab, not an empty uncommitted slot */
+    activate (window, "win.restore-tab");
+    g_autoptr (NautilusWindowSlot) restored_older = get_active_slot (window);
+    g_assert_nonnull (restored_older);
+    wait_for_location (restored_older, dir_a);
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (restored_older), dir_a));
+    g_assert_false (g_action_get_enabled (restore_action));
+
+    while (nautilus_application_get_windows (app) != NULL)
+    {
+        nautilus_window_close (NAUTILUS_WINDOW (nautilus_application_get_windows (app)->data));
+    }
+    empty_directory_by_prefix (root, "");
+    g_rmdir (tmp);
+}
+
+
+int
+main (int argc, char *argv[])
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *config_dir = g_dir_make_tmp ("nautilus-dual-pane-config-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_setenv ("XDG_CONFIG_HOME", config_dir, TRUE);
+    g_setenv ("XDG_DATA_HOME", config_dir, TRUE);
+    g_setenv ("XDG_CACHE_HOME", config_dir, TRUE);
+    g_test_init (&argc, &argv, NULL);
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+    test_init_config_dir ();
+    g_autoptr (NautilusTagManager) tag_manager = nautilus_tag_manager_new_dummy ();
+    g_autoptr (NautilusApplication) app = nautilus_application_new ();
+    g_application_set_application_id (G_APPLICATION (app), "org.gnome.Nautilus.TestDualPane");
+    g_application_hold (G_APPLICATION (app));
+    g_assert_true (g_application_register (G_APPLICATION (app), NULL, &error));
+    g_assert_no_error (error);
+    g_test_add_func ("/window/dual-pane-lifecycle", test_split_lifecycle);
+    g_test_add_func ("/window-tab/disposal-and-retained-paned",
+                     test_tab_lifecycle_retained_and_repeated_dispose);
+    g_test_add_func ("/window/reuse-focus", test_window_reuse_focus);
+    g_test_add_func ("/window/promotion-and-close-focus", test_window_promotion_and_close_focus);
+    g_test_add_func ("/window/restore-snapshot-normalization", test_window_restore_snapshot_normalization);
+    int result = g_test_run ();
+    g_application_release (G_APPLICATION (app));
+    g_application_quit (G_APPLICATION (app));
+    g_clear_object (&app);
+    g_clear_object (&tag_manager);
+    g_autoptr (GFile) config = g_file_new_for_path (config_dir);
+    empty_directory_by_prefix (config, "");
+    g_rmdir (config_dir);
+    return result;
+}
