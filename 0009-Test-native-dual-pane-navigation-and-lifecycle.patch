diff --git a/test/display/test-window-tab-navigation.c b/test/display/test-window-tab-navigation.c
new file mode 100644
index 0000000..fe903af
--- /dev/null
+++ b/test/display/test-window-tab-navigation.c
@@ -0,0 +1,369 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include <glib/gstdio.h>
+#include <gtk/gtk.h>
+#include <gdk/gdkkeysyms.h>
+#include <nautilus-application.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-files-view.h>
+#include <nautilus-grid-view.h>
+#include <nautilus-list-base.h>
+#include <nautilus-resources.h>
+#include <nautilus-tag-manager.h>
+#include <nautilus-view-info.h>
+#include <nautilus-toolbar.h>
+#include <nautilus-window.h>
+#include <nautilus-window-slot.h>
+#include <nautilus-window-tab.h>
+#include <test-utilities.h>
+
+static NautilusWindowSlot *
+get_active_slot (NautilusWindow *window)
+{
+    NautilusWindowSlot *slot = NULL;
+
+    g_object_get (window, "active-slot", &slot, NULL);
+    return slot;
+}
+
+static void
+wait_for_location (NautilusWindowSlot *slot,
+                   GFile              *location)
+{
+    gint64 deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+
+    do
+    {
+        GFile *current = nautilus_window_slot_get_location (slot);
+
+        if (current != NULL && g_file_equal (current, location) &&
+            nautilus_window_slot_get_current_view (slot) != NULL &&
+            !nautilus_window_slot_get_loading (slot))
+        {
+            return;
+        }
+        g_main_context_iteration (NULL, FALSE);
+        g_usleep (1000);
+    }
+    while (g_get_monotonic_time () < deadline);
+    g_error ("Pane navigation fixture did not load");
+}
+
+static GtkWidget *
+find_widget (GtkWidget *widget,
+             GType      type)
+{
+    if (G_TYPE_CHECK_INSTANCE_TYPE (widget, type))
+    {
+        return widget;
+    }
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        GtkWidget *match = find_widget (child, type);
+
+        if (match != NULL)
+        {
+            return match;
+        }
+    }
+    return NULL;
+}
+
+static GtkEventControllerKey *
+get_tab_key_controller (NautilusWindowTab *tab)
+{
+    g_autoptr (GListModel) controllers = gtk_widget_observe_controllers (GTK_WIDGET (tab));
+
+    for (guint i = 0; i < g_list_model_get_n_items (controllers); i++)
+    {
+        g_autoptr (GObject) controller = g_list_model_get_item (controllers, i);
+
+        if (GTK_IS_EVENT_CONTROLLER_KEY (controller))
+        {
+            return GTK_EVENT_CONTROLLER_KEY (g_steal_pointer (&controller));
+        }
+    }
+    g_error ("Tab key controller not installed");
+}
+static GtkGestureClick *
+get_pane_click_gesture (GtkWidget *pane_box)
+{
+    g_autoptr (GListModel) controllers = gtk_widget_observe_controllers (pane_box);
+
+    for (guint i = 0; i < g_list_model_get_n_items (controllers); i++)
+    {
+        g_autoptr (GObject) controller = g_list_model_get_item (controllers, i);
+
+        if (GTK_IS_GESTURE_CLICK (controller))
+        {
+            return GTK_GESTURE_CLICK (g_steal_pointer (&controller));
+        }
+    }
+    g_error ("Pane click gesture not installed");
+}
+
+
+static void
+assert_propagates (NautilusWindow     *window,
+                   GtkEventControllerKey *controller,
+                   NautilusWindowSlot *expected)
+{
+    gboolean handled = FALSE;
+
+    g_signal_emit_by_name (controller, "key-pressed", GDK_KEY_Tab, 0, 0, &handled);
+    g_assert_false (handled);
+    g_autoptr (NautilusWindowSlot) active = get_active_slot (window);
+    g_assert_true (active == expected);
+}
+
+static void
+test_contextual_pane_navigation (void)
+{
+    NautilusApplication *app = NAUTILUS_APPLICATION (g_application_get_default ());
+    g_autoptr (GError) error = NULL;
+    g_autofree char *path = g_dir_make_tmp ("nautilus-pane-navigation-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_autoptr (GFile) root = g_file_new_for_path (path);
+    g_autoptr (GFile) dir_a = g_file_get_child (root, "A");
+    g_autoptr (GFile) dir_b = g_file_get_child (root, "B");
+    GFile *directories[] = { dir_a, dir_b };
+
+    for (guint i = 0; i < G_N_ELEMENTS (directories); i++)
+    {
+        g_assert_true (g_file_make_directory (directories[i], NULL, &error));
+        g_assert_no_error (error);
+        g_autoptr (GFile) file = g_file_get_child (directories[i], "example.txt");
+        g_assert_true (g_file_replace_contents (file, "test", 4, NULL, FALSE,
+                                              G_FILE_CREATE_NONE, NULL, NULL, &error));
+        g_assert_no_error (error);
+    }
+
+    NautilusWindow *window = nautilus_application_open_location_full (app, dir_a,
+                                                                     NAUTILUS_OPEN_FLAG_NEW_WINDOW,
+                                                                     NULL, NULL);
+    g_autoptr (NautilusWindowSlot) first = get_active_slot (window);
+    wait_for_location (first, dir_a);
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), "win.toggle-split", NULL));
+    g_autoptr (NautilusWindowSlot) second = get_active_slot (window);
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    wait_for_location (second, home);
+    nautilus_window_slot_open_location_full (second, dir_b, NULL);
+    wait_for_location (second, dir_b);
+    NautilusWindowTab *tab = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (first),
+                                                                       NAUTILUS_TYPE_WINDOW_TAB));
+    g_autoptr (GtkEventControllerKey) controller = get_tab_key_controller (tab);
+    NautilusFilesView *view = nautilus_window_slot_get_current_view (first);
+    if (nautilus_files_view_get_view_id (view) != NAUTILUS_VIEW_GRID_ID)
+    {
+        nautilus_files_view_change (view, NAUTILUS_VIEW_GRID_ID);
+        wait_for_location (first, dir_a);
+    }
+    NautilusListBase *base = nautilus_files_view_get_private_list_base (view);
+    GActionGroup *actions = nautilus_files_view_get_private_action_group (view);
+    const struct
+    {
+        guint key;
+        GdkModifierType modifiers;
+    } keys[] = {
+        { GDK_KEY_Tab, 0 },
+        { GDK_KEY_Tab, GDK_SHIFT_MASK },
+        { GDK_KEY_ISO_Left_Tab, GDK_SHIFT_MASK },
+    };
+
+    for (guint grouped = 0; grouped < 2; grouped++)
+    {
+        g_action_group_change_action_state (actions, "grouping",
+                                            g_variant_new_string (grouped ? "name" : "none"));
+        for (guint i = 0; i < G_N_ELEMENTS (keys); i++)
+        {
+            g_object_set (window, "active-slot", first, NULL);
+            g_assert_true (gtk_widget_grab_focus (GTK_WIDGET (base)));
+            GtkWidget *focus = gtk_root_get_focus (GTK_ROOT (window));
+            if (grouped)
+            {
+                g_assert_true (focus == GTK_WIDGET (base));
+                g_assert_true (NAUTILUS_IS_GRID_VIEW (focus));
+            }
+            else
+            {
+                g_assert_true (GTK_IS_GRID_VIEW (focus) ||
+                               gtk_widget_get_ancestor (focus, GTK_TYPE_GRID_VIEW) != NULL);
+            }
+            gboolean handled = FALSE;
+            g_signal_emit_by_name (controller, "key-pressed", keys[i].key, 0, keys[i].modifiers, &handled);
+            g_assert_true (handled);
+            g_autoptr (NautilusWindowSlot) active = get_active_slot (window);
+            g_assert_true (active == second);
+            focus = gtk_root_get_focus (GTK_ROOT (window));
+            g_assert_true (gtk_widget_is_ancestor (focus, GTK_WIDGET (second)));
+        }
+    }
+
+    g_object_set (window, "active-slot", first, NULL);
+    GtkWidget *toolbar = find_widget (GTK_WIDGET (window), NAUTILUS_TYPE_TOOLBAR);
+    g_assert_nonnull (toolbar);
+    g_assert_true (gtk_widget_activate_action (toolbar, "toolbar.edit-location", NULL));
+    g_assert_true (GTK_IS_EDITABLE (gtk_root_get_focus (GTK_ROOT (window))));
+    assert_propagates (window, controller, first);
+
+    g_autoptr (GtkWidget) popover = g_object_ref_sink (gtk_popover_new ());
+    GtkWidget *button = gtk_button_new_with_label ("Popup control");
+    gtk_popover_set_child (GTK_POPOVER (popover), button);
+    gtk_widget_set_parent (popover, GTK_WIDGET (view));
+    gtk_popover_popup (GTK_POPOVER (popover));
+    g_assert_true (gtk_widget_grab_focus (button));
+    assert_propagates (window, controller, first);
+    gtk_popover_popdown (GTK_POPOVER (popover));
+    gtk_widget_unparent (popover);
+
+    nautilus_window_close (window);
+    empty_directory_by_prefix (root, "");
+    g_rmdir (path);
+}
+static void
+test_click_pane_activation (void)
+{
+    NautilusApplication *app = NAUTILUS_APPLICATION (g_application_get_default ());
+    g_autoptr (GError) error = NULL;
+    g_autofree char *path = g_dir_make_tmp ("nautilus-pane-click-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_autoptr (GFile) root = g_file_new_for_path (path);
+    g_autoptr (GFile) dir_a = g_file_get_child (root, "A");
+    g_autoptr (GFile) dir_b = g_file_get_child (root, "B");
+    GFile *directories[] = { dir_a, dir_b };
+
+    for (guint i = 0; i < G_N_ELEMENTS (directories); i++)
+    {
+        g_assert_true (g_file_make_directory (directories[i], NULL, &error));
+        g_assert_no_error (error);
+        g_autoptr (GFile) file = g_file_get_child (directories[i], "example.txt");
+        g_assert_true (g_file_replace_contents (file, "test", 4, NULL, FALSE,
+                                              G_FILE_CREATE_NONE, NULL, NULL, &error));
+        g_assert_no_error (error);
+    }
+
+    NautilusWindow *window = nautilus_application_open_location_full (app, dir_a,
+                                                                     NAUTILUS_OPEN_FLAG_NEW_WINDOW,
+                                                                     NULL, NULL);
+    g_autoptr (NautilusWindowSlot) first = get_active_slot (window);
+    wait_for_location (first, dir_a);
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), "win.toggle-split", NULL));
+    g_autoptr (NautilusWindowSlot) second = get_active_slot (window);
+    g_autoptr (GFile) home = g_file_new_for_path (g_get_home_dir ());
+    wait_for_location (second, home);
+    nautilus_window_slot_open_location_full (second, dir_b, NULL);
+    wait_for_location (second, dir_b);
+
+    NautilusWindowTab *tab = NAUTILUS_WINDOW_TAB (gtk_widget_get_ancestor (GTK_WIDGET (first),
+                                                                           NAUTILUS_TYPE_WINDOW_TAB));
+    GtkWidget *start_box = gtk_widget_get_parent (GTK_WIDGET (first));
+    GtkWidget *end_box = gtk_widget_get_parent (GTK_WIDGET (second));
+
+    g_autoptr (GtkGestureClick) start_click = get_pane_click_gesture (start_box);
+    g_autoptr (GtkGestureClick) end_click = get_pane_click_gesture (end_box);
+    g_autoptr (GtkEventControllerKey) tab_key = get_tab_key_controller (tab);
+
+    /* Verify initial split frame classes (second slot is active) */
+    g_assert_true (gtk_widget_has_css_class (end_box, "active-pane"));
+    g_assert_false (gtk_widget_has_css_class (end_box, "inactive-pane"));
+    g_assert_false (gtk_widget_has_css_class (start_box, "active-pane"));
+    g_assert_true (gtk_widget_has_css_class (start_box, "inactive-pane"));
+
+    /* Clicking the inactive canvas switches slot, focus and styling. */
+    g_signal_emit_by_name (start_click, "pressed", 1, 10.0, 10.0);
+    g_autoptr (NautilusWindowSlot) active1 = get_active_slot (window);
+    g_assert_true (active1 == first);
+    GtkWidget *focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_nonnull (focus);
+    g_assert_true (gtk_widget_is_ancestor (focus, GTK_WIDGET (first)));
+    g_assert_true (gtk_widget_has_css_class (start_box, "active-pane"));
+    g_assert_false (gtk_widget_has_css_class (start_box, "inactive-pane"));
+    g_assert_false (gtk_widget_has_css_class (end_box, "active-pane"));
+    g_assert_true (gtk_widget_has_css_class (end_box, "inactive-pane"));
+
+    /* Clicking the already active pane preserves its current focus. */
+    g_signal_emit_by_name (start_click, "pressed", 1, 12.0, 12.0);
+    g_autoptr (NautilusWindowSlot) active2 = get_active_slot (window);
+    g_assert_true (active2 == first);
+
+    /* Clicking the other pane switches back. */
+    g_signal_emit_by_name (end_click, "pressed", 1, 20.0, 20.0);
+    g_autoptr (NautilusWindowSlot) active3 = get_active_slot (window);
+    g_assert_true (active3 == second);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_nonnull (focus);
+    g_assert_true (gtk_widget_is_ancestor (focus, GTK_WIDGET (second)));
+    g_assert_false (gtk_widget_has_css_class (start_box, "active-pane"));
+    g_assert_true (gtk_widget_has_css_class (start_box, "inactive-pane"));
+    g_assert_true (gtk_widget_has_css_class (end_box, "active-pane"));
+    g_assert_false (gtk_widget_has_css_class (end_box, "inactive-pane"));
+
+    /* Case 4: Keyboard navigation switching does not fight stationary pointer */
+    gboolean handled = FALSE;
+    g_signal_emit_by_name (tab_key, "key-pressed", GDK_KEY_Tab, 0, 0, &handled);
+    g_assert_true (handled);
+    g_autoptr (NautilusWindowSlot) active4 = get_active_slot (window);
+    g_assert_true (active4 == first);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (gtk_widget_is_ancestor (focus, GTK_WIDGET (first)));
+
+    /* An explicit click leaves the shared location editor for the target pane. */
+    GtkWidget *toolbar = find_widget (GTK_WIDGET (window), NAUTILUS_TYPE_TOOLBAR);
+    g_assert_nonnull (toolbar);
+    g_assert_true (gtk_widget_activate_action (toolbar, "toolbar.edit-location", NULL));
+    GtkWidget *entry_focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_true (GTK_IS_EDITABLE (entry_focus));
+    g_signal_emit_by_name (end_click, "pressed", 1, 20.0, 20.0);
+    g_autoptr (NautilusWindowSlot) clicked = get_active_slot (window);
+    g_assert_true (clicked == second);
+    focus = gtk_root_get_focus (GTK_ROOT (window));
+    g_assert_nonnull (focus);
+    g_assert_true (gtk_widget_is_ancestor (focus, GTK_WIDGET (second)));
+
+    g_signal_emit_by_name (start_click, "pressed", 1, 10.0, 10.0);
+
+    /* Collapsing retains the clicked pane without split-only styling. */
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), "win.toggle-split", NULL));
+    g_assert_false (gtk_widget_has_css_class (start_box, "active-pane"));
+    g_assert_false (gtk_widget_has_css_class (start_box, "inactive-pane"));
+    g_assert_false (gtk_widget_has_css_class (start_box, "card"));
+    g_autoptr (NautilusWindowSlot) active10 = get_active_slot (window);
+    g_assert_true (active10 == first);
+
+    nautilus_window_close (window);
+    empty_directory_by_prefix (root, "");
+    g_rmdir (path);
+}
+
+int
+main (int argc, char *argv[])
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *config_dir = g_dir_make_tmp ("nautilus-pane-navigation-config-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_setenv ("XDG_CONFIG_HOME", config_dir, TRUE);
+    g_setenv ("XDG_DATA_HOME", config_dir, TRUE);
+    g_setenv ("XDG_CACHE_HOME", config_dir, TRUE);
+    g_test_init (&argc, &argv, NULL);
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+    test_init_config_dir ();
+    g_autoptr (NautilusTagManager) tag_manager = nautilus_tag_manager_new_dummy ();
+    g_autoptr (NautilusApplication) app = nautilus_application_new ();
+    g_application_set_application_id (G_APPLICATION (app), "org.gnome.Nautilus.TestPaneNavigation");
+    g_application_hold (G_APPLICATION (app));
+    g_assert_true (g_application_register (G_APPLICATION (app), NULL, &error));
+    g_assert_no_error (error);
+    g_test_add_func ("/window/contextual-pane-navigation", test_contextual_pane_navigation);
+    g_test_add_func ("/window/click-pane-activation", test_click_pane_activation);
+    int result = g_test_run ();
+    g_application_release (G_APPLICATION (app));
+    g_application_quit (G_APPLICATION (app));
+    g_clear_object (&app);
+    g_clear_object (&tag_manager);
+    g_autoptr (GFile) config = g_file_new_for_path (config_dir);
+    empty_directory_by_prefix (config, "");
+    g_rmdir (config_dir);
+    return result;
+}
diff --git a/test/display/test-window-tab.c b/test/display/test-window-tab.c
new file mode 100644
index 0000000..d7ff91c
--- /dev/null
+++ b/test/display/test-window-tab.c
@@ -0,0 +1,784 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include <nautilus-application.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-resources.h>
+#include <nautilus-tag-manager.h>
+#include <nautilus-toolbar.h>
+#include <nautilus-window.h>
+#include <nautilus-window-slot.h>
+#include <nautilus-window-tab.h>
+#include <test-utilities.h>
+
+#include <glib/gstdio.h>
+
+static NautilusWindowSlot *
+get_active_slot (NautilusWindow *window)
+{
+    NautilusWindowSlot *slot = NULL;
+
+    g_object_get (window, "active-slot", &slot, NULL);
+    return slot;
+}
+
+static void
+assert_active_slot (NautilusWindow     *window,
+                    NautilusWindowSlot *expected)
+{
+    g_autoptr (NautilusWindowSlot) active = get_active_slot (window);
+
+    g_assert_true (active == expected);
+}
+
+static gboolean
+count_focus_frame (GtkWidget     *widget,
+                   GdkFrameClock *clock,
+                   gpointer       data)
+{
+    (*(guint *) data)++;
+    return G_SOURCE_CONTINUE;
+}
+
+static void
+wait_for_focus_frames (NautilusWindow *window)
+{
+    guint frames = 0;
+    guint id = gtk_widget_add_tick_callback (GTK_WIDGET (window), count_focus_frame, &frames, NULL);
+    gint64 deadline = g_get_monotonic_time () + 5 * G_TIME_SPAN_SECOND;
+
+    while (frames < 2 && g_get_monotonic_time () < deadline)
+    {
+        g_main_context_iteration (NULL, FALSE);
+        g_usleep (1000);
+    }
+    gtk_widget_remove_tick_callback (GTK_WIDGET (window), id);
+    g_assert_cmpuint (frames, >=, 2);
+}
+
+static void
+wait_for_location (NautilusWindowSlot *slot,
+                   GFile              *location)
+{
+    gint64 deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+
+    while (g_get_monotonic_time () < deadline)
+    {
+        GFile *current = nautilus_window_slot_get_location (slot);
+
+        if (current != NULL && g_file_equal (current, location) &&
+            nautilus_window_slot_get_current_view (slot) != NULL &&
+            !nautilus_window_slot_get_loading (slot))
+        {
+            return;
+        }
+        while (g_main_context_iteration (NULL, FALSE))
+        {
+        }
+        g_usleep (1000);
+    }
+    GFile *current = nautilus_window_slot_get_location (slot);
+    g_error ("Timed out loading %s (current %s, loading %d)",
+             g_file_peek_path (location), current ? g_file_peek_path (current) : "none",
+             nautilus_window_slot_get_loading (slot));
+}
+
+static void
+activate (NautilusWindow *window,
+          const char     *action)
+{
+    g_assert_true (gtk_widget_activate_action (GTK_WIDGET (window), action, NULL));
+}
+
+static int
+allocate_tab (NautilusWindowTab *tab,
+              int                width)
+{
+    int minimum, natural;
+
+    gtk_widget_measure (GTK_WIDGET (tab), GTK_ORIENTATION_HORIZONTAL, -1,
+                        &minimum, &natural, NULL, NULL);
+    width = MAX (width, minimum);
+    gtk_widget_measure (GTK_WIDGET (tab), GTK_ORIENTATION_VERTICAL, width,
+                        &minimum, &natural, NULL, NULL);
+    gtk_widget_allocate (GTK_WIDGET (tab), width, 500, -1, NULL);
+    return width;
+}
+
+static void
+assert_split_resize (NautilusWindowTab *tab)
+{
+    const int widths[] = { 800, 660, 640, 620, 600, 360, 600, 620, 640, 660, 800, 1000 };
+    GtkWidget *first = GTK_WIDGET (nautilus_window_tab_get_slot (tab, 0));
+    GtkWidget *second = GTK_WIDGET (nautilus_window_tab_get_slot (tab, 1));
+
+    int tab_minimum, window_minimum;
+    gtk_widget_measure (GTK_WIDGET (tab), GTK_ORIENTATION_HORIZONTAL, -1,
+                        &tab_minimum, NULL, NULL, NULL);
+    gtk_widget_measure (GTK_WIDGET (gtk_widget_get_root (GTK_WIDGET (tab))),
+                        GTK_ORIENTATION_HORIZONTAL, -1, &window_minimum, NULL, NULL, NULL);
+    g_assert_cmpint (window_minimum, >=, tab_minimum);
+
+    allocate_tab (tab, 1000);
+    for (guint edge = 0; edge < 2; edge++)
+    {
+        nautilus_window_tab_set_position (tab, edge == 0 ? 0 : G_MAXINT);
+        allocate_tab (tab, 1000);
+        g_assert_cmpint (gtk_widget_get_width (first), >=, 180);
+        g_assert_cmpint (gtk_widget_get_width (second), >=, 180);
+        GtkWidget *frames[] = { gtk_widget_get_parent (first), gtk_widget_get_parent (second) };
+        GtkWidget *paned = gtk_widget_get_parent (frames[0]);
+
+        for (guint i = 0; i < G_N_ELEMENTS (frames); i++)
+        {
+            graphene_rect_t bounds;
+
+            g_assert_true (gtk_widget_compute_bounds (frames[i], paned, &bounds));
+            g_assert_cmpfloat (bounds.origin.x, >=, 0);
+            g_assert_cmpfloat (bounds.origin.x + bounds.size.width, <=, gtk_widget_get_width (paned));
+        }
+    }
+    nautilus_window_tab_set_position (tab, 350);
+    allocate_tab (tab, 1000);
+    int initial_first = gtk_widget_get_width (first);
+    allocate_tab (tab, 1400);
+    g_assert_cmpint (gtk_widget_get_width (first), >, initial_first + 100);
+    allocate_tab (tab, 1000);
+    g_assert_cmpint (ABS (gtk_widget_get_width (first) - initial_first), <=, 4);
+    int previous_width = 1000;
+    int previous_first = gtk_widget_get_width (first);
+
+    /* A user-chosen divider must not snap to halfway at the old breakpoint. */
+    for (guint i = 0; i < G_N_ELEMENTS (widths); i++)
+    {
+        int width = allocate_tab (tab, widths[i]);
+        int first_width = gtk_widget_get_width (first);
+        int second_width = gtk_widget_get_width (second);
+
+        g_assert_cmpint (first_width, >, 0);
+        g_assert_cmpint (second_width, >, 0);
+        g_assert_cmpint (first_width + second_width, <=, width);
+        g_assert_cmpint (gtk_widget_get_height (first), ==, gtk_widget_get_height (second));
+        g_assert_cmpint (ABS (first_width - previous_first), <=,
+                         ABS (width - previous_width) + 16);
+        previous_width = width;
+        previous_first = first_width;
+    }
+}
