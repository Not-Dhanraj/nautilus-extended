+static void
+test_tab_lifecycle_retained_and_repeated_dispose (void)
+{
+    g_autoptr (NautilusWindowSlot) slot0 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusWindowSlot) slot1 = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusWindowTab) tab = g_object_ref_sink (nautilus_window_tab_new (slot0));
+    nautilus_window_tab_add_secondary (tab, slot1);
+
+    g_autoptr (GtkWidget) paned = g_object_ref (adw_bin_get_child (ADW_BIN (tab)));
+    g_autoptr (GListModel) controllers = gtk_widget_observe_controllers (paned);
+    g_autoptr (GObject) retained_controller = NULL;
+    for (guint i = 0; i < g_list_model_get_n_items (controllers); i++)
+    {
+        g_autoptr (GObject) controller = g_list_model_get_item (controllers, i);
+
+        if (g_signal_handler_find (controller, G_SIGNAL_MATCH_DATA, 0, 0, NULL, NULL, tab) != 0)
+        {
+            retained_controller = g_steal_pointer (&controller);
+            break;
+        }
+    }
+    g_assert_nonnull (retained_controller);
+    g_assert_cmpuint (g_signal_handler_find (paned, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, tab), !=, 0);
+
+    g_object_run_dispose (G_OBJECT (tab));
+    g_assert_cmpuint (g_signal_handler_find (paned, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, tab), ==, 0);
+    g_assert_cmpuint (g_signal_handler_find (retained_controller, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, tab), ==, 0);
+    g_object_run_dispose (G_OBJECT (tab));
+    g_assert_cmpuint (g_signal_handler_find (paned, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, tab), ==, 0);
+
+}
