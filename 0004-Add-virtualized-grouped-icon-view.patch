--- /dev/null
+++ b/src/nautilus-grid-row-model.c
@@ -0,0 +1,438 @@
+/*
+ * Copyright (C) 2022 The GNOME project contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "nautilus-grid-row-model.h"
+
+typedef struct
+{
+    guint start_index;       /* Global file index in NautilusViewModel */
+    guint n_items;           /* Number of items in this row */
+    guint section_start_row; /* Index of first row in this section */
+    guint section_end_row;   /* One past last row in this section */
+    NautilusGridRow *item;
+} GridRowEntry;
+
+/* --- NautilusGridRow --- */
+
+struct _NautilusGridRow
+{
+    GObject parent_instance;
+
+    NautilusViewModel *model;
+    guint start_index;
+    guint n_items;
+    gboolean starts_section;
+};
+
+G_DEFINE_FINAL_TYPE (NautilusGridRow, nautilus_grid_row, G_TYPE_OBJECT)
+
+static void
+nautilus_grid_row_dispose (GObject *object)
+{
+    NautilusGridRow *self = NAUTILUS_GRID_ROW (object);
+
+    g_clear_object (&self->model);
+    G_OBJECT_CLASS (nautilus_grid_row_parent_class)->dispose (object);
+}
+
+static void
+nautilus_grid_row_class_init (NautilusGridRowClass *klass)
+{
+    G_OBJECT_CLASS (klass)->dispose = nautilus_grid_row_dispose;
+}
+
+static void
+nautilus_grid_row_init (NautilusGridRow *self)
+{
+}
+
+static NautilusGridRow *
+nautilus_grid_row_new (NautilusViewModel *model,
+                       guint              start_index,
+                       guint              n_items,
+                       gboolean           starts_section)
+{
+    NautilusGridRow *self = g_object_new (NAUTILUS_TYPE_GRID_ROW, NULL);
+
+    self->model = g_object_ref (model);
+    self->start_index = start_index;
+    self->n_items = n_items;
+    self->starts_section = starts_section;
+
+    return self;
+}
+
+guint
+nautilus_grid_row_get_start_index (NautilusGridRow *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW (self), 0);
+
+    return self->start_index;
+}
+
+guint
+nautilus_grid_row_get_n_items (NautilusGridRow *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW (self), 0);
+
+    return self->n_items;
+}
+
+gboolean
+nautilus_grid_row_get_starts_section (NautilusGridRow *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW (self), FALSE);
+
+    return self->starts_section;
+}
+
+GtkTreeListRow *
+nautilus_grid_row_get_first_row (NautilusGridRow *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW (self), NULL);
+
+    if (self->model == NULL || self->n_items == 0)
+    {
+        return NULL;
+    }
+
+    return GTK_TREE_LIST_ROW (g_list_model_get_item (G_LIST_MODEL (self->model), self->start_index));
+}
+
+/* --- NautilusGridRowModel --- */
+
+struct _NautilusGridRowModel
+{
+    GObject parent_instance;
+
+    NautilusViewModel *base_model;
+    GArray *rows; /* Array of GridRowEntry */
+    guint n_columns;
+};
+
+static void nautilus_grid_row_model_list_model_init (GListModelInterface *iface);
+static void nautilus_grid_row_model_section_model_init (GtkSectionModelInterface *iface);
+
+G_DEFINE_FINAL_TYPE_WITH_CODE (NautilusGridRowModel, nautilus_grid_row_model, G_TYPE_OBJECT,
+                         G_IMPLEMENT_INTERFACE (G_TYPE_LIST_MODEL,
+                                                nautilus_grid_row_model_list_model_init)
+                         G_IMPLEMENT_INTERFACE (GTK_TYPE_SECTION_MODEL,
+                                                nautilus_grid_row_model_section_model_init))
+
+static GType
+nautilus_grid_row_model_get_item_type (GListModel *list_model)
+{
+    return NAUTILUS_TYPE_GRID_ROW;
+}
+
+static guint
+nautilus_grid_row_model_get_n_items (GListModel *list_model)
+{
+    NautilusGridRowModel *self = NAUTILUS_GRID_ROW_MODEL (list_model);
+
+    return self->rows != NULL ? self->rows->len : 0;
+}
+
+static gpointer
+nautilus_grid_row_model_get_item (GListModel *list_model,
+                                  guint       position)
+{
+    NautilusGridRowModel *self = NAUTILUS_GRID_ROW_MODEL (list_model);
+
+    if (self->rows == NULL || position >= self->rows->len)
+    {
+        return NULL;
+    }
+
+    GridRowEntry *entry = &g_array_index (self->rows, GridRowEntry, position);
+
+    if (entry->item == NULL)
+    {
+        entry->item = nautilus_grid_row_new (self->base_model, entry->start_index, entry->n_items,
+                                             position == entry->section_start_row);
+    }
+    return g_object_ref (entry->item);
+}
+
+static void
+nautilus_grid_row_model_list_model_init (GListModelInterface *iface)
+{
+    iface->get_item_type = nautilus_grid_row_model_get_item_type;
+    iface->get_n_items = nautilus_grid_row_model_get_n_items;
+    iface->get_item = nautilus_grid_row_model_get_item;
+}
+
+static void
+nautilus_grid_row_model_get_section (GtkSectionModel *model,
+                                     guint            position,
+                                     guint           *out_start,
+                                     guint           *out_end)
+{
+    NautilusGridRowModel *self = NAUTILUS_GRID_ROW_MODEL (model);
+    guint n_rows = self->rows != NULL ? self->rows->len : 0;
+
+    if (position >= n_rows)
+    {
+        *out_start = n_rows;
+        *out_end = G_MAXUINT;
+        return;
+    }
+
+    GridRowEntry *entry = &g_array_index (self->rows, GridRowEntry, position);
+    *out_start = entry->section_start_row;
+    *out_end = entry->section_end_row;
+}
+
+static void
+nautilus_grid_row_model_section_model_init (GtkSectionModelInterface *iface)
+{
+    iface->get_section = nautilus_grid_row_model_get_section;
+}
+
+static void
+grid_row_entry_clear (gpointer data)
+{
+    GridRowEntry *entry = data;
+
+    g_clear_object (&entry->item);
+}
+
+static void
+nautilus_grid_row_model_rebuild (NautilusGridRowModel *self)
+{
+    guint old_n_rows = self->rows != NULL ? self->rows->len : 0;
+
+    if (self->rows == NULL)
+    {
+        self->rows = g_array_new (FALSE, FALSE, sizeof (GridRowEntry));
+        g_array_set_clear_func (self->rows, grid_row_entry_clear);
+    }
+    else
+    {
+        g_array_set_size (self->rows, 0);
+    }
+
+    if (self->base_model == NULL || self->n_columns == 0)
+    {
+        if (old_n_rows > 0)
+        {
+            g_list_model_items_changed (G_LIST_MODEL (self), 0, old_n_rows, 0);
+        }
+        return;
+    }
+
+    guint total_items = g_list_model_get_n_items (G_LIST_MODEL (self->base_model));
+    guint pos = 0;
+
+    while (pos < total_items)
+    {
+        guint sec_start = pos;
+        guint sec_end = total_items;
+
+        gtk_section_model_get_section (GTK_SECTION_MODEL (self->base_model), pos, &sec_start, &sec_end);
+        sec_end = MIN (sec_end, total_items);
+
+        if (sec_end <= pos || sec_start > pos)
+        {
+            sec_start = pos;
+            sec_end = total_items;
+        }
+
+        guint sec_n_items = sec_end - sec_start;
+        guint sec_n_rows = (sec_n_items + self->n_columns - 1) / self->n_columns;
+        guint current_row_start = self->rows->len;
+        guint current_row_end = current_row_start + sec_n_rows;
+
+        for (guint r = 0; r < sec_n_rows; r++)
+        {
+            GridRowEntry entry = { 0 };
+            entry.start_index = sec_start + r * self->n_columns;
+            entry.n_items = MIN (self->n_columns, sec_end - entry.start_index);
+            entry.section_start_row = current_row_start;
+            entry.section_end_row = current_row_end;
+            g_array_append_val (self->rows, entry);
+        }
+
+        pos = sec_end;
+    }
+
+    guint new_n_rows = self->rows->len;
+    g_list_model_items_changed (G_LIST_MODEL (self), 0, old_n_rows, new_n_rows);
+    if (new_n_rows > 0)
+    {
+        gtk_section_model_sections_changed (GTK_SECTION_MODEL (self), 0, new_n_rows);
+    }
+}
+
+static void
+on_base_model_changed (NautilusGridRowModel *self)
+{
+    nautilus_grid_row_model_rebuild (self);
+}
+
+static void
+nautilus_grid_row_model_dispose (GObject *object)
+{
+    NautilusGridRowModel *self = NAUTILUS_GRID_ROW_MODEL (object);
+
+    if (self->base_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_func (self->base_model, on_base_model_changed, self);
+        g_clear_object (&self->base_model);
+    }
+
+    if (self->rows != NULL)
+    {
+        g_array_free (self->rows, TRUE);
+        self->rows = NULL;
+    }
+
+    G_OBJECT_CLASS (nautilus_grid_row_model_parent_class)->dispose (object);
+}
+
+static void
+nautilus_grid_row_model_class_init (NautilusGridRowModelClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    object_class->dispose = nautilus_grid_row_model_dispose;
+}
+
+static void
+nautilus_grid_row_model_init (NautilusGridRowModel *self)
+{
+    self->n_columns = 4;
+}
+
+NautilusGridRowModel *
+nautilus_grid_row_model_new (void)
+{
+    return g_object_new (NAUTILUS_TYPE_GRID_ROW_MODEL, NULL);
+}
+
+void
+nautilus_grid_row_model_set_base_model (NautilusGridRowModel *self,
+                                        NautilusViewModel    *base_model)
+{
+    g_return_if_fail (NAUTILUS_IS_GRID_ROW_MODEL (self));
+    g_return_if_fail (base_model == NULL || NAUTILUS_IS_VIEW_MODEL (base_model));
+
+    if (self->base_model == base_model)
+    {
+        return;
+    }
+
+    if (self->base_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_func (self->base_model, on_base_model_changed, self);
+        g_clear_object (&self->base_model);
+    }
+
+    if (base_model != NULL)
+    {
+        self->base_model = g_object_ref (base_model);
+        g_signal_connect_swapped (self->base_model, "items-changed",
+                                  G_CALLBACK (on_base_model_changed), self);
+        g_signal_connect_swapped (self->base_model, "sections-changed",
+                                  G_CALLBACK (on_base_model_changed), self);
+    }
+
+    nautilus_grid_row_model_rebuild (self);
+}
+
+void
+nautilus_grid_row_model_set_n_columns (NautilusGridRowModel *self,
+                                       guint                 n_columns)
+{
+    g_return_if_fail (NAUTILUS_IS_GRID_ROW_MODEL (self));
+
+    if (self->n_columns == n_columns || n_columns == 0)
+    {
+        return;
+    }
+
+    self->n_columns = n_columns;
+    nautilus_grid_row_model_rebuild (self);
+}
+
+gboolean
+nautilus_grid_row_model_get_coords (NautilusGridRowModel *self,
+                                    guint                 pos,
+                                    guint                *out_row,
+                                    guint                *out_col)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW_MODEL (self), FALSE);
+
+    if (self->rows == NULL || self->rows->len == 0)
+    {
+        return FALSE;
+    }
+
+    guint low = 0;
+    guint high = self->rows->len - 1;
+
+    while (low <= high)
+    {
+        guint mid = low + (high - low) / 2;
+        GridRowEntry *entry = &g_array_index (self->rows, GridRowEntry, mid);
+
+        if (pos >= entry->start_index && pos < entry->start_index + entry->n_items)
+        {
+            if (out_row != NULL)
+            {
+                *out_row = mid;
+            }
+            if (out_col != NULL)
+            {
+                *out_col = pos - entry->start_index;
+            }
+            return TRUE;
+        }
+        else if (pos < entry->start_index)
+        {
+            if (mid == 0)
+            {
+                break;
+            }
+            high = mid - 1;
+        }
+        else
+        {
+            low = mid + 1;
+        }
+    }
+
+    return FALSE;
+}
+
+gint
+nautilus_grid_row_model_get_position_at (NautilusGridRowModel *self,
+                                         guint                 row,
+                                         guint                 col)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW_MODEL (self), -1);
+
+    if (self->rows == NULL || row >= self->rows->len)
+    {
+        return -1;
+    }
+
+    GridRowEntry *entry = &g_array_index (self->rows, GridRowEntry, row);
+    if (col >= entry->n_items)
+    {
+        col = entry->n_items > 0 ? entry->n_items - 1 : 0;
+    }
+
+    return (gint) (entry->start_index + col);
+}
+
+guint
+nautilus_grid_row_model_get_n_rows (NautilusGridRowModel *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GRID_ROW_MODEL (self), 0);
+
+    return self->rows != NULL ? self->rows->len : 0;
+}
