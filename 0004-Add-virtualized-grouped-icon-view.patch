+void                  nautilus_grid_row_model_set_base_model  (NautilusGridRowModel *self,
+                                                               NautilusViewModel    *base_model);
+void                  nautilus_grid_row_model_set_n_columns   (NautilusGridRowModel *self,
+                                                               guint                 n_columns);
+gboolean              nautilus_grid_row_model_get_coords      (NautilusGridRowModel *self,
