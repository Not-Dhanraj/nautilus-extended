+static guint
+get_icon_size_for_zoom_level (NautilusGridZoomLevel zoom_level)
+{
+    switch (zoom_level)
+    {
+        case NAUTILUS_GRID_ZOOM_LEVEL_SMALL:
+        {
+            return NAUTILUS_GRID_ICON_SIZE_SMALL;
+        }
+        break;
