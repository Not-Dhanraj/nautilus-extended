+        case NAUTILUS_GRID_ZOOM_LEVEL_SMALL_PLUS:
+        {
+            return NAUTILUS_GRID_ICON_SIZE_SMALL_PLUS;
+        }
+        break;
+
+        case NAUTILUS_GRID_ZOOM_LEVEL_MEDIUM:
+        {
+            return NAUTILUS_GRID_ICON_SIZE_MEDIUM;
+        }
+        break;
+
+        case NAUTILUS_GRID_ZOOM_LEVEL_LARGE:
