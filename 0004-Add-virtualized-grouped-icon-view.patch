+/* NautilusGridRow accessors */
+guint              nautilus_grid_row_get_start_index    (NautilusGridRow *self);
+guint              nautilus_grid_row_get_n_items        (NautilusGridRow *self);
+gboolean           nautilus_grid_row_get_starts_section (NautilusGridRow *self);
+GtkTreeListRow    *nautilus_grid_row_get_first_row      (NautilusGridRow *self);
+
+/* NautilusGridRowModel methods */
