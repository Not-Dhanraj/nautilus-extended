+static void
+update_columns_for_width (NautilusGridView *self,
+                          int               width)
+{
+    if (width <= 0)
+    {
+        return;
+    }
+
+    guint icon_size = get_icon_size_for_zoom_level (self->zoom_level);
+    /* Width of a cell: EMBLEMS_BOX_WIDTH (18) * 2 + icon_size + 12px cell padding = icon_size + 48 */
+    int cell_width = 36 + (int) icon_size + 12;
+    int slot_width = cell_width + 12; /* Horizontal spacing */
+    int available = width - 36;        /* View padding */
+    int columns = available > 0 ? (available / slot_width) : 1;
+
+    columns = CLAMP (columns, 1, 20);
+
+    if ((guint) columns != self->n_columns)
+    {
+        self->n_columns = (guint) columns;
+        if (self->grouped_grid != NULL)
+        {
+            nautilus_grouped_grid_set_n_columns (self->grouped_grid, self->n_columns);
+        }
+    }
+}
