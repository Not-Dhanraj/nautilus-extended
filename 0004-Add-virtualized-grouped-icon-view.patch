+static guint
+get_first_selected_position (NautilusGroupedGrid *self)
+{
+    if (self->view == NULL)
+    {
+        return GTK_INVALID_LIST_POSITION;
+    }
+
+    NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+    if (model == NULL)
+    {
+        return GTK_INVALID_LIST_POSITION;
+    }
+
+    g_autoptr (GtkBitset) selection = gtk_selection_model_get_selection (GTK_SELECTION_MODEL (model));
+    if (gtk_bitset_is_empty (selection))
+    {
+        return GTK_INVALID_LIST_POSITION;
+    }
+
+    return gtk_bitset_get_minimum (selection);
+}
+
+static gboolean
+grouped_grid_handle_key (NautilusGroupedGrid *self,
+                         guint                keyval,
+                         GdkModifierType      state)
+{
+    if (self->view == NULL)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    if (nautilus_list_base_get_grouping_mode (self->view) == NAUTILUS_GROUPING_NONE)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+    if (model == NULL || self->row_model == NULL)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    guint total_items = g_list_model_get_n_items (G_LIST_MODEL (model));
+    if (total_items == 0)
+    {
+        return GDK_EVENT_PROPAGATE;
+    }
+
+    gboolean shift = (state & GDK_SHIFT_MASK) != 0;
+    gboolean ctrl = (state & GDK_CONTROL_MASK) != 0;
+    gboolean rtl = gtk_widget_get_direction (GTK_WIDGET (self->view)) == GTK_TEXT_DIR_RTL;
+
+    if (rtl && (keyval == GDK_KEY_Left || keyval == GDK_KEY_Right))
+    {
+        keyval = keyval == GDK_KEY_Left ? GDK_KEY_Right : GDK_KEY_Left;
+    }
+
+    /* Handle Enter to activate selection */
+    if (keyval == GDK_KEY_Return || keyval == GDK_KEY_KP_Enter)
+    {
+        nautilus_list_base_activate_selection (self->view, ctrl);
+        return GDK_EVENT_STOP;
+    }
+
+    /* Find current position */
+    guint current_pos = self->cursor_position;
+    if (current_pos >= total_items)
+    {
+        current_pos = get_first_selected_position (self);
+        if (current_pos >= total_items)
+        {
+            current_pos = 0;
+        }
+    }
+
+    guint cur_row = 0;
+    guint cur_col = 0;
+    nautilus_grid_row_model_get_coords (self->row_model, current_pos, &cur_row, &cur_col);
+    guint total_rows = nautilus_grid_row_model_get_n_rows (self->row_model);
+
+    gint target_pos = -1;
+
+    switch (keyval)
+    {
+        case GDK_KEY_Left:
+        case GDK_KEY_KP_Left:
+        {
+            if (current_pos > 0)
+            {
+                target_pos = current_pos - 1;
+            }
+            else
+            {
+                target_pos = 0;
+            }
+        }
+        break;
+
+        case GDK_KEY_Right:
+        case GDK_KEY_KP_Right:
+        {
+            if (current_pos + 1 < total_items)
+            {
+                target_pos = current_pos + 1;
+            }
+            else
+            {
+                target_pos = total_items - 1;
+            }
+        }
+        break;
+
+        case GDK_KEY_Up:
+        case GDK_KEY_KP_Up:
+        {
+            if (cur_row > 0)
+            {
+                target_pos = nautilus_grid_row_model_get_position_at (self->row_model, cur_row - 1, cur_col);
+            }
+            else
+            {
+                target_pos = current_pos;
+            }
+        }
+        break;
+
+        case GDK_KEY_Down:
+        case GDK_KEY_KP_Down:
+        {
+            if (cur_row + 1 < total_rows)
+            {
+                target_pos = nautilus_grid_row_model_get_position_at (self->row_model, cur_row + 1, cur_col);
+            }
+            else
+            {
+                target_pos = current_pos;
+            }
+        }
+        break;
+
+        case GDK_KEY_Page_Up:
+        case GDK_KEY_KP_Page_Up:
+        case GDK_KEY_Page_Down:
+        case GDK_KEY_KP_Page_Down:
+        {
+            GtkWidget *slot = g_hash_table_lookup (self->bound_slots, GUINT_TO_POINTER (current_pos));
+            guint row_height = slot != NULL ? (guint) gtk_widget_get_height (slot) : get_icon_size_for_zoom_level (self->zoom_level) + 64;
+            guint page_rows = MAX (1, gtk_widget_get_height (GTK_WIDGET (self->grouped_view_ui)) / MAX (1, row_height + 6));
+            gboolean up = keyval == GDK_KEY_Page_Up || keyval == GDK_KEY_KP_Page_Up;
+            guint target_row = up ? cur_row - MIN (cur_row, page_rows) : MIN (total_rows - 1, cur_row + page_rows);
+
+            target_pos = nautilus_grid_row_model_get_position_at (self->row_model, target_row, cur_col);
+        }
+        break;
+
+        case GDK_KEY_Home:
+        case GDK_KEY_KP_Home:
+        {
+            target_pos = 0;
+        }
+        break;
+
+        case GDK_KEY_End:
+        case GDK_KEY_KP_End:
+        {
+            target_pos = total_items - 1;
+        }
+        break;
+
+        case GDK_KEY_space:
+        case GDK_KEY_KP_Space:
+        {
+            if (ctrl)
+            {
+                gboolean sel = gtk_selection_model_is_selected (GTK_SELECTION_MODEL (model), current_pos);
+                if (sel)
+                {
+                    gtk_selection_model_unselect_item (GTK_SELECTION_MODEL (model), current_pos);
+                }
+                else
+                {
+                    gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), current_pos, FALSE);
+                }
+                return GDK_EVENT_STOP;
+            }
+        }
+        break;
+
+        default:
+            return GDK_EVENT_PROPAGATE;
+    }
+
+    if (target_pos >= 0 && (guint) target_pos < total_items)
+    {
+        guint pos = (guint) target_pos;
+        guint saved_anchor = self->anchor_position;
+
+        if (shift)
+        {
+            guint anchor = (self->anchor_position < total_items) ? self->anchor_position : current_pos;
+            guint start = MIN (anchor, pos);
+            guint n = ABS ((gint) pos - (gint) anchor) + 1;
+            gtk_selection_model_select_range (GTK_SELECTION_MODEL (model), start, n, !ctrl);
+        }
+        else if (!ctrl)
+        {
+            gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), pos, TRUE);
+            self->anchor_position = pos;
+        }
+        else
+        {
+            self->anchor_position = pos;
+        }
+
+        nautilus_grouped_grid_scroll_to (self, pos, GTK_LIST_SCROLL_FOCUS, NULL);
+        if (shift)
+        {
+            self->anchor_position = saved_anchor < total_items ? saved_anchor : current_pos;
+        }
+        return GDK_EVENT_STOP;
+    }
+
+    return GDK_EVENT_PROPAGATE;
+}
+
+static gboolean
+on_grouped_view_key_pressed (GtkEventControllerKey *controller,
+                             guint                  keyval,
+                             guint                  keycode,
+                             GdkModifierType        state,
+                             gpointer               user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    return grouped_grid_handle_key (self, keyval, state);
+}
+
+static void
+update_slot_selection (GtkWidget *slot,
+                       gboolean   selected)
+{
+    if (selected)
+    {
+        gtk_widget_set_state_flags (slot, GTK_STATE_FLAG_SELECTED, FALSE);
+        gtk_widget_add_css_class (slot, "selected");
+    }
+    else
+    {
+        gtk_widget_unset_state_flags (slot, GTK_STATE_FLAG_SELECTED);
+        gtk_widget_remove_css_class (slot, "selected");
+    }
+}
+
+static void
+on_model_selection_changed (GtkSelectionModel *model,
+                            guint              position,
+                            guint              n_items,
+                            gpointer           user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    if (self->bound_slots == NULL)
+    {
+        return;
+    }
+
+    if (n_items == 1)
+    {
+        GtkWidget *slot = g_hash_table_lookup (self->bound_slots, GUINT_TO_POINTER (position));
+        if (slot != NULL)
+        {
+            gboolean sel = gtk_selection_model_is_selected (model, position);
+            update_slot_selection (slot, sel);
+        }
+    }
+    else
+    {
+        GHashTableIter iter;
+        gpointer key, value;
+        g_hash_table_iter_init (&iter, self->bound_slots);
+        while (g_hash_table_iter_next (&iter, &key, &value))
+        {
+            guint pos = GPOINTER_TO_UINT (key);
+            if (pos >= position && pos < position + n_items)
+            {
+                gboolean sel = gtk_selection_model_is_selected (model, pos);
+                update_slot_selection (GTK_WIDGET (value), sel);
+            }
+        }
+    }
+}
+
+static void
+on_model_items_changed (GListModel          *model,
+                        guint                position,
+                        guint                removed,
+                        guint                added,
+                        NautilusGroupedGrid *self)
+{
+    /* Selection follows file identity through a sort; cached indices do not. */
+    self->cursor_position = GTK_INVALID_LIST_POSITION;
+    self->anchor_position = GTK_INVALID_LIST_POSITION;
+    self->defer_unselect_other = FALSE;
+}
+
+static void
+on_cell_click_pressed (GtkGestureClick *gesture,
+                       gint             n_press,
+                       gdouble          x,
+                       gdouble          y,
+                       gpointer         user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+    NautilusGridCell *cell = NAUTILUS_GRID_CELL (gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture)));
+    guint button = gtk_gesture_single_get_current_button (GTK_GESTURE_SINGLE (gesture));
+
+    if (button != GDK_BUTTON_PRIMARY || n_press != 1)
+    {
+        return;
+    }
+
+    guint pos = nautilus_view_cell_get_position (NAUTILUS_VIEW_CELL (cell));
+    if (pos == GTK_INVALID_LIST_POSITION)
+    {
+        return;
+    }
+
+    if (self->view == NULL)
+    {
+        return;
+    }
+
+    NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+    if (model == NULL)
+    {
+        return;
+    }
+
+    GdkModifierType modifiers = gtk_event_controller_get_current_event_state (GTK_EVENT_CONTROLLER (gesture));
+    gboolean ctrl = (modifiers & GDK_CONTROL_MASK) != 0;
+    gboolean shift = (modifiers & GDK_SHIFT_MASK) != 0;
+
+    self->cursor_position = pos;
+    gtk_widget_grab_focus (GTK_WIDGET (self->view));
+
+    if (ctrl && !shift)
+    {
+        gboolean selected = gtk_selection_model_is_selected (GTK_SELECTION_MODEL (model), pos);
+        if (selected)
+        {
+            gtk_selection_model_unselect_item (GTK_SELECTION_MODEL (model), pos);
+        }
+        else
+        {
+            gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), pos, FALSE);
+        }
+        self->anchor_position = pos;
+    }
+    else if (shift)
+    {
+        guint anchor = (self->anchor_position != GTK_INVALID_LIST_POSITION) ? self->anchor_position : pos;
+        guint start = MIN (anchor, pos);
+        guint n = ABS ((gint) pos - (gint) anchor) + 1;
+        gtk_selection_model_select_range (GTK_SELECTION_MODEL (model), start, n, !ctrl);
+    }
+    else
+    {
+        gboolean selected = gtk_selection_model_is_selected (GTK_SELECTION_MODEL (model), pos);
+        if (!selected)
+        {
+            gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), pos, TRUE);
+            self->anchor_position = pos;
+        }
+        else
+        {
+            self->defer_unselect_other = TRUE;
+            self->defer_unselect_pos = pos;
+        }
+    }
+}
+
+static void
+on_cell_click_released (GtkGestureClick *gesture,
+                        gint             n_press,
+                        gdouble          x,
+                        gdouble          y,
+                        gpointer         user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+    NautilusGridCell *cell = NAUTILUS_GRID_CELL (gtk_event_controller_get_widget (GTK_EVENT_CONTROLLER (gesture)));
+    guint button = gtk_gesture_single_get_current_button (GTK_GESTURE_SINGLE (gesture));
+
+    if (button == GDK_BUTTON_PRIMARY && self->defer_unselect_other)
+    {
+        guint pos = nautilus_view_cell_get_position (NAUTILUS_VIEW_CELL (cell));
+        if (pos == self->defer_unselect_pos && self->view != NULL)
+        {
+            NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+            if (model != NULL)
+            {
+                gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), pos, TRUE);
+                self->anchor_position = pos;
+                self->cursor_position = pos;
+            }
+        }
+        self->defer_unselect_other = FALSE;
+    }
+}
+
+static void
+on_cell_click_stopped (GtkGestureClick *gesture,
+                       gpointer         user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    self->defer_unselect_other = FALSE;
+}
+
+static GtkWidget *
+create_slot (NautilusGroupedGrid *self)
+{
+    GtkWidget *slot = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    gtk_widget_add_css_class (slot, "grouped-grid-cell");
+    gtk_widget_set_halign (slot, GTK_ALIGN_CENTER);
+    gtk_widget_set_valign (slot, GTK_ALIGN_START);
+
+    NautilusGridCell *cell = nautilus_grid_cell_new (self->view);
+    setup_cell_gestures (NAUTILUS_VIEW_CELL (cell));
+    setup_cell_hover (NAUTILUS_VIEW_CELL (cell));
+
+    if (self->view != NULL)
+    {
+        g_object_bind_property (self->view, "icon-size",
+                                cell, "icon-size",
+                                G_BINDING_SYNC_CREATE);
+    }
+
+    nautilus_grid_cell_set_caption_attributes (cell, self->caption_attributes);
+
+    GtkEventController *click = GTK_EVENT_CONTROLLER (gtk_gesture_click_new ());
+    gtk_widget_add_controller (GTK_WIDGET (cell), click);
+    gtk_event_controller_set_propagation_phase (click, GTK_PHASE_BUBBLE);
+    gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (click), GDK_BUTTON_PRIMARY);
+    g_signal_connect_object (click, "pressed", G_CALLBACK (on_cell_click_pressed), self, 0);
+    g_signal_connect_object (click, "released", G_CALLBACK (on_cell_click_released), self, 0);
+    g_signal_connect_object (click, "stopped", G_CALLBACK (on_cell_click_stopped), self, 0);
+
+    gtk_box_append (GTK_BOX (slot), GTK_WIDGET (cell));
+
+    return slot;
+}
+
+static void
+setup_row_item (GtkSignalListItemFactory *factory,
+                GtkListItem              *listitem,
+                gpointer                  user_data)
+{
+    GtkWidget *container = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+    GtkWidget *row_box = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+
+    gtk_box_set_homogeneous (GTK_BOX (row_box), TRUE);
+    gtk_widget_add_css_class (row_box, "grouped-grid-row");
+    /* Include the heading in its first layout row so scrolling to that row
+     * also reveals its heading, rather than anchoring below a separate header. */
+    gtk_box_append (GTK_BOX (container), row_box);
+    gtk_list_item_set_child (listitem, container);
+    gtk_list_item_set_activatable (listitem, FALSE);
+    gtk_list_item_set_selectable (listitem, FALSE);
+    gtk_list_item_set_focusable (listitem, FALSE);
+}
+
+static void
+bind_row_item (GtkSignalListItemFactory *factory,
+               GtkListItem              *listitem,
+               gpointer                  user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    if (self->view == NULL)
+    {
+        return;
+    }
+
+    NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+    NautilusGridRow *row = NAUTILUS_GRID_ROW (gtk_list_item_get_item (listitem));
+    GtkWidget *container = gtk_list_item_get_child (listitem);
+    GtkWidget *row_box = container != NULL ? gtk_widget_get_last_child (container) : NULL;
+
+    if (row == NULL || model == NULL || row_box == NULL)
+    {
+        return;
+    }
+
+    gboolean starts_section = nautilus_grid_row_get_starts_section (row);
+    guint start_index = nautilus_grid_row_get_start_index (row);
+    guint n_items = nautilus_grid_row_get_n_items (row);
+
+    GtkWidget *header = gtk_widget_get_first_child (container);
+    if (starts_section && header == row_box)
+    {
+        header = nautilus_list_base_create_group_header_widget ();
+        gtk_box_prepend (GTK_BOX (container), header);
+    }
+    if (header != row_box)
+    {
+        gtk_widget_set_visible (header, starts_section);
+        if (starts_section)
+        {
+            g_autoptr (GtkTreeListRow) first = nautilus_grid_row_get_first_row (row);
+            gboolean is_first_section = (start_index == 0);
+
+            nautilus_list_base_bind_group_header_widget (header, self->view, first, is_first_section);
+        }
+        else
+        {
+            nautilus_list_base_unbind_group_header_widget (header);
+        }
+    }
+
+    guint n_children = 0;
+    for (GtkWidget *child = gtk_widget_get_first_child (row_box);
+         child != NULL;
+         child = gtk_widget_get_next_sibling (child))
+    {
+        n_children++;
+    }
+
+    while (n_children < self->n_columns)
+    {
+        GtkWidget *slot = create_slot (self);
+        gtk_box_append (GTK_BOX (row_box), slot);
+        n_children++;
+    }
+
+    guint col = 0;
+    for (GtkWidget *slot = gtk_widget_get_first_child (row_box);
+         slot != NULL;
+         slot = gtk_widget_get_next_sibling (slot), col++)
+    {
+        GtkWidget *cell = gtk_widget_get_first_child (slot);
+
+        if (col < n_items)
+        {
+            guint global_pos = start_index + col;
+            g_autoptr (GtkTreeListRow) tree_row = g_list_model_get_item (G_LIST_MODEL (model), global_pos);
+
+            if (tree_row != NULL)
+            {
+                g_autoptr (NautilusViewItem) view_item = NAUTILUS_VIEW_ITEM (gtk_tree_list_row_get_item (tree_row));
+
+                if (view_item != NULL)
+                {
+                    nautilus_view_cell_set_item (NAUTILUS_VIEW_CELL (cell), view_item);
+                    g_object_set (cell, "position", global_pos, NULL);
+                    nautilus_view_item_set_item_ui (view_item, cell);
+
+                    NautilusFile *file = nautilus_view_item_get_file (view_item);
+                    if (file != NULL)
+                    {
+                        gtk_accessible_update_property (GTK_ACCESSIBLE (slot),
+                                                        GTK_ACCESSIBLE_PROPERTY_LABEL,
+                                                        nautilus_file_get_display_name (file),
+                                                        -1);
+                    }
+                }
+            }
+
+            gboolean is_selected = gtk_selection_model_is_selected (GTK_SELECTION_MODEL (model), global_pos);
+            update_slot_selection (slot, is_selected);
+            gtk_widget_set_visible (cell, TRUE);
+            gtk_widget_set_visible (slot, TRUE);
+
+            g_hash_table_insert (self->bound_slots, GUINT_TO_POINTER (global_pos), slot);
+        }
+        else if (col < self->n_columns)
+        {
+            gtk_widget_set_visible (cell, FALSE);
+            update_slot_selection (slot, FALSE);
+            gtk_widget_set_visible (slot, TRUE);
+        }
+        else
+        {
+            gtk_widget_set_visible (cell, FALSE);
+            update_slot_selection (slot, FALSE);
+            gtk_widget_set_visible (slot, FALSE);
+        }
+    }
+}
+
+static void
+unbind_row_item (GtkSignalListItemFactory *factory,
+                 GtkListItem              *listitem,
+                 gpointer                  user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+    GtkWidget *container = gtk_list_item_get_child (listitem);
+    GtkWidget *row_box = container != NULL ? gtk_widget_get_last_child (container) : NULL;
+
+    if (row_box == NULL)
+    {
+        return;
+    }
+
+    GtkWidget *header = gtk_widget_get_first_child (container);
+    if (header != row_box)
+    {
+        nautilus_list_base_unbind_group_header_widget (header);
+    }
+
+    for (GtkWidget *slot = gtk_widget_get_first_child (row_box);
+         slot != NULL;
+         slot = gtk_widget_get_next_sibling (slot))
+    {
+        GtkWidget *cell = gtk_widget_get_first_child (slot);
+        if (cell != NULL)
+        {
+            guint pos = nautilus_view_cell_get_position (NAUTILUS_VIEW_CELL (cell));
+            if (pos != GTK_INVALID_LIST_POSITION && self->bound_slots != NULL &&
+                g_hash_table_lookup (self->bound_slots, GUINT_TO_POINTER (pos)) == slot)
+            {
+                g_hash_table_remove (self->bound_slots, GUINT_TO_POINTER (pos));
+            }
+
+            g_autoptr (NautilusViewItem) item = nautilus_view_cell_get_item (NAUTILUS_VIEW_CELL (cell));
+            if (item != NULL)
+            {
+                if (nautilus_view_item_get_item_ui (item) == cell)
+                {
+                    nautilus_view_item_set_item_ui (item, NULL);
+                }
+                nautilus_view_cell_set_item (NAUTILUS_VIEW_CELL (cell), NULL);
+            }
+            g_object_set (cell, "position", GTK_INVALID_LIST_POSITION, NULL);
+            update_slot_selection (slot, FALSE);
+        }
+    }
+}
+
+/* --- Rubberband Callbacks --- */
+
+static void
+on_drag_begin (GtkGestureDrag *gesture,
+               gdouble         start_x,
+               gdouble         start_y,
+               gpointer        user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    if (!self->rubberband_enabled || self->view == NULL)
+    {
+        gtk_gesture_set_state (GTK_GESTURE (gesture), GTK_EVENT_SEQUENCE_DENIED);
+        return;
+    }
+
+    self->drag_start_x = start_x;
+    self->drag_start_y = start_y;
+
+    NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+    if (model == NULL)
+    {
+        return;
+    }
+
+    GdkModifierType modifiers = gtk_event_controller_get_current_event_state (GTK_EVENT_CONTROLLER (gesture));
+    gboolean selection_mode = (modifiers & (GDK_CONTROL_MASK | GDK_SHIFT_MASK)) != 0;
+
+    g_clear_pointer (&self->drag_initial_selection, gtk_bitset_unref);
+    g_clear_pointer (&self->drag_work_selection, gtk_bitset_unref);
+    g_clear_pointer (&self->drag_mask, gtk_bitset_unref);
+    self->drag_initial_selection = selection_mode
+                                   ? gtk_selection_model_get_selection (GTK_SELECTION_MODEL (model))
+                                   : gtk_bitset_new_empty ();
+    self->drag_work_selection = gtk_bitset_new_empty ();
+    self->drag_mask = gtk_bitset_new_range (0, g_list_model_get_n_items (G_LIST_MODEL (model)));
+    self->drag_toggle = (modifiers & GDK_CONTROL_MASK) != 0;
+
+    if (!selection_mode)
+    {
+        gtk_selection_model_unselect_all (GTK_SELECTION_MODEL (model));
+    }
+}
+
+static void
+on_drag_update (GtkGestureDrag *gesture,
+                gdouble         offset_x,
+                gdouble         offset_y,
+                gpointer        user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    if (!self->rubberband_enabled || self->grouped_view_ui == NULL || self->view == NULL)
+    {
+        return;
+    }
+
+    NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+    if (model == NULL || self->bound_slots == NULL || self->drag_initial_selection == NULL)
+    {
+        return;
+    }
+
+    double rx = MIN (self->drag_start_x, self->drag_start_x + offset_x);
+    double ry = MIN (self->drag_start_y, self->drag_start_y + offset_y);
+    double rw = ABS (offset_x);
+    double rh = ABS (offset_y);
+    graphene_rect_t rub_rect = GRAPHENE_RECT_INIT ((float) rx, (float) ry, (float) rw, (float) rh);
+
+    if (self->rubberband_widget != NULL)
+    {
+        graphene_point_t p1, p2;
+        if (gtk_widget_compute_point (GTK_WIDGET (self->grouped_view_ui),
+                                      GTK_WIDGET (self->view),
+                                      &GRAPHENE_POINT_INIT ((float) self->drag_start_x, (float) self->drag_start_y),
+                                      &p1) &&
+            gtk_widget_compute_point (GTK_WIDGET (self->grouped_view_ui),
+                                      GTK_WIDGET (self->view),
+                                      &GRAPHENE_POINT_INIT ((float) (self->drag_start_x + offset_x), (float) (self->drag_start_y + offset_y)),
+                                      &p2))
+        {
+            float ox = MIN (p1.x, p2.x);
+            float oy = MIN (p1.y, p2.y);
+            float ow = ABS (p2.x - p1.x);
+            float oh = ABS (p2.y - p1.y);
+
+            gtk_widget_set_margin_start (self->rubberband_widget, (int) ox);
+            gtk_widget_set_margin_top (self->rubberband_widget, (int) oy);
+            gtk_widget_set_size_request (self->rubberband_widget, (int) ow, (int) oh);
+            gtk_widget_set_visible (self->rubberband_widget, TRUE);
+        }
+    }
+
+    gtk_bitset_remove_all (self->drag_work_selection);
+    gtk_bitset_union (self->drag_work_selection, self->drag_initial_selection);
+
+    GHashTableIter iter;
+    gpointer key, value;
+    g_hash_table_iter_init (&iter, self->bound_slots);
+    while (g_hash_table_iter_next (&iter, &key, &value))
+    {
+        guint pos = GPOINTER_TO_UINT (key);
+        GtkWidget *slot = GTK_WIDGET (value);
+
+        graphene_point_t p;
+        if (gtk_widget_compute_point (slot, GTK_WIDGET (self->grouped_view_ui),
+                                      &GRAPHENE_POINT_INIT (0, 0), &p))
+        {
+            graphene_rect_t cell_rect = GRAPHENE_RECT_INIT (p.x, p.y,
+                                                           (float) gtk_widget_get_width (slot),
+                                                           (float) gtk_widget_get_height (slot));
+
+            if (graphene_rect_intersection (&rub_rect, &cell_rect, NULL))
+            {
+                if (self->drag_toggle && gtk_bitset_contains (self->drag_initial_selection, pos))
+                {
+                    gtk_bitset_remove (self->drag_work_selection, pos);
+                }
+                else
+                {
+                    gtk_bitset_add (self->drag_work_selection, pos);
+                }
+            }
+        }
+    }
+    gtk_selection_model_set_selection (GTK_SELECTION_MODEL (model), self->drag_work_selection, self->drag_mask);
+}
+
+static void
+on_drag_end (GtkGestureDrag *gesture,
+             gdouble         offset_x,
+             gdouble         offset_y,
+             gpointer        user_data)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (user_data);
+
+    g_clear_pointer (&self->drag_initial_selection, gtk_bitset_unref);
+    g_clear_pointer (&self->drag_work_selection, gtk_bitset_unref);
+    g_clear_pointer (&self->drag_mask, gtk_bitset_unref);
+
+    if (self->rubberband_widget != NULL)
+    {
+        gtk_widget_set_visible (self->rubberband_widget, FALSE);
+    }
+}
+
+static GtkListView *
+create_grouped_view_ui (NautilusGroupedGrid *self)
+{
+    g_autoptr (GtkListItemFactory) row_factory = NULL;
+    g_autoptr (GtkNoSelection) no_selection = NULL;
+    GtkWidget *widget;
+
+    self->row_model = nautilus_grid_row_model_new ();
+    no_selection = gtk_no_selection_new (G_LIST_MODEL (g_object_ref (self->row_model)));
+
+    row_factory = gtk_signal_list_item_factory_new ();
+    g_signal_connect_object (row_factory, "setup", G_CALLBACK (setup_row_item), self, 0);
+    g_signal_connect_object (row_factory, "bind", G_CALLBACK (bind_row_item), self, 0);
+    g_signal_connect_object (row_factory, "unbind", G_CALLBACK (unbind_row_item), self, 0);
+
+    widget = gtk_list_view_new (GTK_SELECTION_MODEL (g_steal_pointer (&no_selection)),
+                                g_steal_pointer (&row_factory));
+    gtk_list_view_set_single_click_activate (GTK_LIST_VIEW (widget), FALSE);
+    gtk_list_view_set_tab_behavior (GTK_LIST_VIEW (widget), GTK_LIST_TAB_ITEM);
+    gtk_widget_set_focusable (widget, FALSE);
+
+    gtk_accessible_update_property (GTK_ACCESSIBLE (widget),
+                                    GTK_ACCESSIBLE_PROPERTY_LABEL,
+                                    _("Content View"),
+                                    GTK_ACCESSIBLE_PROPERTY_ROLE_DESCRIPTION,
+                                    _("View of the current location"),
+                                    -1);
+
+    self->drag_gesture = g_object_ref (GTK_GESTURE_DRAG (gtk_gesture_drag_new ()));
+    gtk_widget_add_controller (widget, GTK_EVENT_CONTROLLER (self->drag_gesture));
+    gtk_event_controller_set_propagation_phase (GTK_EVENT_CONTROLLER (self->drag_gesture), GTK_PHASE_BUBBLE);
+    gtk_gesture_single_set_button (GTK_GESTURE_SINGLE (self->drag_gesture), GDK_BUTTON_PRIMARY);
+    g_signal_connect_object (self->drag_gesture, "drag-begin", G_CALLBACK (on_drag_begin), self, 0);
+    g_signal_connect_object (self->drag_gesture, "drag-update", G_CALLBACK (on_drag_update), self, 0);
+    g_signal_connect_object (self->drag_gesture, "drag-end", G_CALLBACK (on_drag_end), self, 0);
+
+    return GTK_LIST_VIEW (widget);
+}
+
+static void
+nautilus_grouped_grid_dispose (GObject *object)
+{
+    NautilusGroupedGrid *self = NAUTILUS_GROUPED_GRID (object);
+
+    if (self->key_controller != NULL)
+    {
+        if (self->view != NULL)
+        {
+            gtk_widget_remove_controller (GTK_WIDGET (self->view), self->key_controller);
+        }
+        g_clear_object (&self->key_controller);
+    }
+
+    if (self->drag_gesture != NULL)
+    {
+        if (self->grouped_view_ui != NULL)
+        {
+            gtk_widget_remove_controller (GTK_WIDGET (self->grouped_view_ui),
+                                          GTK_EVENT_CONTROLLER (self->drag_gesture));
+        }
+        g_clear_object (&self->drag_gesture);
+    }
+
+    if (self->rubberband_widget != NULL)
+    {
+        GtkWidget *rubberband = self->rubberband_widget;
+        g_clear_weak_pointer (&self->rubberband_widget);
+        GtkWidget *parent = gtk_widget_get_parent (rubberband);
+        if (GTK_IS_OVERLAY (parent))
+        {
+            gtk_overlay_remove_overlay (GTK_OVERLAY (parent), rubberband);
+        }
+    }
+
+    if (self->connected_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (self->connected_model, self);
+        g_clear_object (&self->connected_model);
+    }
+
+    g_clear_pointer (&self->drag_initial_selection, gtk_bitset_unref);
+    g_clear_pointer (&self->drag_work_selection, gtk_bitset_unref);
+    g_clear_pointer (&self->drag_mask, gtk_bitset_unref);
+
+    if (self->grouped_view_ui != NULL)
+    {
+        GtkWidget *parent = gtk_widget_get_parent (GTK_WIDGET (self->grouped_view_ui));
+
+        gtk_list_view_set_model (self->grouped_view_ui, NULL);
+        if (GTK_IS_SCROLLED_WINDOW (parent))
+        {
+            gtk_scrolled_window_set_child (GTK_SCROLLED_WINDOW (parent), NULL);
+        }
+    }
+
+    if (self->bound_slots != NULL)
+    {
+        g_hash_table_destroy (self->bound_slots);
+        self->bound_slots = NULL;
+    }
+
+    g_clear_object (&self->row_model);
+    g_clear_object (&self->grouped_view_ui);
+
+    if (self->view != NULL)
+    {
+        g_object_remove_weak_pointer (G_OBJECT (self->view), (gpointer *) &self->view);
+        self->view = NULL;
+    }
+
+    G_OBJECT_CLASS (nautilus_grouped_grid_parent_class)->dispose (object);
+}
+
+static void
+nautilus_grouped_grid_class_init (NautilusGroupedGridClass *klass)
+{
+    GObjectClass *object_class = G_OBJECT_CLASS (klass);
+
+    object_class->dispose = nautilus_grouped_grid_dispose;
+}
+
+static void
+nautilus_grouped_grid_init (NautilusGroupedGrid *self)
+{
+    self->bound_slots = g_hash_table_new (g_direct_hash, g_direct_equal);
+    self->anchor_position = GTK_INVALID_LIST_POSITION;
+    self->cursor_position = GTK_INVALID_LIST_POSITION;
+    self->n_columns = 4;
+}
+
+NautilusGroupedGrid *
+nautilus_grouped_grid_new (NautilusListBase *view)
+{
+    g_return_val_if_fail (NAUTILUS_IS_LIST_BASE (view), NULL);
+
+    NautilusGroupedGrid *self = g_object_new (NAUTILUS_TYPE_GROUPED_GRID, NULL);
+
+    self->view = view;
+    g_object_add_weak_pointer (G_OBJECT (view), (gpointer *) &self->view);
+
+    self->grouped_view_ui = g_object_ref_sink (create_grouped_view_ui (self));
+
+    GtkWidget *rubberband = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 0);
+    gtk_widget_add_css_class (rubberband, "rubberband");
+    gtk_widget_set_can_target (rubberband, FALSE);
+    gtk_widget_set_can_focus (rubberband, FALSE);
+    gtk_widget_set_halign (rubberband, GTK_ALIGN_START);
+    gtk_widget_set_valign (rubberband, GTK_ALIGN_START);
+    gtk_widget_set_visible (rubberband, FALSE);
+    g_set_weak_pointer (&self->rubberband_widget, rubberband);
+    nautilus_list_base_add_overlay (view, rubberband);
+
+    self->key_controller = g_object_ref (gtk_event_controller_key_new ());
+    gtk_widget_add_controller (GTK_WIDGET (view), self->key_controller);
+    gtk_event_controller_set_propagation_phase (self->key_controller, GTK_PHASE_CAPTURE);
+    g_signal_connect_object (self->key_controller, "key-pressed",
+                             G_CALLBACK (on_grouped_view_key_pressed), self, 0);
+
+    return self;
+}
+
+GtkWidget *
+nautilus_grouped_grid_get_widget (NautilusGroupedGrid *self)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GROUPED_GRID (self), NULL);
+
+    return GTK_WIDGET (self->grouped_view_ui);
+}
+
+void
+nautilus_grouped_grid_set_model (NautilusGroupedGrid *self,
+                                 NautilusViewModel   *model)
+{
+    g_return_if_fail (NAUTILUS_IS_GROUPED_GRID (self));
+
+    if (self->connected_model != NULL)
+    {
+        g_signal_handlers_disconnect_by_data (self->connected_model, self);
+        g_clear_object (&self->connected_model);
+    }
+
+    if (model != NULL)
+    {
+        self->connected_model = g_object_ref (model);
+        g_signal_connect_object (model, "selection-changed",
+                                 G_CALLBACK (on_model_selection_changed), self, 0);
+        g_signal_connect_object (model, "items-changed",
+                                 G_CALLBACK (on_model_items_changed), self, 0);
+    }
+
+    self->anchor_position = GTK_INVALID_LIST_POSITION;
+    self->cursor_position = GTK_INVALID_LIST_POSITION;
+    self->defer_unselect_other = FALSE;
+
+    if (self->row_model != NULL)
+    {
+        nautilus_grid_row_model_set_base_model (self->row_model, model);
+    }
+}
+
+void
+nautilus_grouped_grid_set_n_columns (NautilusGroupedGrid *self,
+                                     guint                n_columns)
+{
+    g_return_if_fail (NAUTILUS_IS_GROUPED_GRID (self));
+
+    if (self->n_columns == n_columns || n_columns == 0)
+    {
+        return;
+    }
+
+    self->n_columns = n_columns;
+    if (self->row_model != NULL)
+    {
+        nautilus_grid_row_model_set_n_columns (self->row_model, self->n_columns);
+    }
+}
+
+void
+nautilus_grouped_grid_set_zoom_level (NautilusGroupedGrid   *self,
+                                      NautilusGridZoomLevel  zoom_level)
+{
+    g_return_if_fail (NAUTILUS_IS_GROUPED_GRID (self));
+
+    self->zoom_level = zoom_level;
+}
+
+void
+nautilus_grouped_grid_set_caption_attributes (NautilusGroupedGrid *self,
+                                              const GQuark         attrs[NAUTILUS_GRID_CELL_N_CAPTIONS])
+{
+    g_return_if_fail (NAUTILUS_IS_GROUPED_GRID (self));
+
+    if (attrs != NULL)
+    {
+        memcpy (self->caption_attributes, attrs, sizeof (self->caption_attributes));
+    }
+    else
+    {
+        memset (self->caption_attributes, 0, sizeof (self->caption_attributes));
+    }
+
+    if (self->bound_slots != NULL)
+    {
+        GHashTableIter iter;
+        gpointer key, value;
+        g_hash_table_iter_init (&iter, self->bound_slots);
+        while (g_hash_table_iter_next (&iter, &key, &value))
+        {
+            GtkWidget *slot = GTK_WIDGET (value);
+            GtkWidget *cell = gtk_widget_get_first_child (slot);
+            if (cell != NULL && NAUTILUS_IS_GRID_CELL (cell))
+            {
+                nautilus_grid_cell_set_caption_attributes (NAUTILUS_GRID_CELL (cell),
+                                                           self->caption_attributes);
+            }
+        }
+    }
+}
+
+void
+nautilus_grouped_grid_set_enable_rubberband (NautilusGroupedGrid *self,
+                                             gboolean             enabled)
+{
+    g_return_if_fail (NAUTILUS_IS_GROUPED_GRID (self));
+
+    self->rubberband_enabled = enabled;
+}
+
+gboolean
+nautilus_grouped_grid_scroll_to (NautilusGroupedGrid *self,
+                                 guint                position,
+                                 GtkListScrollFlags   flags,
+                                 GtkScrollInfo       *scroll)
+{
+    g_return_val_if_fail (NAUTILUS_IS_GROUPED_GRID (self), FALSE);
+
+    guint row = 0;
+    if (self->row_model != NULL &&
+        nautilus_grid_row_model_get_coords (self->row_model, position, &row, NULL))
+    {
+        if (flags & GTK_LIST_SCROLL_SELECT && self->view != NULL)
+        {
+            NautilusViewModel *model = nautilus_list_base_get_model (self->view);
+            if (model != NULL)
+            {
+                gtk_selection_model_select_item (GTK_SELECTION_MODEL (model), position, TRUE);
+            }
+        }
+        if (flags & GTK_LIST_SCROLL_FOCUS && self->view != NULL)
+        {
+            self->cursor_position = position;
+            self->anchor_position = position;
+            gtk_widget_grab_focus (GTK_WIDGET (self->view));
+        }
+        /* Virtual rows are layout units, not keyboard-selectable files. */
+        gtk_list_view_scroll_to (self->grouped_view_ui, row, GTK_LIST_SCROLL_NONE, scroll);
+        return TRUE;
+    }
+
+    return FALSE;
+}
+
+void
+nautilus_grouped_grid_preview_selection_event (NautilusGroupedGrid *self,
+                                               GtkDirectionType     direction)
+{
+    g_return_if_fail (NAUTILUS_IS_GROUPED_GRID (self));
+
+    guint keyval;
+    switch (direction)
+    {
+        case GTK_DIR_UP:
+        {
+            keyval = GDK_KEY_Up;
+        }
+        break;
+
+        case GTK_DIR_DOWN:
+        {
+            keyval = GDK_KEY_Down;
+        }
+        break;
+
+        case GTK_DIR_LEFT:
+        {
+            keyval = GDK_KEY_Left;
+        }
+        break;
+
+        case GTK_DIR_RIGHT:
+        {
+            keyval = GDK_KEY_Right;
+        }
+        break;
+
+        default:
+        {
+            return;
+        }
+    }
+
+    grouped_grid_handle_key (self, keyval, 0);
+}
