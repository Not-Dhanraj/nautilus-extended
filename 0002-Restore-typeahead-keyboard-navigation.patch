diff --git a/test/display/test-window-slot.c b/test/display/test-window-slot.c
new file mode 100644
index 000000000..430af6fdd
--- /dev/null
+++ b/test/display/test-window-slot.c
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include <nautilus-application.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-query.h>
+#include <nautilus-query-editor.h>
+#include <nautilus-resources.h>
+#include <nautilus-tag-manager.h>
+#include <nautilus-window-slot.h>
+#include <test-utilities.h>
+
+#include <glib/gstdio.h>
+
+static void
+query_before_first_view (void)
+{
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusQuery) query = nautilus_query_new ();
+    NautilusQueryEditor *editor = nautilus_window_slot_get_query_editor (slot);
+
+    g_assert_null (nautilus_window_slot_get_current_view (slot));
+    nautilus_query_set_text (query, "t");
+    nautilus_query_editor_set_query (editor, query);
+    g_signal_emit_by_name (editor, "changed", query, TRUE);
+
+    nautilus_query_set_text (query, "tt");
+    nautilus_query_editor_set_query (editor, query);
+    g_signal_emit_by_name (editor, "changed", query, TRUE);
+
+    g_autofree char *text = nautilus_query_get_text (query);
+    g_assert_cmpstr (text, ==, "tt");
+    g_assert_null (nautilus_window_slot_get_current_view (slot));
+    g_assert_null (nautilus_window_slot_get_location (slot));
+}
+
+static void
+retained_editor_after_disposal (void)
+{
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_BROWSE);
+    g_autoptr (NautilusQueryEditor) editor = g_object_ref (nautilus_window_slot_get_query_editor (slot));
+    gulong handler = g_signal_handler_find (editor, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, slot);
+
+    g_assert_cmpuint (handler, !=, 0);
+    g_object_run_dispose (G_OBJECT (slot));
+    g_assert_false (g_signal_handler_is_connected (editor, handler));
+    g_assert_cmpuint (g_signal_handler_find (editor, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, slot), ==, 0);
+
+    /* A surviving editor must remain detached through repeated disposal. */
+    g_object_run_dispose (G_OBJECT (slot));
+    g_assert_cmpuint (g_signal_handler_find (editor, G_SIGNAL_MATCH_DATA,
+                                           0, 0, NULL, NULL, slot), ==, 0);
+}
+
+int
+main (int argc, char *argv[])
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *config_dir = g_dir_make_tmp ("nautilus-slot-lifecycle-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_setenv ("XDG_CONFIG_HOME", config_dir, TRUE);
+    g_setenv ("XDG_DATA_HOME", config_dir, TRUE);
+    g_setenv ("XDG_CACHE_HOME", config_dir, TRUE);
+    g_test_init (&argc, &argv, NULL);
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+    test_init_config_dir ();
+
+    g_autoptr (NautilusTagManager) tag_manager = nautilus_tag_manager_new_dummy ();
+    g_autoptr (NautilusApplication) app = nautilus_application_new ();
+    g_application_set_application_id (G_APPLICATION (app), "org.gnome.Nautilus.TestSlotLifecycle");
+    g_application_hold (G_APPLICATION (app));
+    g_assert_true (g_application_register (G_APPLICATION (app), NULL, &error));
+    g_assert_no_error (error);
+
+    g_test_add_func ("/slot/query-before-first-view", query_before_first_view);
+    g_test_add_func ("/slot/retained-editor-after-disposal", retained_editor_after_disposal);
+    int result = g_test_run ();
+
+    g_application_release (G_APPLICATION (app));
+    g_application_quit (G_APPLICATION (app));
+    g_clear_object (&app);
+    g_clear_object (&tag_manager);
+    g_autoptr (GFile) config = g_file_new_for_path (config_dir);
+    empty_directory_by_prefix (config, "");
+    g_rmdir (config_dir);
+    return result;
+}
