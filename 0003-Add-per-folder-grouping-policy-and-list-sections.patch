+static GtkTreeListRow *
+get_root_tree_list_row (GtkTreeListRow *row)
+{
+    GtkTreeListRow *curr = g_object_ref (row);
+
+    while (TRUE)
+    {
+        GtkTreeListRow *parent = gtk_tree_list_row_get_parent (curr);
+
+        if (parent == NULL)
+        {
+            return curr;
+        }
+
+        g_object_unref (curr);
+        curr = parent;
+    }
+}
