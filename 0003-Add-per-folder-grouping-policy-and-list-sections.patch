+++ b/src/nautilus-file-grouping.h
@@ -0,0 +1,34 @@
+/*
+ * Copyright (C) 2022 The GNOME project contributors
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#pragma once
+
+#include "nautilus-enums.h"
+#include "nautilus-file.h"
+
+G_BEGIN_DECLS
+
+typedef struct _NautilusFileGrouping NautilusFileGrouping;
+
+NautilusFileGrouping *nautilus_file_grouping_new                    (void);
+void                  nautilus_file_grouping_free                   (NautilusFileGrouping *self);
+NautilusGroupingMode  nautilus_file_grouping_get_mode               (NautilusFileGrouping *self);
+void                  nautilus_file_grouping_set_mode               (NautilusFileGrouping *self,
+                                                                     NautilusGroupingMode  mode);
+void                  nautilus_file_grouping_set_sort_state         (NautilusFileGrouping *self,
+                                                                     GVariant             *sort_state);
+/* Recompute local calendar boundaries and return seconds until next midnight. */
+guint                 nautilus_file_grouping_update_time_boundaries (NautilusFileGrouping *self);
+int                   nautilus_file_grouping_compare_files          (NautilusFileGrouping *self,
+                                                                     NautilusFile         *a,
+                                                                     NautilusFile         *b);
+/* The returned title is borrowed and remains valid until the policy is freed. */
+const char           *nautilus_file_grouping_get_file_title         (NautilusFileGrouping *self,
+                                                                     NautilusFile         *file);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (NautilusFileGrouping, nautilus_file_grouping_free)
+
+G_END_DECLS
diff --git a/src/nautilus-files-view.c b/src/nautilus-files-view.c
index 547a96fb8..306e1b03e 100644
--- a/src/nautilus-files-view.c
+++ b/src/nautilus-files-view.c
@@ -605,6 +605,83 @@ update_sort_order_from_metadata_and_preferences (NautilusFilesView *self)
     g_signal_handlers_unblock_by_func (self->view_action_group, on_sort_action_state_changed, self);
 }
 
+static gboolean
+supports_grouping (NautilusFilesView *self)
+{
+    NautilusFile *file = self->directory_as_file;
+
+    return file != NULL &&
+           NAUTILUS_IS_LIST_VIEW (self->list_base) &&
+           !nautilus_file_is_in_search (file) &&
+           !nautilus_file_is_in_recent (file) &&
+           !nautilus_file_is_in_trash (file) &&
+           !nautilus_file_is_in_starred (file);
+}
+
+static const char *const grouping_mode_names[] = { "none", "time", "name" };
+
+static gboolean
+grouping_mode_from_name (const char           *name,
+                         NautilusGroupingMode *mode)
+{
+    for (guint i = 0; i < G_N_ELEMENTS (grouping_mode_names); i++)
+    {
+        if (g_strcmp0 (name, grouping_mode_names[i]) == 0)
+        {
+            *mode = (NautilusGroupingMode) i;
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
+static void
+update_grouping_from_metadata (NautilusFilesView *self)
+{
+    GSimpleAction *action = G_SIMPLE_ACTION (g_action_map_lookup_action (G_ACTION_MAP (self->view_action_group),
+                                                                       "grouping"));
+    gboolean supported = supports_grouping (self);
+    NautilusGroupingMode mode = NAUTILUS_GROUPING_NONE;
+
+    if (supported)
+    {
+        const char *stored = nautilus_file_get_metadata (self->directory_as_file,
+                                                        NAUTILUS_METADATA_KEY_GROUPING, NULL);
+        const char *legacy = nautilus_file_get_metadata (self->directory_as_file,
+                                                        NAUTILUS_METADATA_KEY_LEGACY_GROUP_BY_TIME, NULL);
+
+        if (nautilus_file_is_user_special_directory (self->directory_as_file, G_USER_DIRECTORY_DOWNLOAD))
+        {
+            mode = NAUTILUS_GROUPING_TIME;
+        }
+
+        if (stored != NULL)
+        {
+            if (grouping_mode_from_name (stored, &mode) && legacy != NULL)
+            {
+                /* The new preference has reached storage; retire its old key. */
+                nautilus_file_set_metadata (self->directory_as_file,
+                                            NAUTILUS_METADATA_KEY_LEGACY_GROUP_BY_TIME, NULL, NULL);
+            }
+        }
+        else if (legacy != NULL)
+        {
+            /* Preserve explicit on/off settings from the time-only patch,
+             * including a Downloads opt-out. Cleanup follows once saved. */
+            mode = nautilus_file_get_boolean_metadata (self->directory_as_file,
+                                                       NAUTILUS_METADATA_KEY_LEGACY_GROUP_BY_TIME, FALSE)
+                   ? NAUTILUS_GROUPING_TIME : NAUTILUS_GROUPING_NONE;
+            nautilus_file_set_metadata (self->directory_as_file, NAUTILUS_METADATA_KEY_GROUPING,
+                                        NULL, grouping_mode_names[mode]);
+        }
+    }
+
+    g_simple_action_set_enabled (action, supported);
+    g_simple_action_set_state (action, g_variant_new_string (grouping_mode_names[mode]));
+    nautilus_list_base_set_grouping_mode (self->list_base, mode);
+}
+
 static gboolean
 focus_is_on_popup (GtkRoot *window)
 {
@@ -634,6 +711,7 @@ files_view_begin_loading (NautilusFilesView *self)
     nautilus_files_view_update_toolbar_menus (self);
 
     nautilus_list_base_setup_directory (self->list_base, self->directory);
