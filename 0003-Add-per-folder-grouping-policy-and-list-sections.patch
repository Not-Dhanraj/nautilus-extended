+static void update_time_boundaries (NautilusListBase *self);
+
+static gboolean
+on_midnight_timeout (gpointer user_data)
+{
+    NautilusListBase *self = NAUTILUS_LIST_BASE (user_data);
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+
+    priv->midnight_timeout_id = 0;
+    update_time_boundaries (self);
+
+    if (priv->section_sorter != NULL)
+    {
+        gtk_sorter_changed (GTK_SORTER (priv->section_sorter), GTK_SORTER_CHANGE_DIFFERENT);
+    }
+    g_signal_emit (self, signals[GROUP_TITLES_CHANGED], 0);
+
+    return G_SOURCE_REMOVE;
+}
+
+static void
+update_time_boundaries (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    guint sec;
+
+    g_clear_handle_id (&priv->midnight_timeout_id, g_source_remove);
+    sec = nautilus_file_grouping_update_time_boundaries (priv->grouping);
+    if (nautilus_file_grouping_get_mode (priv->grouping) == NAUTILUS_GROUPING_TIME)
+    {
+        priv->midnight_timeout_id = g_timeout_add_seconds (sec, on_midnight_timeout, self);
+    }
+}
+
+static int
+compare_sections (gconstpointer a,
+                  gconstpointer b,
+                  gpointer      user_data)
+{
+    NautilusListBase *self = NAUTILUS_LIST_BASE (user_data);
+    GtkTreeListRow *row_a = GTK_TREE_LIST_ROW ((gpointer) a);
+    GtkTreeListRow *row_b = GTK_TREE_LIST_ROW ((gpointer) b);
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    g_autoptr (GtkTreeListRow) root_a = NULL;
+    g_autoptr (GtkTreeListRow) root_b = NULL;
+    g_autoptr (NautilusViewItem) item_a = NULL;
+    g_autoptr (NautilusViewItem) item_b = NULL;
+    NautilusFile *file_a = NULL;
+    NautilusFile *file_b = NULL;
+
+    if (row_a == row_b)
+    {
+        return 0;
+    }
+
+    if (nautilus_file_grouping_get_mode (priv->grouping) == NAUTILUS_GROUPING_NONE)
+    {
+        return 0;
+    }
+
+    if (row_a != NULL)
+    {
+        root_a = get_root_tree_list_row (row_a);
+        item_a = gtk_tree_list_row_get_item (root_a);
+        if (item_a != NULL)
+        {
+            file_a = nautilus_view_item_get_file (item_a);
+        }
+    }
+
+    if (row_b != NULL)
+    {
+        root_b = get_root_tree_list_row (row_b);
+        item_b = gtk_tree_list_row_get_item (root_b);
+        if (item_b != NULL)
+        {
+            file_b = nautilus_view_item_get_file (item_b);
+        }
+    }
+
+    return nautilus_file_grouping_compare_files (priv->grouping, file_a, file_b);
+}
+
+static void
+update_time_sort_state (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+    g_autoptr (GVariant) state = nautilus_list_base_get_sort_state (self);
+
+    nautilus_file_grouping_set_sort_state (priv->grouping, state);
+}
+
+static void
+on_sort_state_changed (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+
+    if (nautilus_file_grouping_get_mode (priv->grouping) != NAUTILUS_GROUPING_TIME)
+    {
+        return;
+    }
+
+    update_time_sort_state (self);
+    if (priv->section_sorter != NULL)
+    {
+        gtk_sorter_changed (GTK_SORTER (priv->section_sorter), GTK_SORTER_CHANGE_DIFFERENT);
+    }
+    g_signal_emit (self, signals[GROUP_TITLES_CHANGED], 0);
+}
