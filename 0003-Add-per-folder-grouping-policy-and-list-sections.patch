+
+GtkListItemFactory *
+nautilus_list_base_create_group_header_factory (NautilusListBase *self)
+{
+    g_autoptr (GtkListItemFactory) factory = gtk_signal_list_item_factory_new ();
+
+    g_signal_connect (factory, "setup", G_CALLBACK (on_group_header_setup), self);
+    g_signal_connect_object (factory, "bind", G_CALLBACK (on_group_header_bind), self, 0);
+    g_signal_connect (factory, "unbind", G_CALLBACK (on_group_header_unbind), NULL);
+
+    return g_steal_pointer (&factory);
+}
+
+NautilusGroupingMode
+nautilus_list_base_get_grouping_mode (NautilusListBase *self)
+{
+    NautilusListBasePrivate *priv;
+
+    g_return_val_if_fail (NAUTILUS_IS_LIST_BASE (self), NAUTILUS_GROUPING_NONE);
+
+    priv = nautilus_list_base_get_instance_private (self);
+    return nautilus_file_grouping_get_mode (priv->grouping);
+}
+
+void
+nautilus_list_base_set_grouping_mode (NautilusListBase     *self,
+                                     NautilusGroupingMode  grouping_mode)
+{
+    NautilusListBasePrivate *priv;
+
+    g_return_if_fail (NAUTILUS_IS_LIST_BASE (self));
+
+    priv = nautilus_list_base_get_instance_private (self);
+
+    if (nautilus_file_grouping_get_mode (priv->grouping) == grouping_mode)
+    {
+        return;
+    }
+
+    nautilus_file_grouping_set_mode (priv->grouping, grouping_mode);
+
+    if (grouping_mode != NAUTILUS_GROUPING_NONE)
+    {
+        if (grouping_mode == NAUTILUS_GROUPING_TIME)
+        {
+            update_time_sort_state (self);
+            update_time_boundaries (self);
+        }
+        else
+        {
+            g_clear_handle_id (&priv->midnight_timeout_id, g_source_remove);
+        }
+
+        if (priv->section_sorter == NULL)
+        {
+            priv->section_sorter = gtk_custom_sorter_new (compare_sections, self, NULL);
+        }
+        else
+        {
+            gtk_sorter_changed (GTK_SORTER (priv->section_sorter), GTK_SORTER_CHANGE_DIFFERENT);
+        }
+
+        if (priv->model != NULL)
+        {
+            nautilus_view_model_set_section_sorter (priv->model, GTK_SORTER (priv->section_sorter));
+        }
+        g_signal_emit (self, signals[GROUP_TITLES_CHANGED], 0);
+    }
+    else
+    {
+        g_clear_handle_id (&priv->midnight_timeout_id, g_source_remove);
+        if (priv->model != NULL)
+        {
+            nautilus_view_model_set_section_sorter (priv->model, NULL);
+        }
+        g_clear_object (&priv->section_sorter);
+    }
+
+    g_object_notify_by_pspec (G_OBJECT (self), properties[PROP_GROUPING_MODE]);
+}
+
+static void
+set_model (NautilusListBase  *self,
+           NautilusViewModel *new_model)
+{
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (self);
+
+    if (priv->model == new_model)
+    {
+        return;
+    }
+
+    if (priv->model != NULL && priv->section_sorter != NULL)
+    {
+        nautilus_view_model_set_section_sorter (priv->model, NULL);
+    }
+
+    g_set_object (&priv->model, new_model);
+
+    if (priv->model != NULL && nautilus_file_grouping_get_mode (priv->grouping) != NAUTILUS_GROUPING_NONE)
+    {
+        if (nautilus_file_grouping_get_mode (priv->grouping) == NAUTILUS_GROUPING_TIME)
+        {
+            update_time_boundaries (self);
+        }
+        if (priv->section_sorter == NULL)
+        {
+            priv->section_sorter = gtk_custom_sorter_new (compare_sections, self, NULL);
+        }
+        nautilus_view_model_set_section_sorter (priv->model, GTK_SORTER (priv->section_sorter));
+    }
+}
