+const char *
+nautilus_list_base_get_group_title (NautilusListBase *self,
+                                    GtkTreeListRow   *row)
+{
+    NautilusListBasePrivate *priv;
+    g_autoptr (GtkTreeListRow) root = NULL;
+    g_autoptr (NautilusViewItem) item = NULL;
+    NautilusFile *file = NULL;
+
+    g_return_val_if_fail (NAUTILUS_IS_LIST_BASE (self), NULL);
+
+    if (row == NULL)
+    {
+        return NULL;
+    }
+
+    priv = nautilus_list_base_get_instance_private (self);
+
+    root = get_root_tree_list_row (row);
+    item = gtk_tree_list_row_get_item (root);
+    if (item != NULL)
+    {
+        file = nautilus_view_item_get_file (item);
+    }
+
+    return nautilus_file_grouping_get_file_title (priv->grouping, file);
+}
