+static void
+set_group_header_first (GtkWidget *header,
+                        gboolean   is_first_section)
+{
+    if (is_first_section)
+    {
+        gtk_widget_add_css_class (header, "first-section");
+    }
+    else
+    {
+        gtk_widget_remove_css_class (header, "first-section");
+    }
+}
+
+void
+nautilus_list_base_bind_group_header_widget (GtkWidget        *header,
+                                            NautilusListBase *self,
+                                            GtkTreeListRow   *row,
+                                            gboolean          is_first_section)
+{
+    GroupHeaderBinding *binding = g_object_get_data (G_OBJECT (header), "group-binding");
+    g_autoptr (GtkTreeListRow) root = NULL;
+    g_autoptr (NautilusViewItem) item = NULL;
+
+    if (row == NULL)
+    {
+        nautilus_list_base_unbind_group_header_widget (header);
+        return;
+    }
+
+    root = get_root_tree_list_row (row);
+    if (gtk_tree_list_row_get_position (root) == GTK_INVALID_LIST_POSITION)
+    {
+        nautilus_list_base_unbind_group_header_widget (header);
+        return;
+    }
+    item = gtk_tree_list_row_get_item (root);
+    g_set_object (&binding->row, root);
+    g_signal_group_set_target (binding->view_updates, self);
+    g_signal_group_set_target (binding->file_updates, item);
+
+    set_group_header_first (header, is_first_section);
+    refresh_group_header (header);
+}
+
+void
+nautilus_list_base_unbind_group_header_widget (GtkWidget *header)
+{
+    GroupHeaderBinding *binding = g_object_get_data (G_OBJECT (header), "group-binding");
+
+    g_signal_group_set_target (binding->file_updates, NULL);
+    g_signal_group_set_target (binding->view_updates, NULL);
+    g_clear_object (&binding->row);
+    gtk_label_set_text (GTK_LABEL (header), "");
+}
