+static void
+test_time_grouping_folders (gconstpointer data)
+{
+    gboolean saved_directories_first = g_settings_get_boolean (gtk_filechooser_preferences,
+                                                              NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST);
+    guint view_id = GPOINTER_TO_UINT (data);
+    g_autoptr (NautilusWindowSlot) slot = NULL;
+    g_autoptr (NautilusFilesView) view = create_view_with_slot (NAUTILUS_MODE_BROWSE, view_id, &slot);
+    NautilusViewModel *model = nautilus_files_view_get_private_model (view);
+    GActionGroup *actions = nautilus_files_view_get_private_action_group (view);
+    g_autoptr (GFile) location = g_file_new_for_path (test_get_tmp_dir ());
+    g_autoptr (GDateTime) now = g_date_time_new_now_local ();
+    g_autoptr (GDateTime) old = g_date_time_add_days (now, -60);
+    g_autoptr (GError) error = NULL;
+    const char *names[] = { "z-folder-today", "a-file-today.txt", "z-folder-old", "a-file-old.txt" };
+
+    for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+        g_autoptr (GFile) child = g_file_get_child (location, names[i]);
+
+        if (i % 2 == 0)
+        {
+            g_file_make_directory (child, NULL, &error);
+        }
+        else
+        {
+            g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                     NULL, NULL, &error);
+        }
+        g_assert_no_error (error);
+        g_file_set_attribute_uint64 (child, G_FILE_ATTRIBUTE_TIME_MODIFIED,
+                                     g_date_time_to_unix (i < 2 ? now : old),
+                                     G_FILE_QUERY_INFO_NONE, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    nautilus_files_view_set_location (view, location);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, TRUE);
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", FALSE));
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("time"));
+    assert_grouped_file_order (model, names, G_N_ELEMENTS (names));
+
+    /* Only the two populated time sections exist; there is no global folder
+     * section and no empty intervening date section. */
+    guint start, end;
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 2);
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 2, &start, &end);
+    g_assert_cmpuint (start, ==, 2);
+    g_assert_cmpuint (end, ==, 4);
+
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, FALSE);
+    const char *name_order[] = { names[1], names[0], names[3], names[2] };
+    assert_grouped_file_order (model, name_order, G_N_ELEMENTS (name_order));
+
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, TRUE);
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "date_modified", FALSE));
+    const char *oldest_first[] = { names[2], names[3], names[0], names[1] };
+    assert_grouped_file_order (model, oldest_first, G_N_ELEMENTS (oldest_first));
+
+    g_settings_set_boolean (gtk_filechooser_preferences, NAUTILUS_PREFERENCES_SORT_DIRECTORIES_FIRST, saved_directories_first);
+    test_clear_tmp_dir ();
+}
+static void
+test_name_grouping (gconstpointer data)
+{
+    guint view_id = GPOINTER_TO_UINT (data);
+    g_autoptr (NautilusWindowSlot) slot = NULL;
+    g_autoptr (NautilusFilesView) view = create_view_with_slot (NAUTILUS_MODE_BROWSE, view_id, &slot);
+    NautilusListBase *base = nautilus_files_view_get_private_list_base (view);
+    NautilusViewModel *model = nautilus_files_view_get_private_model (view);
+    GActionGroup *actions = nautilus_files_view_get_private_action_group (view);
+    g_autoptr (GFile) location = g_file_new_build_filename (test_get_tmp_dir (), "name_grouping", NULL);
+    g_autoptr (GFile) other = g_file_new_build_filename (test_get_tmp_dir (), "other", NULL);
+    g_autoptr (GFile) time_folder = g_file_new_build_filename (test_get_tmp_dir (), "time_folder", NULL);
+    g_autoptr (GFile) legacy_folder = g_file_new_build_filename (test_get_tmp_dir (), "legacy_folder", NULL);
+    g_autoptr (GError) error = NULL;
+    guint start, end;
+    const char *names[] = {
+        "1-first.txt",
+        "2-second.txt",
+        "A-alpha.txt",
+        "a-beta.txt",
+        "É-alpha.txt",
+        "é-zeta.txt",
+        "Ωmega.txt",
+        "Брат.txt"
+    };
+
+    g_file_make_directory (location, NULL, &error);
+    g_assert_no_error (error);
+    g_file_make_directory (other, NULL, &error);
+    g_assert_no_error (error);
+    g_file_make_directory (time_folder, NULL, &error);
+    g_assert_no_error (error);
+    g_file_make_directory (legacy_folder, NULL, &error);
+    g_assert_no_error (error);
+
+    for (guint i = 0; i < G_N_ELEMENTS (names); i++)
+    {
+        g_autoptr (GFile) child = g_file_get_child (location, names[i]);
+
+        g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    {
+        g_autoptr (GFile) child = g_file_get_child (other, "other.txt");
+        g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+    }
+    {
+        g_autoptr (GFile) child = g_file_get_child (time_folder, "time.txt");
+        g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+    }
+    {
+        g_autoptr (GFile) child = g_file_get_child (legacy_folder, "legacy.txt");
+        g_file_replace_contents (child, "test", 4, NULL, FALSE, G_FILE_CREATE_NONE,
+                                 NULL, NULL, &error);
+        g_assert_no_error (error);
+    }
+
+    /* Test-mode metadata lives on the cached file, rather than in GVfs. Keep
+     * references alive across navigation so metadata persistence is exercised. */
+    g_autoptr (NautilusFile) location_file = nautilus_file_get (location);
+    g_autoptr (NautilusFile) other_file = nautilus_file_get (other);
+    g_autoptr (NautilusFile) time_file = nautilus_file_get (time_folder);
+    g_autoptr (NautilusFile) legacy_file = nautilus_file_get (legacy_folder);
+
+    nautilus_files_view_set_location (view, location);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+
+    /* Setting grouping to "name" sets sort to (name, FALSE) and enables name grouping. */
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("name"));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NAME);
+
+    /* Ascending within-section name order with normal sort */
+    assert_grouped_file_order (model, names, G_N_ELEMENTS (names));
+
+    /* Populated sections in ascending order: #, A, E, Ω, Б */
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 2);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 2, &start, &end);
+    g_assert_cmpuint (start, ==, 2);
+    g_assert_cmpuint (end, ==, 4);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 4, &start, &end);
+    g_assert_cmpuint (start, ==, 4);
+    g_assert_cmpuint (end, ==, 6);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 6, &start, &end);
+    g_assert_cmpuint (start, ==, 6);
+    g_assert_cmpuint (end, ==, 7);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 7, &start, &end);
+    g_assert_cmpuint (start, ==, 7);
+    g_assert_cmpuint (end, ==, 8);
+
+    /* Alphabetical heading characters are semantic group keys:
+     * - digits/punctuation map to "#"
+     * - uppercase and lowercase Latin map to "A"
+     * - accented Latin decomposes to base letter "E"
+     * - non-Latin alphabetic scripts preserve uppercase initial ("Ω", "Б") */
+    {
+        const char *expected_titles[] = {
+            "#", "#",
+            "A", "A",
+            "E", "E",
+            "Ω",
+            "Б"
+        };
+        for (guint i = 0; i < G_N_ELEMENTS (expected_titles); i++)
+        {
+            g_autoptr (GtkTreeListRow) row = g_list_model_get_item (G_LIST_MODEL (model), i);
+            g_assert_nonnull (row);
+            g_assert_cmpstr (nautilus_list_base_get_group_title (base, row), ==, expected_titles[i]);
+        }
+    }
+
+    /* Reverse ordinary sort reverses files WITHIN each section, but does NOT reverse section order */
+    g_action_group_change_action_state (actions, "sort", g_variant_new ("(sb)", "name", TRUE));
+    {
+        const char *expected_reversed[] = {
+            "2-second.txt",
+            "1-first.txt",
+            "a-beta.txt",
+            "A-alpha.txt",
+            "é-zeta.txt",
+            "É-alpha.txt",
+            "Ωmega.txt",
+            "Брат.txt"
+        };
+        assert_grouped_file_order (model, expected_reversed, G_N_ELEMENTS (expected_reversed));
+    }
+
+    /* Section bounds and titles remain unchanged under reverse sort */
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 2);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 2, &start, &end);
+    g_assert_cmpuint (start, ==, 2);
+    g_assert_cmpuint (end, ==, 4);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 4, &start, &end);
+    g_assert_cmpuint (start, ==, 4);
+    g_assert_cmpuint (end, ==, 6);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 6, &start, &end);
+    g_assert_cmpuint (start, ==, 6);
+    g_assert_cmpuint (end, ==, 7);
+
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 7, &start, &end);
+    g_assert_cmpuint (start, ==, 7);
+    g_assert_cmpuint (end, ==, 8);
+
+    /* Pooled headings may be unparented while their first file changes. They
+     * must update directly from their owner and row, without a range change. */
+    g_autoptr (GtkTreeListRow) heading_row = g_list_model_get_item (G_LIST_MODEL (model), 6);
+    g_autoptr (GtkWidget) heading = g_object_ref_sink (nautilus_list_base_create_group_header_widget ());
+    nautilus_list_base_bind_group_header_widget (heading, base, heading_row, FALSE);
+    g_assert_null (gtk_widget_get_parent (heading));
+    g_assert_cmpstr (gtk_label_get_text (GTK_LABEL (heading)), ==, "Ω");
+    gboolean rename_done = FALSE;
+    gulong changes_handler = g_signal_connect_after (view, "end-file-changes",
+                                                     G_CALLBACK (file_changes_done), &rename_done);
+    g_autoptr (GFile) original = g_file_get_child (location, "Ωmega.txt");
+    g_autoptr (GFile) renamed = g_file_set_display_name (original, "Ψmega.txt", NULL, &error);
+    g_assert_no_error (error);
+    ITER_CONTEXT_WHILE (!rename_done);
+    g_signal_handler_disconnect (view, changes_handler);
+    g_autoptr (GtkTreeListRow) renamed_row = g_list_model_get_item (G_LIST_MODEL (model), 6);
+    g_assert_cmpstr (nautilus_list_base_get_group_title (base, renamed_row), ==, "Ψ");
+    g_assert_cmpstr (gtk_label_get_text (GTK_LABEL (heading)), ==, "Ψ");
+    nautilus_list_base_unbind_group_header_widget (heading);
+    g_clear_object (&heading);
+
+    /* Mode switching: name -> time -> none -> name */
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("time"));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_TIME);
+
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("none"));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 8);
+
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("name"));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NAME);
+    gtk_section_model_get_section (GTK_SECTION_MODEL (model), 0, &start, &end);
+    g_assert_cmpuint (start, ==, 0);
+    g_assert_cmpuint (end, ==, 2);
+
+    /* Per-folder preference restoration and migration */
+    nautilus_files_view_set_location (view, other);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+
+    nautilus_files_view_set_location (view, time_folder);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_action_group_change_action_state (actions, "grouping", g_variant_new_string ("time"));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_TIME);
+
+    /* Seed test-mode metadata only after initial info has loaded; otherwise
+     * the first filesystem query legitimately replaces the in-memory fixture. */
+    nautilus_files_view_set_location (view, legacy_folder);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+    nautilus_file_set_boolean_metadata (legacy_file, NAUTILUS_METADATA_KEY_LEGACY_GROUP_BY_TIME, TRUE);
+    nautilus_files_view_set_location (view, other);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    nautilus_files_view_set_location (view, legacy_folder);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_TIME);
+    const char *migrated = nautilus_file_get_metadata (legacy_file, NAUTILUS_METADATA_KEY_GROUPING, NULL);
+    g_assert_cmpstr (migrated, ==, "time");
+
+    /* Return to location: restored to name grouping */
+    nautilus_files_view_set_location (view, location);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NAME);
+
+    /* Return to time_folder: restored to time grouping */
+    nautilus_files_view_set_location (view, time_folder);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_TIME);
+
+    /* Return to other: remains none */
+    nautilus_files_view_set_location (view, other);
+    ITER_CONTEXT_WHILE (nautilus_files_view_get_loading (view));
+    g_assert_cmpint (nautilus_list_base_get_grouping_mode (base), ==, NAUTILUS_GROUPING_NONE);
+
+    test_clear_tmp_dir ();
+}
