+
+static void
+assert_bookmark_icons (NautilusBookmark *bookmark,
+                       GIcon            *expected,
+                       GIcon            *expected_symbolic)
+{
+    g_autoptr (GIcon) icon = nautilus_bookmark_get_icon (bookmark);
+    g_autoptr (GIcon) symbolic = nautilus_bookmark_get_symbolic_icon (bookmark);
+
+    g_assert_true (g_icon_equal (icon, expected));
+    g_assert_true (g_icon_equal (symbolic, expected_symbolic));
+}
+
+static void
+test_bookmark_custom_icon (void)
+{
+    g_autoptr (GFile) location = g_file_new_build_filename (test_get_tmp_dir (),
+                                                            "custom-icon", NULL);
+    g_autoptr (GError) error = NULL;
+    g_autoptr (NautilusFile) file = NULL;
+    g_autoptr (GFileInfo) info = g_file_info_new ();
+    g_autoptr (NautilusBookmark) bookmark = NULL;
+    g_autoptr (GIcon) named_icon = g_themed_icon_new_with_default_fallbacks ("folder-music-symbolic");
+    g_autoptr (GFile) icon_file = g_file_get_child (location, "icon.svg");
+    g_autoptr (GIcon) image_icon = g_file_icon_new (icon_file);
+    g_autoptr (GFile) symbolic_file = g_file_get_child (location, "research-symbolic.svg");
+    g_autofree char *symbolic_uri = g_file_get_uri (symbolic_file);
+    g_autoptr (GIcon) sidebar_icon = g_file_icon_new (symbolic_file);
+    g_autoptr (GIcon) default_symbolic = g_themed_icon_new ("folder-symbolic");
+
+    g_file_make_directory (location, NULL, &error);
+    g_assert_no_error (error);
+    file = nautilus_file_get (location);
+    file_load_attributes (file, NAUTILUS_ATTRIBUTE_INFO);
+
+    /* Metadata may already be cached when a bookmark is constructed. */
+    g_file_info_set_attribute_string (info, "metadata::custom-icon-name", "folder-music-symbolic");
+    g_file_info_set_attribute_string (info, "metadata::custom-symbolic-icon", symbolic_uri);
+    nautilus_file_update_metadata_from_info (file, info);
+    bookmark = nautilus_bookmark_new (location, "Custom icon");
+    assert_bookmark_icons (bookmark, named_icon, sidebar_icon);
+
+    /* A relative image URI takes precedence over the named icon. */
+    g_file_info_set_attribute_string (info, "metadata::custom-icon", "icon.svg");
+    nautilus_file_update_metadata_from_info (file, info);
+    nautilus_file_changed (file);
+    assert_bookmark_icons (bookmark, image_icon, sidebar_icon);
+
+    /* Resetting the sidebar must not remove the full-colour folder icon. */
+    g_file_info_remove_attribute (info, "metadata::custom-symbolic-icon");
+    nautilus_file_update_metadata_from_info (file, info);
+    nautilus_file_changed (file);
+    assert_bookmark_icons (bookmark, image_icon, default_symbolic);
+
+    g_file_info_remove_attribute (info, "metadata::custom-icon");
+    nautilus_file_update_metadata_from_info (file, info);
+    nautilus_file_changed (file);
+    assert_bookmark_icons (bookmark, named_icon, default_symbolic);
+
+    g_file_info_remove_attribute (info, "metadata::custom-icon-name");
+    nautilus_file_update_metadata_from_info (file, info);
+    nautilus_file_changed (file);
+    g_autoptr (GIcon) default_icon = g_themed_icon_new ("folder");
+    assert_bookmark_icons (bookmark, default_icon, default_symbolic);
+
+    g_clear_object (&bookmark);
+    g_file_delete (location, NULL, &error);
+    g_assert_no_error (error);
 }
 
