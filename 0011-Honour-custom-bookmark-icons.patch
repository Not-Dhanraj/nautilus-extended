 static void
+bookmark_icon_selected_cb (NautilusFileChooser *dialog,
+                           GList               *locations,
+                           GtkFileFilter       *filter,
+                           gpointer             user_data)
+{
+    NautilusFile *file = g_object_get_data (G_OBJECT (dialog), "bookmark-file");
+    GFile *image = G_FILE (locations->data);
+    g_autofree char *path = g_file_get_path (image);
+    g_autoptr (GError) error = NULL;
+    g_autoptr (GdkPixbuf) preview = NULL;
+
+    if (path == NULL || !g_str_has_suffix (path, "-symbolic.svg"))
+    {
+        g_set_error_literal (&error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                             _("Choose a local symbolic SVG icon (a file ending in -symbolic.svg)."));
+    }
+    else
+    {
+        preview = gdk_pixbuf_new_from_file_at_scale (path, 32, 32, TRUE, &error);
+    }
+
+    if (preview == NULL)
+    {
+        nautilus_show_ok_dialog (_("Unable to Set Bookmark Icon"), error->message,
+                                 GTK_WIDGET (dialog));
+        return;
+    }
+
+    g_autofree char *uri = g_file_get_uri (image);
+    nautilus_file_set_metadata (file, NAUTILUS_METADATA_KEY_CUSTOM_SYMBOLIC_ICON, NULL, uri);
+    gtk_window_close (GTK_WINDOW (dialog));
+}
+
+static gboolean
+bookmark_icon_chooser_closed_cb (GtkWindow *window,
+                                 gpointer   user_data)
+{
+    int width, height;
+    gtk_window_get_default_size (window, &width, &height);
+    g_settings_set (nautilus_window_state, NAUTILUS_WINDOW_STATE_INITIAL_SIZE_FILE_CHOOSER,
+                    "(ii)", width, height);
+    return FALSE;
+}
+
+static void
+change_bookmark_icon_cb (GSimpleAction *action,
+                         GVariant      *parameter,
+                         gpointer       user_data)
+{
+    NautilusSidebar *sidebar = user_data;
+    g_autofree char *uri = NULL;
+    NautilusFileChooser *dialog = nautilus_file_chooser_new (NAUTILUS_MODE_OPEN_FILE);
+    g_autoptr (GtkFileFilter) filter = gtk_file_filter_new ();
+    g_autoptr (GListStore) filters = g_list_store_new (GTK_TYPE_FILE_FILTER);
+
+    g_object_get (sidebar->context_row, "uri", &uri, NULL);
+    NautilusFile *file = nautilus_file_get_by_uri (uri);
+    g_object_set_data_full (G_OBJECT (dialog), "bookmark-file", file, g_object_unref);
+    gtk_window_set_title (GTK_WINDOW (dialog), _("Select Bookmark Icon"));
+    nautilus_file_chooser_set_accept_label (dialog, _("_Select"));
+    gtk_file_filter_set_name (filter, _("Symbolic SVG Icons"));
+    gtk_file_filter_add_pattern (filter, "*-symbolic.svg");
+    g_list_store_append (filters, filter);
+    nautilus_file_chooser_set_filters (dialog, G_LIST_MODEL (filters));
+    nautilus_file_chooser_set_current_filter (dialog, 0);
+
+    const char *current = nautilus_file_get_metadata (file, NAUTILUS_METADATA_KEY_CUSTOM_SYMBOLIC_ICON, NULL);
+    g_autoptr (GFile) image = current != NULL ? g_file_new_for_uri (current) : NULL;
+    nautilus_file_chooser_set_starting_location (dialog, image);
+
+    GtkWindow *parent = GTK_WINDOW (gtk_widget_get_root (GTK_WIDGET (sidebar)));
+    gtk_window_set_transient_for (GTK_WINDOW (dialog), parent);
+    gtk_window_set_destroy_with_parent (GTK_WINDOW (dialog), TRUE);
+    gtk_window_set_modal (GTK_WINDOW (dialog), TRUE);
+    gtk_application_add_window (GTK_APPLICATION (g_application_get_default ()), GTK_WINDOW (dialog));
+    g_signal_connect (dialog, "accepted", G_CALLBACK (bookmark_icon_selected_cb), NULL);
+    g_signal_connect (dialog, "close-request", G_CALLBACK (bookmark_icon_chooser_closed_cb), NULL);
+    gtk_window_present (GTK_WINDOW (dialog));
+}
+
+static void
+reset_bookmark_icon_cb (GSimpleAction *action,
+                        GVariant      *parameter,
+                        gpointer       user_data)
+{
+    NautilusSidebar *sidebar = user_data;
+    g_autofree char *uri = NULL;
+    g_object_get (sidebar->context_row, "uri", &uri, NULL);
+    g_autoptr (NautilusFile) file = nautilus_file_get_by_uri (uri);
+
+    nautilus_file_set_metadata (file, NAUTILUS_METADATA_KEY_CUSTOM_SYMBOLIC_ICON, NULL, NULL);
+}
