+static void
+open_regular_file_selects_it_in_parent (void)
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *path = g_dir_make_tmp ("nautilus-slot-selection-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_autoptr (GFile) parent = g_file_new_for_path (path);
+    g_autoptr (GFile) location = g_file_get_child (parent, "selected.txt");
+    g_file_replace_contents (location, "selection", 9, NULL, FALSE,
+                             G_FILE_CREATE_NONE, NULL, NULL, &error);
+    g_assert_no_error (error);
+
+    g_autoptr (NautilusWindowSlot) slot = nautilus_window_slot_new (NAUTILUS_MODE_OPEN_FILE);
+    GtkWindow *window = GTK_WINDOW (gtk_window_new ());
+    gtk_window_set_child (window, GTK_WIDGET (slot));
+    nautilus_window_slot_set_active (slot, TRUE);
+    gtk_window_present (window);
+    nautilus_window_slot_open_location_full (slot, location, NULL);
+    ITER_CONTEXT_WHILE (nautilus_window_slot_get_current_view (slot) == NULL ||
+                        nautilus_files_view_get_loading (nautilus_window_slot_get_current_view (slot)) ||
+                        nautilus_window_slot_get_selection (slot) == NULL);
+
+    g_assert_true (g_file_equal (nautilus_window_slot_get_location (slot), parent));
+    NautilusFileList *selection = nautilus_window_slot_get_selection (slot);
+    g_assert_cmpuint (g_list_length (selection), ==, 1);
+    g_autoptr (GFile) selected = nautilus_file_get_location (selection->data);
+    g_assert_true (g_file_equal (selected, location));
+
+    nautilus_window_slot_set_active (slot, FALSE);
+    gtk_window_destroy (window);
+    g_clear_object (&slot);
+    g_file_delete (location, NULL, &error);
+    g_assert_no_error (error);
+    g_file_delete (parent, NULL, &error);
+    g_assert_no_error (error);
+}
