From bd664ce01c685c4e32ac86276eac9dcf179e602a Mon Sep 17 00:00:00 2001
From: Dhanraj <dp914278@gmail.com>
Date: Fri, 30 Oct 2026 23:34:04 +0530
Subject: [PATCH 07/10] application: Add external-open window preference

Allow externally requested locations to open in fresh windows without
changing internal tab navigation. Preserve explicit new-window precedence
and existing reuse behavior when the preference is disabled. Include the
preference UI, schema, and routing regression independently of view styling.
---
 NEWS                                          |   2 +
 data/org.gnome.nautilus.gschema.xml           |   7 +-
 src/nautilus-application.c                    |  35 +++-
 src/nautilus-global-preferences.h             |   1 +
 src/nautilus-preferences-dialog.c             |   7 +-
 .../ui/nautilus-preferences-dialog.blp        |   5 +
 test/display/meson.build                      |   3 +
 test/display/test-application.c               | 221 ++++++++++++++++++
 8 files changed, 272 insertions(+), 9 deletions(-)
 create mode 100644 test/display/test-application.c

diff --git a/NEWS b/NEWS
index cafa3f7eb..9587c101b 100644
--- a/NEWS
+++ b/NEWS
@@ -4,6 +4,8 @@ Downstream changes (nautilus-typeahead)
   return to the previous location in history, without restarting Files.
 - Use native GTK selection nodes and theme states for grouped icon highlights
   and rubberband rectangles, including neutral view accents and contrast rules.
+- Add an opt-in preference to open externally requested locations in new
+  windows, including FileManager1, GApplication, and command-line requests.
 - Add per-folder time and name grouping in both icon and list views, including
   Nautilus's own Open File/Open Folder chooser. View Options offers No Grouping,
   Group by Time, and Group by Name (A–Z). Downloads defaults to time grouping.
diff --git a/data/org.gnome.nautilus.gschema.xml b/data/org.gnome.nautilus.gschema.xml
index a78fd8bec..825026f80 100644
--- a/data/org.gnome.nautilus.gschema.xml
+++ b/data/org.gnome.nautilus.gschema.xml
@@ -92,7 +92,12 @@
       <summary>Start searching on type ahead</summary>
       <description>If set to true, typing on the files viewer will start searching. Otherwise it select first matching file.</description>
     </key>
-    <key enum="org.gnome.nautilus.BackspaceAction" name="backspace-action">
+    <key type="b" name="open-external-in-new-window">
+      <default>false</default>
+      <summary>Always open external locations in a new window</summary>
+      <description>If set to true, locations opened from outside Files or from the command line will always open in a new window instead of reusing an existing window.</description>
+    </key>
+    <key name="backspace-action" enum="org.gnome.nautilus.BackspaceAction">
       <default>'parent-folder'</default>
       <summary>Navigation action for the Backspace key</summary>
       <description>Use “parent-folder” to go up one folder or “history-back” to return to the previous location in history.</description>
diff --git a/src/nautilus-application.c b/src/nautilus-application.c
index 275c3fd67..a89080d93 100644
--- a/src/nautilus-application.c
+++ b/src/nautilus-application.c
@@ -429,7 +429,15 @@ nautilus_application_open_location (NautilusApplication *self,
         sel_list = g_list_prepend (sel_list, nautilus_file_get (selection));
     }
 
-    nautilus_application_open_location_full (self, location, NAUTILUS_OPEN_FLAG_REUSE_EXISTING,
+    NautilusOpenFlags flags = NAUTILUS_OPEN_FLAG_REUSE_EXISTING;
+
+    if (g_settings_get_boolean (nautilus_preferences,
+                                NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW))
+    {
+        flags = NAUTILUS_OPEN_FLAG_NEW_WINDOW;
+    }
+
+    nautilus_application_open_location_full (self, location, flags,
                                              sel_list, startup_id);
 }
 
@@ -448,7 +456,10 @@ nautilus_application_open (GApplication  *app,
     NautilusApplication *self = NAUTILUS_APPLICATION (app);
 
     /* Either open new window or re-open existing location to update selection */
-    NautilusOpenFlags flags = g_strcmp0 (hint, "new-window") == 0
+    gboolean open_in_new_window = g_strcmp0 (hint, "new-window") == 0 ||
+                                  g_settings_get_boolean (nautilus_preferences,
+                                                          NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW);
+    NautilusOpenFlags flags = open_in_new_window
                               ? NAUTILUS_OPEN_FLAG_NEW_WINDOW
                               : NAUTILUS_OPEN_FLAG_REUSE_EXISTING;
 
@@ -528,11 +539,18 @@ do_cmdline_sanity_checks (GVariantDict *options)
 static void
 nautilus_application_select (NautilusApplication  *self,
                              GFile               **files,
-                             gint                  len)
+                             gint                  len,
+                             gboolean              new_window)
 {
     int i;
     GFile *file;
     GFile *parent;
+    gboolean open_in_new_window = new_window ||
+                                  g_settings_get_boolean (nautilus_preferences,
+                                                          NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW);
+    NautilusOpenFlags flags = open_in_new_window
+                              ? NAUTILUS_OPEN_FLAG_NEW_WINDOW
+                              : NAUTILUS_OPEN_FLAG_REUSE_EXISTING;
 
     for (i = 0; i < len; i++)
     {
@@ -540,12 +558,13 @@ nautilus_application_select (NautilusApplication  *self,
         parent = g_file_get_parent (file);
         if (parent != NULL)
         {
-            nautilus_application_open_location (self, parent, file, NULL);
+            g_autolist (NautilusFile) sel_list = g_list_prepend (NULL, nautilus_file_get (file));
+            nautilus_application_open_location_full (self, parent, flags, sel_list, NULL);
             g_object_unref (parent);
         }
         else
         {
-            nautilus_application_open_location (self, file, NULL, NULL);
+            nautilus_application_open_location_full (self, file, flags, NULL, NULL);
         }
     }
 }
@@ -793,15 +812,17 @@ nautilus_application_handle_file_args (NautilusApplication *self,
     len = file_array->len;
     files = (GFile **) file_array->pdata;
 
+    gboolean new_window = g_variant_dict_contains (options, "new-window");
+
     if (g_variant_dict_contains (options, "select"))
     {
-        nautilus_application_select (self, files, len);
+        nautilus_application_select (self, files, len, new_window);
     }
     else
     {
         /* Create new windows */
         nautilus_application_open (G_APPLICATION (self), files, len,
-                                   g_variant_dict_contains (options, "new-window") ? "new-window" : "");
+                                   new_window ? "new-window" : "");
     }
 
     g_ptr_array_unref (file_array);
