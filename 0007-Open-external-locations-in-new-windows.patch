diff --git a/test/display/test-application.c b/test/display/test-application.c
new file mode 100644
index 000000000..2743b38af
--- /dev/null
+++ b/test/display/test-application.c
@@ -0,0 +1,221 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Test suite for NautilusApplication external window routing
+ */
+
+#define G_LOG_DOMAIN "test-application"
+
+#include <nautilus-application.h>
+#include <nautilus-file.h>
+#include <nautilus-file-utilities.h>
+#include <nautilus-global-preferences.h>
+#include <nautilus-mime-actions.h>
+#include <nautilus-resources.h>
+#include <nautilus-tag-manager.h>
+#include <nautilus-window.h>
+
+#include <test-utilities.h>
+
+#include <glib.h>
+#include <glib/gstdio.h>
+#include <gtk/gtk.h>
+
+static void
+file_ready (NautilusFile *file,
+            gpointer      user_data)
+{
+    *(gboolean *) user_data = TRUE;
+}
+
+static void
+test_open_external_in_new_window (void)
+{
+    g_autoptr (NautilusTagManager) tag_manager = nautilus_tag_manager_new_dummy ();
+
+    test_init_config_dir ();
+
+    g_autoptr (NautilusApplication) app = nautilus_application_new ();
+    g_autoptr (GFile) dir1 = g_file_new_for_path (g_get_home_dir ());
+    g_autoptr (GFile) dir2 = g_file_new_for_path (g_get_tmp_dir ());
+    g_autoptr (GFile) dir3 = g_file_new_for_path (g_get_user_cache_dir ());
+    g_autoptr (GFile) dir4 = g_file_new_for_path (g_get_user_config_dir ());
+    GFile *files1[] = { dir1 };
+    GFile *files2[] = { dir2 };
+    GList *windows = NULL;
+    g_autofree char *archive_dir = g_build_filename (g_get_user_cache_dir (), "archive-test", NULL);
+    g_autofree char *archive_path = g_build_filename (archive_dir, "archive.zip", NULL);
+    g_autofree char *payload_path = g_build_filename (archive_dir, "archive", "payload.txt", NULL);
+    g_autofree char *extracted_dir = g_build_filename (archive_dir, "archive", NULL);
+    g_autoptr (GFile) archive = g_file_new_for_path (archive_path);
+    g_autoptr (GFile) archive_parent = g_file_new_for_path (archive_dir);
+    g_autoptr (NautilusFile) cached_archive = NULL;
+    g_autoptr (GError) error = NULL;
+    gsize archive_size;
+    g_autofree guchar *archive_bytes = g_base64_decode (
+        "UEsDBBQAAAAAAFKYbF1faUheEwAAABMAAAALAAAAcGF5bG9hZC50eHRhcmNoaXZlIHJlZ3Jlc3Npb24KUEsBAhQDFAAAAAAAUphsXV9pSF4TAAAAEwAAAAsAAAAAAAAAAAAAAIABAAAAAHBheWxvYWQudHh0UEsFBgAAAAABAAEAOQAAADwAAAAAAA==",
+        &archive_size);
+    gboolean ready = FALSE;
+    gint64 deadline;
+    NautilusWindow *initial_window = NULL;
+
+    g_application_set_application_id (G_APPLICATION (app), "org.gnome.Nautilus.TestApplication");
+    g_application_hold (G_APPLICATION (app));
+    g_assert_true (g_application_register (G_APPLICATION (app), NULL, NULL));
+    g_application_open (G_APPLICATION (app), files1, 1, "");
+
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 1);
+    initial_window = NAUTILUS_WINDOW (windows->data);
+
+    /* 1. Default toggle is false: GApplication open and external open_location reuse existing window */
+    g_settings_set_boolean (nautilus_preferences,
+                            NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW,
+                            FALSE);
+
+    g_application_open (G_APPLICATION (app), files1, 1, "");
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 1);
+    g_assert_true (windows->data == initial_window);
+
+    nautilus_application_open_location (app, dir2, NULL, NULL);
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 1);
+    g_assert_true (windows->data == initial_window);
+
+    /* 2. Explicit new-window hint honored regardless of toggle */
+    g_application_open (G_APPLICATION (app), files1, 1, "new-window");
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 2);
+
+    /* 3. Toggle true: external GApplication open and helper open_location open fresh windows */
+    g_settings_set_boolean (nautilus_preferences,
+                            NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW,
+                            TRUE);
+
+    g_application_open (G_APPLICATION (app), files2, 1, "");
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 3);
+
+    nautilus_application_open_location (app, dir3, NULL, NULL);
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 4);
+
+    /* 4. Internal navigation / NEW_TAB remains unaffected by the toggle */
+    nautilus_application_open_location_full (app, dir4,
+                                             NAUTILUS_OPEN_FLAG_NEW_TAB,
+                                             NULL, NULL);
+    windows = nautilus_application_get_windows (app);
+    g_assert_cmpint (g_list_length (windows), ==, 4);
+
+    /* A cached archive must still be activated when opened in a new window. */
+    g_assert_cmpint (g_mkdir (archive_dir, 0700), ==, 0);
+    g_assert_true (g_file_set_contents (archive_path, (const char *) archive_bytes,
+                                        archive_size, &error));
+    g_assert_no_error (error);
+    cached_archive = nautilus_file_get (archive);
+    nautilus_file_call_when_ready (cached_archive, NAUTILUS_ATTRIBUTE_INFO, file_ready, &ready);
+    deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+    while (!ready && g_get_monotonic_time () < deadline)
+    {
+        g_main_context_iteration (NULL, FALSE);
+        g_usleep (1000);
+    }
+    g_assert_true (ready);
+    g_assert_true (nautilus_mime_file_extracts (cached_archive));
+
+    GFile *archive_files[] = { archive };
+    for (guint i = 0; i < 2; i++)
+    {
+        GList *old_windows = g_list_copy (nautilus_application_get_windows (app));
+        NautilusWindow *archive_window = NULL;
+        g_autofree char *payload = NULL;
+
+        if (i == 1)
+        {
+            g_assert_cmpint (g_remove (payload_path), ==, 0);
+            g_assert_cmpint (g_rmdir (extracted_dir), ==, 0);
+            g_settings_set_boolean (nautilus_preferences,
+                                    NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW,
+                                    FALSE);
+        }
+        g_application_open (G_APPLICATION (app), archive_files, 1, i == 0 ? "" : "new-window");
+        windows = nautilus_application_get_windows (app);
+        g_assert_cmpint (g_list_length (windows), ==, 5 + i);
+        for (GList *l = windows; l != NULL; l = l->next)
+        {
+            if (g_list_find (old_windows, l->data) == NULL)
+            {
+                archive_window = NAUTILUS_WINDOW (l->data);
+                break;
+            }
+        }
+        g_list_free (old_windows);
+        g_assert_nonnull (archive_window);
+        deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+        while (g_get_monotonic_time () < deadline)
+        {
+            g_clear_pointer (&payload, g_free);
+            if (g_file_get_contents (payload_path, &payload, NULL, NULL) &&
+                g_strcmp0 (payload, "archive regression\n") == 0 &&
+                nautilus_window_has_open_location (archive_window, archive_parent))
+            {
+                break;
+            }
+            g_main_context_iteration (NULL, FALSE);
+            g_usleep (1000);
+        }
+        g_assert_true (nautilus_window_has_open_location (archive_window, archive_parent));
+        g_assert_cmpstr (payload, ==, "archive regression\n");
+    }
+
+    /* Reset preference */
+    g_settings_set_boolean (nautilus_preferences,
+                            NAUTILUS_PREFERENCES_OPEN_EXTERNAL_IN_NEW_WINDOW,
+                            FALSE);
+
+    while (nautilus_application_get_windows (app) != NULL)
+    {
+        gtk_window_destroy (GTK_WINDOW (nautilus_application_get_windows (app)->data));
+    }
+    g_application_release (G_APPLICATION (app));
+    g_application_quit (G_APPLICATION (app));
+}
+
+int
+main (int   argc,
+      char *argv[])
+{
+    g_autoptr (GError) error = NULL;
+    g_autofree char *config_dir = g_dir_make_tmp ("nautilus-application-XXXXXX", &error);
+    g_assert_no_error (error);
+    g_setenv ("XDG_CONFIG_HOME", config_dir, TRUE);
+    g_setenv ("XDG_CONFIG_DIRS", config_dir, TRUE);
+    g_setenv ("XDG_CURRENT_DESKTOP", "NautilusTest", TRUE);
+    g_setenv ("XDG_DATA_HOME", config_dir, TRUE);
+    g_setenv ("XDG_CACHE_HOME", config_dir, TRUE);
+    g_autofree char *applications_dir = g_build_filename (config_dir, "applications", NULL);
+    g_autofree char *desktop_path = g_build_filename (applications_dir, NAUTILUS_DESKTOP_ID, NULL);
+    g_autofree char *mime_path = g_build_filename (config_dir, "mimeapps.list", NULL);
+    g_autofree char *mime_contents = g_strdup_printf ("[Default Applications]\napplication/zip=%s;\n", NAUTILUS_DESKTOP_ID);
+    g_assert_cmpint (g_mkdir_with_parents (applications_dir, 0700), ==, 0);
+    g_assert_true (g_file_set_contents (desktop_path,
+                                        "[Desktop Entry]\nType=Application\nName=Files\nExec=true %U\nMimeType=application/zip;\n",
+                                        -1, &error));
+    g_assert_no_error (error);
+    g_assert_true (g_file_set_contents (mime_path, mime_contents, -1, &error));
+    g_assert_no_error (error);
+    g_test_init (&argc, &argv, NULL);
+
+    nautilus_register_resource ();
+    nautilus_ensure_extension_points ();
+
+    g_test_add_func ("/application/open-external-in-new-window",
+                     test_open_external_in_new_window);
+
+    int result = g_test_run ();
+    g_autoptr (GFile) config = g_file_new_for_path (config_dir);
+    empty_directory_by_prefix (config, "");
+    g_rmdir (config_dir);
+    return result;
+}
-- 
